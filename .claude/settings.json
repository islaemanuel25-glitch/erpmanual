{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git ls-files:*)",
      "PowerShell(git grep:*)",
      "PowerShell(git rev-parse:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma migrate status:*)",
      "PowerShell(npx prisma generate:*)",
      "PowerShell(npx prisma migrate status:*)",
      "Bash(node --test:*)",
      "PowerShell(node --test:*)",
      "Bash(node scripts/hardcodeo.mjs:*)",
      "Bash(node --no-warnings scripts/hardcodeo.mjs:*)",
      "PowerShell(node scripts/hardcodeo.mjs:*)",
      "PowerShell(node --no-warnings scripts/hardcodeo.mjs:*)",
      "Bash(node scripts/clasificar-migraciones.mjs:*)",
      "Bash(node --no-warnings scripts/clasificar-migraciones.mjs:*)",
      "PowerShell(node scripts/clasificar-migraciones.mjs:*)",
      "PowerShell(node --no-warnings scripts/clasificar-migraciones.mjs:*)",
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(gh:*)",
      "PowerShell(gh:*)",
      "Bash(ssh:*)",
      "PowerShell(ssh:*)",
      "Bash(scp:*)",
      "PowerShell(scp:*)",
      "Bash(docker:*)",
      "PowerShell(docker:*)",
      "Bash(npx prisma migrate deploy:*)",
      "PowerShell(npx prisma migrate deploy:*)",
      "Bash(npx prisma db push:*)",
      "PowerShell(npx prisma db push:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(git rm:*)",
      "Bash(git clean:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(git rm:*)",
      "PowerShell(git clean:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-guardia-migraciones.mjs",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-trinquete-hardcodeo.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
