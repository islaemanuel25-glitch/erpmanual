  OVERRIDE_PRODUCTO
}

// ---------------------------------------------------------------------------
// NOTIFICACIONES INTERNAS (v1)
// Tabla standalone (sin FK) para no acoplar a Grupo/Usuario. Scope por grupoId;
// usuarioId null = notificación para todo el grupo. tipo/entidadTipo como String
// para evitar migraciones de enum por cada tipo nuevo.
// ---------------------------------------------------------------------------
// Alcance real de una notificación (aislamiento por ubicación).
//  - USUARIO: solo el usuarioId destinatario.
//  - LOCAL: usuarios cuya ubicación activa == localId.
//  - DEPOSITO: usuarios cuya ubicación activa == localId (que es un depósito).
//  - PARTICIPANTES: usuarios en origenLocalId o destinoLocalId (transferencias).
//  - GRUPO: todo el grupo (anuncios globales; comportamiento legacy).
enum AlcanceNotificacion {
  USUARIO
  LOCAL
  DEPOSITO
  PARTICIPANTES
  GRUPO
}

model Notificacion {
  id          Int      @id @default(autoincrement())
  grupoId     Int
  usuarioId   Int?
  tipo        String
  titulo      String
  cuerpo      String?
  href        String?
  entidadTipo String?
  entidadId   Int?
  leida       Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Aislamiento por ubicación. `alcance` define cómo se combinan estos campos con
  // la ubicación activa del lector (ver lib/notificaciones/scope.js).
  localId          Int?
  origenLocalId    Int?
  destinoLocalId   Int?
  alcance          AlcanceNotificacion @default(GRUPO)
  permisoRequerido String?

  // Estado de lectura POR USUARIO. La columna `leida` de arriba quedó LEGACY (no
  // se usa para el estado por-usuario): una notif general no puede quedar leída
  // para todos cuando un usuario la abre. Ver lib/notificaciones/scope.js.
  lecturas NotificacionLectura[]

  @@index([grupoId])
  @@index([usuarioId])
  @@index([grupoId, leida])
  @@index([localId])
  @@index([alcance])
}

// Lectura por usuario de una notificación. Su AUSENCIA = no leída para ese
// usuario; su presencia = leída. Nunca se muta el estado global de la notif.
model NotificacionLectura {
  id             Int      @id @default(autoincrement())
  notificacionId Int
  usuarioId      Int
  leidaAt        DateTime @default(now())

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, usuarioId])
  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// SUSCRIPCIONES WEB PUSH (Etapa 1) — un registro por dispositivo/navegador.
// Standalone (sin FK). Scope por grupoId; usuarioId = dueño de la suscripción.
// No se borra físico: activo=false al desuscribir o si el push service da 404/410.
// ---------------------------------------------------------------------------
model PushSubscription {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  usuarioId Int?
  localId   Int?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grupoId])
  @@index([usuarioId])
  @@index([localId])
  @@index([endpoint])
  @@index([grupoId, activo])
}

// ---------------------------------------------------------------------------
// IMPORTACIÓN DE LISTAS DE PRECIOS DE PROVEEDOR
//
// Un administrador sube el Excel del proveedor, el sistema lo parsea, lo concilia
// contra el catálogo y GUARDA el resultado. En esta etapa no se toca ningún
// costo: la importación es una propuesta revisable, y la cabecera + las filas SON
// la auditoría de esa propuesta.
//
// POR QUÉ SE GUARDAN TODAS LAS FILAS, INCLUSO LAS QUE NO SE PUEDEN APLICAR
//
// Una lista de Arcor trae 917 productos y solo una parte queda lista para
// actualizar. Guardar únicamente esa parte dejaría sin explicación las otras: por
// qué un producto no macheó, por qué un display quedó dudoso, por qué un kg quedó
// bloqueado. Esa explicación es lo que permite corregir el catálogo, y se pierde
// si no se persiste.
//
// ES ADITIVO. Dos tablas nuevas, tres enums nuevos y un campo nullable en
// Proveedor. No toca ninguna tabla existente ni requiere backfill.
// ---------------------------------------------------------------------------

enum EstadoImportacionLista {
  BORRADOR
  CONCILIADA
  APLICADA
  DESCARTADA
  /// Cancelada a mano. Queda como historial y LIBERA el archivo para poder
  /// volver a importarlo.
  CANCELADA
  /// Se aplicó una tanda pero quedan filas pendientes de decisión. La
  /// importación SIGUE ABIERTA: se puede vincular, seleccionar y aplicar de
  /// nuevo. Las filas ya aplicadas quedan cerradas una por una, no por el
  /// estado de la cabecera.
  PARCIALMENTE_APLICADA
}

/// Cómo se encontró el producto de una fila. Espeja TIPO_COINCIDENCIA del motor.
enum TipoCoincidenciaLista {
  CODIGO_INTERNO
  CODIGO_INTERNO_SIN_CEROS
  /// Fallback por terminación numérica. El número son los dígitos usados.
  SUFIJO_8
  SUFIJO_7
  SUFIJO_6
  SUFIJO_5
  SUFIJO_4
  /// Último camino que machea, dentro del universo del proveedor.
  CODIGO_BARRA
  AMBIGUA
  NINGUNA
}

/// Los ocho estados de `lib/proveedores/listas/estados.js`, sin inventar ninguno.
enum EstadoFilaLista {
  LISTO_PARA_ACTUALIZAR
  SIN_CAMBIOS
  NO_MACHEADO
  CODIGO_DUPLICADO
  FACTOR_DUDOSO
  EXCLUIDO
  BLOQUEADO
  ERROR
}

model ImportacionListaProveedor {
  id               Int @id @default(autoincrement())
  grupoId          Int
  proveedorId      Int
  usuarioId        Int
  /// Ubicación desde la que se operó. Define la regla de propiedad del costo.
  localOperativoId Int

  archivoNombre    String
  archivoTamano    Int
  /// SHA-256 del contenido. Es la identidad del archivo: el nombre no alcanza,
  /// porque el mismo Excel se baja dos veces con nombres distintos.
  archivoHash      String
  /// Dónde quedó el binario. NULLABLE A PROPÓSITO: el proyecto todavía no tiene
  /// almacenamiento permanente de archivos, y escribirlo en el disco del
  /// contenedor lo perdería al recrearlo. La conciliación se guarda completa sin
  /// el binario; cuando exista un almacenamiento real, este campo lo apunta.
  archivoUbicacion String?

  /// Qué parser lo leyó y con qué versión, para poder explicar un resultado viejo.
  parser        String
  parserVersion String

  recargoPct         Decimal @db.Decimal(6, 3)
  umbralVariacionPct Decimal @db.Decimal(6, 3)
  /// Qué se hará con el precio de venta al aplicar. Se guarda desde ahora para
  /// que la decisión quede registrada junto a la propuesta; todavía no se usa.
  modoPrecioVenta    String  @default("NO_TOCAR")

  estado EstadoImportacionLista @default(BORRADOR)

  totalFilas              Int @default(0)
  listoParaActualizar     Int @default(0)
  sinCambios              Int @default(0)
  noMacheadas             Int @default(0)
  codigoDuplicado         Int @default(0)
  factorDudoso            Int @default(0)
  excluidas               Int @default(0)
  bloqueadas              Int @default(0)
  errores                 Int @default(0)
  sugerenciasCodigoBarras Int @default(0)
  variacionAlta           Int @default(0)
  faltantes               Int @default(0)

  createdAt    DateTime  @default(now())
  conciliadaEn DateTime?
  aplicadaEn   DateTime?
  canceladaEn  DateTime?
  canceladaPorUsuarioId Int?
  /// Quién apretó "Aplicar". Se guarda acá y no solo en la bitácora porque
  /// esta pantalla tiene que poder explicar una corrida vieja sin depender
  /// de que el interceptor haya estado activo.
  aplicadaPorUsuarioId Int?
  /// Contadores del resultado. Se recalculan desde las filas, nunca se suman
  /// a mano.
  aplicadas Int @default(0)
  omitidas  Int @default(0)
  updatedAt    DateTime  @updatedAt

  grupo     Grupo                  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor Proveedor              @relation(fields: [proveedorId], references: [id])
  usuario   Usuario                @relation(fields: [usuarioId], references: [id])
  filas     ImportacionListaFila[]

  /// IDEMPOTENCIA REAL, a nivel base. Dos pedidos simultáneos con el mismo
  /// archivo no pueden crear dos importaciones: el segundo choca contra este
  /// índice. Un `findFirst` previo solo cubre el caso secuencial.
  /// El índice de archivo único es PARCIAL y vive en SQL: excluye las canceladas
  /// para que el mismo Excel se pueda volver a subir después de cancelar. Prisma
  /// no puede expresar un WHERE en @@unique, así que acá queda solo el índice de
  /// búsqueda y la unicidad la garantiza la migración.
  @@index([grupoId, proveedorId, archivoHash])
  @@index([grupoId, proveedorId, createdAt])
  @@index([grupoId, estado])
  @@index([usuarioId])
}

model ImportacionListaFila {
  id            Int @id @default(autoincrement())
  importacionId Int

  filaExcel  Int
  hojaNombre String

  codigoCrudo              String
  codigoNormalizado        String
  codigoComparableSinCeros String?
  codigoBarraProveedor     String?
  descripcionProveedor     String
  categoriaCruda           String?

  unidadProveedor  String
  unidadesPorBulto Int?
  /// Precio TAL COMO LO INFORMÓ el proveedor. Seis decimales: el archivo real
  /// trae valores como 1404.602001 y truncarlos falsearía la propuesta.
  precioConIva     Decimal  @db.Decimal(18, 6)
  precioSinIva     Decimal? @db.Decimal(18, 6)

  productoBaseId           Int?
  codigoProveedorId        Int?
  tipoCoincidencia         TipoCoincidenciaLista @default(NINGUNA)
  /// Con cuántos dígitos resolvió el fallback por sufijo. null si el vínculo no
  /// vino por ahí. Aparte del enum para poder contar sin parsear su nombre.
  sufijoDigitos            Int?
  /// Producto sugerido por código de barras. NO es un vínculo: hay que confirmarlo.
  sugerenciaProductoBaseId Int?
  sugerenciaCodigoBarra    String?

  costoAnterior          Decimal? @db.Decimal(12, 2)
  recargoPct             Decimal  @db.Decimal(6, 3)
  montoRecargo           Decimal? @db.Decimal(18, 6)
  precioConRecargo       Decimal? @db.Decimal(18, 6)
  factorErp              Int?
  costoUnitarioCalculado Decimal? @db.Decimal(18, 6)
  costoMaestroPropuesto  Decimal? @db.Decimal(12, 2)
  diferencia             Decimal? @db.Decimal(12, 2)
  diferenciaPct          Decimal? @db.Decimal(12, 4)
  variacionAlta          Boolean  @default(false)

  /// El enum lo garantiza la base: una fila no puede quedar con un estado que el
  /// motor no produce.
  estado EstadoFilaLista
  /// Motivo textual, tal como lo devuelve el motor o la configuración del
  /// proveedor. NO es enum a propósito: cada proveedor puede aportar motivos
  /// propios y no queremos una migración por cada uno.
  motivo String?

  seleccionable Boolean  @default(false)
  seleccionada  Boolean  @default(false)
  /// Excluida A MANO desde la pantalla de revisión. No pisa el estado que
  /// calculó el motor —que sigue explicando por qué la fila está como está—
  /// sino que la saca de lo aplicable y la deselecciona. Es reversible.
  excluidaManual Boolean @default(false)
  /// ── ARMADO CONFIRMADO A MANO ──────────────────────────────────────────
  ///
  /// Cuántas unidades del ERP cubre el precio del proveedor, cuando el motor
  /// no pudo deducirlo: el archivo y el producto declaran armados distintos, o
  /// el proveedor cotiza por display y el ERP no tiene ese concepto.
  ///
  /// Vive en la FILA y no en el producto a propósito: cambiar factor_pack
  /// reescribiría la ficha del producto para todo el ERP —compras, stock,
  /// transferencias— a partir de una lista de precios.
  factorConfirmado       Int?
  confirmadoPorUsuarioId Int?
  confirmadoEn           DateTime?
  /// ── VINCULACIÓN MANUAL (Etapa 6A) ─────────────────────────────────────
  ///
  /// Quién resolvió a mano una fila que no macheaba, cuándo y de dónde salió la
  /// decisión. Vive acá y no en AuditoriaBitacora porque el interceptor no
  /// audita ProductoCodigoProveedor: sin estos campos, crear un vínculo desde
  /// esta pantalla no dejaría rastro de quién lo hizo.
  vinculadoPorUsuarioId Int?
  vinculadoEn           DateTime?
  /// SUGERENCIA_CODIGO_BARRAS | BUSQUEDA_MANUAL
  origenVinculo         String?

  /// Se llenan en la etapa de aplicación. Acá nacen en false/null.
  aplicada      Boolean  @default(false)
  costoAplicado Decimal? @db.Decimal(12, 2)

  /// ── HISTORIAL DE LA APLICACIÓN ────────────────────────────────────────
  ///
  /// Vive en la fila y NO en AuditoriaBitacora a propósito. La bitácora
  /// registra que un producto cambió de costo, pero no por qué una fila
  /// NO se aplicó, y ese motivo es la mitad de la información que necesita
  /// quien revisa una corrida. Además el interceptor puede estar apagado.
  aplicadaEn           DateTime?
  aplicadaPorUsuarioId Int?
  /// APLICADA | OMITIDA. Texto y no enum: los motivos de omisión los aporta
  /// la configuración de cada proveedor y no queremos una migración por cada uno.
  resultadoAplicacion  String?
  motivoAplicacion     String?
  /// Costo que tenía el producto JUSTO ANTES de escribir. Puede diferir de
  /// `costoAnterior`, que es el que había al conciliar; la diferencia entre
  /// los dos es lo que delata que alguien movió el costo en el medio.
  costoPrevioAplicacion Decimal? @db.Decimal(12, 2)
  ventaAnterior         Decimal? @db.Decimal(12, 2)
  ventaNueva            Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importacion  ImportacionListaProveedor @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  productoBase ProductoBase?             @relation(fields: [productoBaseId], references: [id], onDelete: SetNull)

  /// Una fila física del Excel no puede entrar dos veces en la misma importación.
  @@unique([importacionId, hojaNombre, filaExcel], name: "fila_unica_por_importacion")
  @@index([importacionId, estado])
  @@index([importacionId, codigoNormalizado])
  @@index([productoBaseId])
  @@index([importacionId, filaExcel])
}
