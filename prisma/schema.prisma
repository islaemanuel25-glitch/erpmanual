generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  permisos  Json      @default("[]")
  // Roles de sistema (Admin, CAJERO, ENCARGADO, DUEÑO_LOCAL): no se eliminan ni
  // renombran. Admin conserva ["*"]; los demás tienen permisos ajustables por Admin.
  esSistema Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  usuarios  Usuario[]
}

model Grupo {
  id              Int                @id @default(autoincrement())
  nombre          String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  locales         GrupoDeposito[]
  localesGrupo    GrupoLocal[]
  productos       ProductoBase[]
  clientes        Cliente[]
  movimientosCC   MovimientoCuenta[]
  contadoresVenta PosVentaCounter[]
  configuracion   ConfiguracionGrupo?
  listasPrecio    ListaPrecio[]
  codigosProveedor ProductoCodigoProveedor[]
  decisionesDePrecio DecisionDePrecioProveedor[]
  lecturasDeProducto LecturaProductoProveedor[]
  productosQueNoSeCambian ProductoQueNoSeCambia[]
  importacionesLista ImportacionListaProveedor[]
  ofertas            Oferta[]
  acuerdosDepositoLocal AcuerdoDepositoLocal[]
}

model GrupoDeposito {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  /// Lista comercial default de ESTE depósito en ESTE grupo (opcional).
  /// Solo se aplica en el POS del depósito cuando la venta NO tiene lista de cliente.
  /// Nunca se aplica en los locales.
  listaPrecioDefaultId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  listaPrecioDefault ListaPrecio? @relation(fields: [listaPrecioDefaultId], references: [id], onDelete: SetNull)

  @@unique([grupoId, localId], name: "grupodeposito_unique")
  @@index([listaPrecioDefaultId])
}

model GrupoLocal {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([grupoId, localId], name: "grupolocal_unique")
}

/// EL ACUERDO DE CORTE ENTRE UN DEPÓSITO Y UN LOCAL.
///
/// Cada local le paga al depósito por PERÍODO, normalmente semanal, y todas las
/// transferencias de ese período se pagan juntas. Dónde corta la semana es un
/// acuerdo entre esos dos y no una constante del sistema: el depósito puede
/// cortar domingo con un local y lunes con otro.
///
/// ── POR QUÉ CUELGA DEL PAR Y NO DE `GrupoLocal` ─────────────────────────
///
/// Porque `GrupoLocal` dice grupo→local, y un grupo PUEDE tener más de un
/// depósito —`Grupo.locales` es una lista de `GrupoDeposito`—. Hoy hay uno solo,
/// así que colgarlo de ahí funcionaría y sería ambiguo el día que haya dos, que
/// es justamente el caso que la regla contempla.
///
/// ── SIN DEFAULT EN LA BASE, A PROPÓSITO ─────────────────────────────────
///
/// Una relación sin fila acá significa "todavía no se configuró", que NO es lo
/// mismo que "corta domingo". La pantalla cae al domingo para poder mostrar algo
/// y marca esa relación como SIN CONFIGURAR: quien entra tiene que ver cuáles
/// faltan. Un default en la base borraría esa diferencia sin que nadie lo note.
///
/// ── LO QUE ESTE MODELO NO SOPORTA TODAVÍA, Y HAY QUE SABERLO ANTES ──────
///
/// **Hoy el corte es SOLO DE PRESENTACIÓN.** El sistema no registra pagos: dice
/// cuánto se debe y nada más. Por eso cambiar `diaDeCorte` puede mover una
/// transferencia de una semana a otra sin consecuencia.
///
/// **El día que exista el registro de un pago, eso deja de ser inocuo.** Ese día:
///
///   · el período tiene que quedar CONGELADO en el pago —sus fechas de inicio y
///     fin guardadas en la fila del pago— y no recalcularse desde este acuerdo.
///     Si no, cambiar el corte movería plata ya cobrada de una semana a otra, y
///     dos semanas consecutivas podrían cobrar o perderse los mismos días;
///   · y esta tabla va a necesitar HISTORIAL, no un solo `diaDeCorte`: "cortaba
///     domingo hasta el 3 de octubre y lunes desde el 4". Con un único valor no
///     se puede reconstruir en qué período cayó una transferencia vieja.
///
/// Las dos cosas se deciden ese día y no éste, pero se anotan acá porque quien
/// escriba el registro de pagos va a leer este modelo antes.
model AcuerdoDepositoLocal {
  id              Int      @id @default(autoincrement())
  grupoId         Int
  depositoLocalId Int
  localId         Int
  /// 0 = domingo … 6 = sábado. Es el día en que ARRANCA el período.
  diaDeCorte      Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  grupo    Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  deposito Local @relation("acuerdo_deposito", fields: [depositoLocalId], references: [id], onDelete: Cascade)
  local    Local @relation("acuerdo_local", fields: [localId], references: [id], onDelete: Cascade)

  @@unique([depositoLocalId, localId], name: "acuerdo_deposito_local_unique", map: "acuerdo_deposito_local_unique")
  @@index([grupoId])
}

// ═══════════════════════════════════════════════════════════════════════════
// LA SEMANA OPERATIVA ES DE LA UBICACIÓN
// ═══════════════════════════════════════════════════════════════════════════
//
// ── ESTA ES LA FUENTE, Y `AcuerdoDepositoLocal.diaDeCorte` DEJA DE SERLO ─────
//
// La semana no es de Transferencias ni de Finanzas ni de un acuerdo entre dos
// ubicaciones: es de cada ubicación —cada local y también el depósito— y todo el
// ERP la consume. El acuerdo la tenía por PAR depósito–local, así que un local
// podía tener dos cortes y el depósito ninguno. Desde esta tabla nadie lee el
// acuerdo: quedó congelado y se retira cuando un candado demuestre cero lectores.
//
// ── POR QUÉ UNA FILA POR VIGENCIA Y NO UNA COLUMNA EN `ConfiguracionLocal` ────
//
// Porque la semana tiene HISTORIA. Cambiarla no puede reinterpretar semanas que
// ya pasaron, y una columna que se pisa las reinterpretaría todas. Acá cada cambio
// es una fila nueva que rige desde una fecha; la anterior no se toca.
//
// No hay "hasta": sale de la vigencia siguiente. Guardarlo sería una segunda
// verdad que un cambio mal escrito dejaría desalineada.
//
// ── `vigenteDesde` EN NULL ES "DESDE SIEMPRE" ───────────────────────────────
//
// Es la primera configuración de la ubicación: la que vino del acuerdo en la
// migración, o la primera que alguien carga. Las demás son cambios programados,
// y un cambio SIEMPRE rige desde el primer día de una semana futura
// (`lib/semanaOperativa/semanaOperativa.js`): nunca parte la semana abierta ni
// toca una anterior.
//
// ── LO QUE LA BASE GARANTIZA Y PRISMA NO EXPRESA ────────────────────────────
//
// Escrito a mano en la migración `20260924230000_semana_operativa_ubicacion`:
//
//   · CHECK "SemanaOperativaVigencia_dia_valido": el día es de 0 a 6.
//   · UNIQUE parcial "SemanaOperativaVigencia_desde_siempre_key": a lo sumo UNA
//     vigencia "desde siempre" por ubicación. El único de abajo no lo impide,
//     porque en PostgreSQL dos NULL nunca son iguales.
//
// `creadoPorId` es un sello de autoría sin relación Prisma, igual que
// `CierrePreparacion.iniciadoPorUsuarioId`: nadie navega del usuario hacia acá.
// En las filas de la migración queda en null, y `origen` dice por qué.
model SemanaOperativaVigencia {
  id           Int                   @id @default(autoincrement())
  localId      Int
  /// 0 = domingo … 6 = sábado. Es el día en que ARRANCA la semana, con la misma
  /// numeración que `Date.getUTCDay()` y que `AcuerdoDepositoLocal.diaDeCorte`.
  diaDeCorte   Int
  /// Día argentino desde el que rige. NULL = desde siempre.
  vigenteDesde DateTime?             @db.Date
  origen       OrigenSemanaOperativa
  creadoPorId  Int?
  createdAt    DateTime              @default(now())

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([localId, vigenteDesde])
}

/// De dónde salió una vigencia de semana operativa.
enum OrigenSemanaOperativa {
  /// Cargada por la migración desde `AcuerdoDepositoLocal.diaDeCorte`.
  MIGRACION
  /// Cargada o programada por una persona.
  MANUAL
}

model Local {
  id                    Int      @id @default(autoincrement())
  nombre                String
  tipo                  String   @default("local")
  direccion             String?
  telefono              String?
  email                 String?
  cuil                  String?
  ciudad                String?
  provincia             String?
  codigoPostal          String?
  activo                Boolean  @default(true)
  es_deposito           Boolean  @default(false)
  politicaLimiteCredito String   @default("ADVERTIR")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  grupoDepositos        GrupoDeposito[]
  grupoLocales          GrupoLocal?
  listasPrecio          ListaPrecio[]
  productosCreados      ProductoBase[]  @relation("ProductoBaseCreador")
  proveedoresCreados    Proveedor[]     @relation("ProveedorCreador")
  productos             ProductoLocal[]
  stock                 StockLocal[]
  transferenciasDestino Transferencia[] @relation("destino")
  transferenciasOrigen  Transferencia[] @relation("origen")
  usuarios              Usuario[]

  posTransferenciasOrigen  PosTransferencia[] @relation("pos_origen")
  posTransferenciasDestino PosTransferencia[] @relation("pos_destino")

  /// Los acuerdos de corte de período, por los dos lados de la relación.
  acuerdosComoDeposito AcuerdoDepositoLocal[] @relation("acuerdo_deposito")
  acuerdosComoLocal    AcuerdoDepositoLocal[] @relation("acuerdo_local")
  /// La semana operativa de esta ubicación, con su historia de vigencias.
  semanasOperativas    SemanaOperativaVigencia[]

  ventas            Venta[]
  turnos            Turno[]
  clientes          Cliente[]
  /// Cliente que representa a ESTE local en la agenda comercial (inversa de
  /// Cliente.localVinculadoId). El campo es @unique, así que hay a lo sumo uno.
  clienteVinculado  Cliente?                 @relation("ClienteLocalVinculado")
  tagsCliente       TagCliente[]
  movimientosCC     MovimientoCuenta[]
  puntosConfig      PuntosConfigLocal?
  movimientosPuntos ClientePuntoMovimiento[]
  contadorVenta      PosVentaCounter?
  pedidosProveedor   PedidoProveedor[]
  auditoriaStock     AuditoriaStock[]
  ticketConfig       TicketConfig?
  configuracionLocal ConfiguracionLocal?
  operadorAsignaciones OperadorEnLocal[]
  arqueos              ArqueoCaja[]
  arqueoPostergaciones ArqueoPostergacion[]
  cierresPreparacion   CierrePreparacion[]
  retirosPreparacion   RetiroPreparacion[]
  cambiosPendientes    CambioPendiente[]
  ofertas              Oferta[]
  recargosPago         RecargoPagoLocal[]
  mediosCobro          MedioCobroLocal[]
  /// Las compras cuyo GASTO es de esta ubicación.
  cuentasPorPagarDelGasto CuentaPorPagarProveedor[] @relation("cuenta_gasto")
  /// Los pagos cuyo DINERO salió de esta ubicación. Son dos listas distintas a
  /// propósito: ver `CuentaPorPagarProveedor`.
  pagosProveedorOrigen    PagoProveedor[]           @relation("pago_origen")
  /// Los gastos de ESTA ubicación: la única que los paga.
  gastos                  Gasto[]                   @relation("gasto_del_local")
  /// Los pagos de gastos cuyo dinero salió de esta ubicación.
  pagosGastoOrigen        PagoGasto[]               @relation("pago_gasto_origen")
  /// Las verificaciones de efectivo de Tesorería de esta ubicación.
  verificacionesEfectivo  VerificacionEfectivo[]    @relation("verificacion_efectivo_del_local")
  /// El catálogo de turnos operativos de esta ubicación.
  turnosOperativos        TurnoOperativo[]
}

// Configuración de comportamiento POR LOCAL. Reemplaza (con herencia) a los
// campos group-scoped de ConfiguracionGrupo para "vender sin stock" y "cliente
// obligatorio". Un campo null = heredar el valor efectivo del grupo (transición
// en dos fases: los campos de ConfiguracionGrupo se conservan en fase 1).
model ConfiguracionLocal {
  id                 Int      @id @default(autoincrement())
  localId            Int      @unique
  allowNegativeStock Boolean? // vender sin stock (config_local.stock)
  exigirClienteVenta Boolean? // cliente obligatorio en POS (config_local.pos)
  // Operario obligatorio para operar el POS de ESTE local (config_local.pos).
  // null = true (obligatorio) = comportamiento histórico; false = el local NO
  // exige operario (CAJERO/ENCARGADO operan sin PIN). Admin y DUEÑO_LOCAL siguen
  // exentos por rol en cualquier caso. Aislado por local (no afecta a otros).
  exigirOperador     Boolean?
  // Apariencia INSTITUCIONAL del local (config_local.apariencia): tema + opciones
  // de visualización de negocio que aplican a TODOS los dispositivos del local.
  // Distinta de la preferencia personal por navegador (localStorage).
  aparienciaJson     Json?

  /// ¿EL POS LE MUESTRA EL STOCK AL CAJERO? (config_local.pos)
  ///
  /// Solo cambia lo que se VE. Ocultar el stock no modifica las reglas, los
  /// permisos ni las validaciones de stock existentes: el descuento, el tope de
  /// `stockMax`, `allowNegativeStock` y la validación del backend siguen
  /// exactamente como estaban. Hay candados que lo comprueban.
  ///
  /// VA COMO COLUMNA por el mismo motivo medido que las de la tarjeta, unas
  /// líneas más abajo: el PUT de apariencia pisa `aparienciaJson` entero, así
  /// que guardar el tema borraría esto sin aviso. Nueve de las diez opciones de
  /// este modelo ya son columnas sueltas; el JSON es la excepción.
  ///
  /// NULLABLE, Y `null` SIGNIFICA APAGADO.
  ///
  /// ESTO SÍ CAMBIA LO QUE SE VE HOY, Y ES A PROPÓSITO. En producción el POS
  /// muestra el stock. Al desplegar, todos los locales quedan con la columna en
  /// `null` —o sea, en apagado— así que el stock deja de verse en todos hasta
  /// que alguien lo encienda, local por local, desde Configuración → POS Ventas.
  ///
  /// No es el patrón de `exigirOperador` ni el de `arqueoCajaActivo`, donde
  /// `null` conserva lo que ya pasaba. Acá `null` estrena un comportamiento
  /// nuevo, y por eso conviene avisarlo antes del despliegue en vez de que
  /// aparezca como una sorpresa en el mostrador.
  mostrarStockPos    Boolean?

  // Arqueos parciales de caja (config_local.alertas). Todo nullable: un local
  // sin fila conserva el comportamiento histórico (sin alertas), y por eso el
  // default efectivo de `arqueoCajaActivo` es false — activar esto en producción
  // tiene que ser una decisión explícita por local, nunca un efecto de la
  // migración.
  arqueoCajaActivo                 Boolean?
  /// Minutos entre arqueos. Se cuenta desde el último arqueo del turno, o desde
  /// la apertura si todavía no hubo ninguno.
  intervaloArqueoMinutos           Int?
  /// Demora tolerada antes de exigir autorización para postergar.
  toleranciaPostergacionMinutos    Int?
  /// Cuánto corre una postergación pedida por el cajero.
  postergacionCajeroMinutos        Int?
  requiereAutorizacionPostergacion Boolean?

  /// Fondo que el local quiere conservar en el cajón después de cada retiro.
  ///
  /// Nullable a propósito: `null` significa "no configurado", y ahí el sistema
  /// cae al `montoInicial` del turno. NUNCA cae a cero — sugerir retirar todo
  /// dejaría la caja sin cambio para seguir vendiendo.
  fondoObjetivoCaja                Decimal? @db.Decimal(12, 2)

  /// LA TARJETA DE PRODUCTO DEL CATÁLOGO, configurada por LOCAL (config_local.apariencia).
  ///
  /// Van como COLUMNAS y no dentro de `aparienciaJson`, y el motivo está medido:
  /// el PUT de apariencia PISA ese JSON entero —`update: { aparienciaJson: … }`
  /// con lo que venga— así que guardar el tema borraría estas preferencias sin
  /// aviso. Y su GET está abierto sin permiso a propósito, porque lo lee el
  /// layout raíz en cada página. Las otras nueve opciones de este modelo ya son
  /// columnas sueltas: el JSON es la excepción, no la regla.
  ///
  /// LAS DOS SON NULLABLE Y `null` SIGNIFICA APAGADO, que es el comportamiento
  /// histórico. Un local que nunca entre a la pantalla de apariencia ve
  /// exactamente lo de hoy. Es el mismo criterio que ya usa `exigirOperador` y
  /// que el encabezado de este modelo declara: "un local sin fila conserva el
  /// comportamiento histórico".

  /// SIN USO DESDE EL 2026-08-19. Nadie la lee para decidir nada.
  ///
  /// Servía para que el número grande mostrara siempre el precio unitario. Quedó
  /// sin efecto cuando la tarjeta pasó a mostrar la escala en la que se VENDE
  /// —la que decide el POS—: desde entonces el número no se elige. El
  /// interruptor se sacó de la pantalla de apariencia y del contexto.
  ///
  /// LA COLUMNA SE CONSERVA A PROPÓSITO: borrarla es un `DROP COLUMN` sobre una
  /// tabla de producción a cambio de dos bytes por local. El PUT la sigue
  /// aceptando y el GET devolviéndola, así que el dato de un local que la tenía
  /// prendida no se pierde. El detalle está en `lib/config/aparienciaLocal.js`.
  tarjetaPrecioUnitario            Boolean?

  /// La franja de escala deja de mostrar la equivalencia de bulto —"1 pack = 24
  /// un · $1.400 por unidad"—. NO apaga la franja: en el 40 % de las filas esa
  /// línea dice la escala y sacarla les quitaría información.
  tarjetaOcultarEquivalencia       Boolean?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@index([localId])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  rolId        Int
  localId      Int?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  local Local? @relation(fields: [localId], references: [id])
  rol   Rol    @relation(fields: [rolId], references: [id])

  confirmaciones TransferenciaDetalle[] @relation("TransferenciaDetalleConfirmadoPor")
  /// Líneas que esta persona agregó durante una recepción. Es la otra relación
  /// hacia `TransferenciaDetalle`, y por eso las dos van nombradas.
  lineasAgregadasEnRecepcion TransferenciaDetalle[] @relation("TransferenciaDetalleAgregadoPor")
  /// Los productos cuyo control físico esta persona dio por terminado. Tercera
  /// relación hacia `TransferenciaDetalle`, nombrada como las otras dos.
  lineasRevisadasEnRecepcion TransferenciaDetalle[] @relation("TransferenciaDetalleRevisadoPor")
  /// Las líneas históricas que esta persona decidió recibir en la presentación
  /// actual del depósito. Cuarta relación hacia `TransferenciaDetalle`.
  lineasConPresentacionAdoptada TransferenciaDetalle[] @relation("TransferenciaDetallePresentacionAdoptadaPor")

  posTransferencias            PosTransferencia[] @relation("pos_usuario")
  posTransferenciasSolicitadas PosTransferencia[] @relation("pos_solicitado_por")

  ventas            Venta[]
  turnos            Turno[]
  turnosCerrados    Turno[]            @relation("turnoCerradoPor")
  cajaMovimientos   CajaMovimiento[]
  arqueosComoCajero      ArqueoCaja[]         @relation("arqueoCajero")
  arqueosRealizados      ArqueoCaja[]         @relation("arqueoRealizadoPor")
  arqueosPostergados     ArqueoCaja[]         @relation("arqueoPostergadoPor")
  arqueosEntregados      ArqueoCaja[]         @relation("arqueoEntregadoPor")
  postergacionesArqueo   ArqueoPostergacion[] @relation("postergacionPor")
  postergacionesAutorizadas ArqueoPostergacion[] @relation("postergacionAutorizadaPor")
  movimientosPuntos ClientePuntoMovimiento[]
  movimientosCC     MovimientoCuenta[]
  auditoriaStock    AuditoriaStock[]
  importacionesLista ImportacionListaProveedor[]
  cuentasPorPagarCreadas CuentaPorPagarProveedor[] @relation("cuenta_creada_por")
  pagosProveedorRegistrados PagoProveedor[]        @relation("pago_registrado_por")
  gastosCreados          Gasto[]                   @relation("gasto_creado_por")
  pagosGastoRegistrados  PagoGasto[]               @relation("pago_gasto_registrado_por")
  verificacionesEfectivoHechas   VerificacionEfectivo[] @relation("verificacion_efectivo_hecha_por")
  verificacionesEfectivoAnuladas VerificacionEfectivo[] @relation("verificacion_efectivo_anulada_por")
  /// Las aplicaciones externas que este usuario autorizó a consultar en su nombre.
  vinculosIntegracion            VinculoIntegracion[]   @relation("vinculo_integracion_del_usuario")
  /// Los vínculos de integración que este usuario revocó (propios o ajenos).
  vinculosIntegracionRevocados   VinculoIntegracion[]   @relation("vinculo_integracion_revocado_por")

  @@map("Usuario")
}

model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  productos ProductoBase[]
}

model Proveedor {
  id        Int     @id @default(autoincrement())
  nombre    String
  cuit      String? @unique
  telefono  String?
  email     String?
  direccion String?

  // Local donde se dio de alta el proveedor. Se usa solo como fallback de
  // visibilidad cuando el proveedor todavía no tiene productos (Regla B): lo ve
  // quien lo creó. Con productos, la visibilidad se deriva de ellos.
  creadoEnLocalId Int?

  /// ── UMBRALES DE COSTO DEL MÓDULO DE COMPROBANTES ──────────────────────
  ///
  /// Desde qué diferencia porcentual una línea se marca para revisión, y desde
  /// qué BAJA se trata como sospecha de mala lectura en vez de precio nuevo.
  ///
  /// NULL = este proveedor no tiene el suyo y cae al default global
  /// (UMBRALES_COSTO_DEFAULT en lib/compras-proveedor/fronteraCosto.js: 5 y 15).
  /// Son nullables A PROPÓSITO: null y "igual al default" son cosas distintas.
  /// Si se copiara el default en cada fila, cambiarlo después no movería a
  /// nadie, que es exactamente el problema que el CLAUDE.md describe con el
  /// rango de aumento esperado escrito a mano en cinco lugares.
  ///
  /// Van por proveedor porque cada uno se mueve distinto y ese es el nivel
  /// donde se nota.
  umbralRevisarPct      Decimal? @db.Decimal(6, 3)
  umbralSospechaBajaPct Decimal? @db.Decimal(6, 3)

  /// ── CONFIGURACIÓN DE LISTAS DE PRECIOS DE ESTE PROVEEDOR ──────────────
  ///
  /// El rango de aumento esperado, el recargo comercial y los impuestos que este
  /// proveedor agrega por fuera de los de su lista. Hasta el 2026-09-16 vivían
  /// escritos en el código y valían lo mismo para todos.
  ///
  /// NULL = no está configurado, y NO hay valor de fábrica: sin rango y sin
  /// respuesta de impuestos, una lista de este proveedor NO se puede conciliar.
  /// La pantalla de subir los pide la primera vez. Esa es la diferencia que un
  /// DEFAULT en la base borraría, y es el mismo motivo por el que los dos
  /// umbrales de arriba son nullable.
  ///
  /// El prefijo `lista` los separa de esos umbrales, que son del módulo de
  /// comprobantes: dos pares de porcentajes sin prefijo se confunden, y los dos
  /// deciden costos.
  listaAumentoEsperadoMinPct Decimal? @db.Decimal(6, 3)
  listaAumentoEsperadoMaxPct Decimal? @db.Decimal(6, 3)
  listaRecargoPct            Decimal? @db.Decimal(6, 3)
  listaImpuestoAdicionalPct  Decimal? @db.Decimal(6, 3)
  /// ¿Ya se contestó si este proveedor tiene impuestos adicionales?
  ///
  /// NO SE DERIVA de `listaImpuestoAdicionalPct`. Un proveedor sin impuestos
  /// adicionales carga 0 % a propósito, y eso es un hecho distinto de no haber
  /// contestado todavía; sin este booleano los dos casos se guardarían igual.
  /// Es la misma forma del `total` obligatorio del lector de comprobantes que
  /// describe el CLAUDE.md: lo que puede faltar se pregunta aparte, con un
  /// booleano que no se pueda derivar de los otros datos.
  listaImpuestosDefinidos    Boolean  @default(false)

  /// ── CÓMO SE LEE LA LISTA DE ESTE PROVEEDOR ────────────────────────────
  ///
  /// El mapa de qué columna del archivo es el código, el código de barras, la
  /// descripción, la cantidad por bulto, el descuento y la o las de precio. Lo
  /// propone el sistema la primera vez, lo confirma el usuario desde la pantalla,
  /// y desde la segunda lista se aplica solo.
  ///
  /// Es JSON y no seis columnas porque cuántas columnas tiene un archivo no se
  /// sabe de antemano: una lista trae una de precio y otra trae cinco. El
  /// contenido lo valida `recetaDeLista.js`, no la base; un JSON que no cumple el
  /// contrato se trata como "sin receta" y se vuelve a pedir confirmación.
  ///
  /// NULL = este proveedor todavía no confirmó ninguna. Arcor no la necesita: su
  /// receta es su parser.
  listaRecetaLectura Json?
  /// La firma de la ESTRUCTURA del archivo con el que se confirmó la receta.
  ///
  /// Si el proveedor manda el mes que viene un archivo con otra forma, la huella
  /// no coincide y se vuelve a pedir confirmación en vez de leer con un mapa que
  /// ya no corresponde. Va aparte del JSON porque es un hecho distinto: uno dice
  /// CÓMO leer y el otro PARA QUÉ ARCHIVO vale ese cómo.
  listaRecetaHuella  String?

  /// Una receta POR GRUPO. `Proveedor` no tiene `grupoId` —es compartido entre
  /// grupos, y las tablas que cuelgan de él llevan el suyo—, así que desde acá
  /// se ven varias aunque cada grupo tenga una sola. La unicidad real la
  /// garantiza @@unique([grupoId, proveedorId]) en RecetaProveedor.
  recetas      RecetaProveedor[]
  /// La receta que armó el sistema y nadie confirmó todavía. Va aparte de
  /// `recetas` a propósito: ver RecetaPropuestaProveedor.
  recetasPropuestas RecetaPropuestaProveedor[]
  /// Las recetas de LECTURA, que son varias por proveedor: un mismo proveedor
  /// factura con formatos distintos —Consumidor Final, Responsable Inscripto— y
  /// eso no cambia sus impuestos. Por eso son otra tabla y no un campo más de
  /// `recetas`, que tiene @@unique([grupoId, proveedorId]) justamente porque la
  /// receta de impuestos de un proveedor es UNA.
  recetasLectura RecetaLecturaProveedor[]
  /// CÓMO SE LEE EL PRECIO DE CADA PRODUCTO DE ESTE PROVEEDOR.
  ///
  /// Distinto de `listaRecetaLectura`, que dice qué columna del ARCHIVO es el
  /// precio. Esto dice, para UN producto, si ese precio es por unidad o por caja
  /// y con qué cantidad — que es lo que una persona contesta una vez y el
  /// sistema no tiene por qué volver a preguntar.
  lecturasDeProducto LecturaProductoProveedor[]
  productosQueNoSeCambian ProductoQueNoSeCambia[]
  comprobantes ComprobanteProveedor[]
  cuentasPorPagar CuentaPorPagarProveedor[]

  dias_pedido DiaPedido[] @default([])

  /// Qué parser de lista de precios usa este proveedor.
  ///
  /// Es un identificador EXPLÍCITO que carga el administrador, no un nombre que
  /// se adivina. Reconocer al proveedor por el texto de su nombre sería frágil y
  /// peligroso: dos proveedores pueden llamarse parecido, y un parser equivocado
  /// leería un código de barras como si fuera un precio. Sin este campo cargado,
  /// el proveedor simplemente no admite importación de listas.
  ///
  /// Los valores válidos viven en lib/proveedores/listas/registro.js
  parserListaId String?

  activo    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  creadoEnLocal     Local?            @relation("ProveedorCreador", fields: [creadoEnLocalId], references: [id])
  productos         ProductoBase[]    @relation("productoProveedor1")
  productos2        ProductoBase[]    @relation("productoProveedor2")
  productos3        ProductoBase[]    @relation("productoProveedor3")
  pedidosProveedor  PedidoProveedor[]
  codigosProveedor  ProductoCodigoProveedor[]
  decisionesDePrecio DecisionDePrecioProveedor[]
  importacionesLista ImportacionListaProveedor[]

  @@index([creadoEnLocalId])
}

model AreaFisica {
  id          Int            @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        String?
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  productos   ProductoBase[]
}

model ProductoBase {
  id                Int          @id @default(autoincrement())
  grupoId           Int
  creadoEnLocalId   Int?
  nombre            String
  descripcion       String?
  sku               String?
  codigo_barra      String?
  codigo_barra_secundario String?
  categoria_id      Int?
  proveedor_id      Int?
  proveedor2_id     Int?
  proveedor3_id     Int?
  area_fisica_id    Int?
  unidad_medida     UnidadMedida
  factor_pack       Int?
  modo_pedido       ModoPedido   @default(BULTO)
  modo_envio        ModoEnvio?
  modo_stock        ModoStock    @default(BULTO)
  peso_kg           Decimal?     @db.Decimal(10, 3)
  volumen_ml        Decimal?     @db.Decimal(10, 2)

  // Compras a proveedor — modo fiambre
  modoCompraProveedor             ModoPedido @default(BULTO)
  pesoReferenciaKg                Decimal?   @db.Decimal(10, 3)
  pesoEsFijo                      Boolean    @default(false)
  modoVentaDeposito               ModoVentaDeposito @default(PESO)
  pesoPromedioKg                  Decimal?   @db.Decimal(10, 3)
  actualizaPromedioPorRecepcion   Boolean    @default(true)
  precio_costo      Decimal      @db.Decimal(12, 2)
  precio_venta      Decimal      @db.Decimal(12, 2)
  margen            Decimal?     @db.Decimal(6, 2)
  precio_sugerido   Decimal?     @db.Decimal(12, 2)
  iva_porcentaje    Decimal?     @db.Decimal(5, 2)
  fecha_vencimiento DateTime?
  redondeo_100      Boolean      @default(true)
  activo            Boolean      @default(true)
  imagen_url        String?
  es_combo          Boolean      @default(false)

  // Servicios de importe variable (cargas de colectivo / cargas virtuales).
  // modalidad = dimensión propia del producto (no simulada con otros flags).
  // recargoServicioDefaultPct = % de recargo general del servicio (0..100), que
  // ProductoLocal puede sobrescribir por local. Solo aplica si modalidad = IMPORTE_VARIABLE.
  modalidad                 ModalidadProducto @default(NORMAL)
  recargoServicioDefaultPct Decimal?          @db.Decimal(5, 2)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  area_fisica   AreaFisica? @relation(fields: [area_fisica_id], references: [id])
  categoria     Categoria?  @relation(fields: [categoria_id], references: [id])
  creadoEnLocal Local?      @relation("ProductoBaseCreador", fields: [creadoEnLocalId], references: [id])
  grupo         Grupo       @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor     Proveedor?  @relation("productoProveedor1", fields: [proveedor_id], references: [id])
  proveedor2    Proveedor?  @relation("productoProveedor2", fields: [proveedor2_id], references: [id])
  proveedor3    Proveedor?  @relation("productoProveedor3", fields: [proveedor3_id], references: [id])

  preciosPorLista ProductoListaPrecio[]
  locales         ProductoLocal[]
  ventaDetalles   VentaDetalle[]
  codigosProveedor ProductoCodigoProveedor[]
  decisionesDePrecio DecisionDePrecioProveedor[]
  componenteEnVentas VentaDetalleComponente[]
  lecturasDeProveedor LecturaProductoProveedor[]
  noSeCambiaDeProveedor ProductoQueNoSeCambia[]

  filasImportacionLista ImportacionListaFila[]

  // UNICIDAD DEL CÓDIGO POR CREADOR, NO POR GRUPO.
  //
  // Era `@@unique([grupoId, codigo_barra])` y eso le daba el código al primero
  // que lo cargaba en TODO el grupo: Mini el 7 y Casiano venden el mismo helado
  // y el segundo no lo podía dar de alta. Los locales son independientes — un
  // producto de un local no-depósito existe solo ahí (`productoVisibleWhere`).
  //
  // Con el creador adentro de la clave, la base garantiza exactamente lo que
  // puede garantizar mirando una sola tabla: que el depósito no repita un código
  // entre los suyos, y que cada local no lo repita entre los suyos.
  //
  // Lo que NO garantiza, y por eso vive en `validarUnicidadCodigos`: el cruce
  // principal ↔ secundario (dos columnas de la misma fila), el cruce
  // local ↔ depósito (filas de creadores distintos) y el cruce contra
  // `codigo_barra_propio` (otra tabla).
  //
  // `creadoEnLocalId` es nullable y en Postgres dos NULL no chocan, así que dos
  // productos huérfanos podrían repetir código. Hoy no hay ninguno —medido en
  // producción: 0 de 2840— y la función cierra ese caso igual, porque trata al
  // huérfano como de depósito (decisión D2).
  @@unique([grupoId, creadoEnLocalId, codigo_barra])
  @@index([grupoId])
  @@index([grupoId, codigo_barra_secundario])
  @@index([creadoEnLocalId])
  @@index([categoria_id])
  @@index([proveedor_id])
  @@index([proveedor2_id])
  @@index([proveedor3_id])
  @@index([area_fisica_id])
}

model ProductoCodigoProveedor {
  id                   Int      @id @default(autoincrement())
  grupoId              Int
  productoBaseId       Int
  proveedorId          Int
  codigoInterno        String
  descripcionProveedor String?
  activo               Boolean  @default(true)
  /// QUIÉN decidió este vínculo:
  ///   VINCULACION_MANUAL     una persona lo eligió en la pantalla de revisión.
  ///   APLICACION_AUTOMATICA  lo dedujo el motor y quedó guardado al APLICARSE la
  ///                          fila — o sea, se escribió un costo con él.
  ///
  /// Son dos hechos distintos y hasta ahora no se distinguían porque todos los
  /// vínculos eran humanos. Desde que el macheo se guarda al aplicar conviven los
  /// dos, y el día que uno salga mal hay que poder revocar los deducidos sin
  /// tocar los que eligió alguien.
  ///
  /// NULO en los vínculos anteriores a esta columna. No se rellenan: no consta de
  /// dónde salieron, y suponer que todos fueron manuales sería inventar el dato
  /// que la columna existe para registrar. Un nulo se deja en paz.
  origenAlta           String?
  /// CÓMO se encontró: CODIGO_EXACTO | ALIAS_CONFIRMADO | NOMBRE_EXACTO |
  /// APROXIMADO | MANUAL. Los mismos nombres que devuelve el motor de
  /// candidatos, para que no haya dos vocabularios para la misma pregunta.
  ///
  /// Es OTRA pregunta que `origenAlta` y por eso es otra columna. Aquélla dice
  /// si hubo una persona; ésta, por qué camino se llegó al producto. El caso más
  /// común las necesita a las dos: el motor lo dedujo por terminación y después
  /// alguien lo confirmó, y el día que las deducciones por terminación salgan
  /// mal hay que poder buscarlas sin tocar las que alguien miró.
  ///
  /// NULO en los vínculos anteriores. No se rellenan: no consta por dónde
  /// entraron, y suponerlo sería inventar el dato que la columna registra.
  metodoDeteccion      String?
  /// La descripción normalizada, para machear un alias sin volver a normalizar
  /// las 2.600 fichas en cada lectura. Es una copia derivada de
  /// `descripcionProveedor` y se reescribe con ella.
  descripcionNormalizada String?
  /// ── LA PRESENTACIÓN DEL PROVEEDOR ──────────────────────────────────────
  ///
  /// Cómo cotiza el proveedor: "x6", "DISPLAY 12", "caja". Texto libre porque es
  /// lo que dice el papel, y el papel no tiene enum.
  presentacionProveedor String?
  /// CUÁNTAS UNIDADES DEL ERP trae esa presentación. En "Gancia x6" son 6.
  ///
  /// El FACTOR DE CONVERSIÓN NO SE GUARDA: sale de dividir el `factor_pack` del
  /// producto por este número —24 ÷ 6 = 4—. Guardar el 4 lo dejaría podrido el
  /// día que el pack del ERP pase de 24 a 12, multiplicando por cuatro un pack
  /// que ya vale dos. Se guarda lo único que el ERP no puede saber.
  unidadesPorPresentacion Int?
  /// SI alguien la miró y dijo que sí, y quién. Tercer hecho, tercera columna.
  ///
  /// Sin esto, "confirmada" habría que deducirla de `origenAlta`, y eso hace
  /// imposible el caso de arriba: una deducción confirmada después quedaría
  /// indistinguible de una vinculación hecha a mano desde cero.
  confirmadaPorUsuarioId Int?
  confirmadaEn           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  grupo        Grupo        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])

  /// `name` NO se toca: es el alias con el que Prisma Client arma la clave
  /// compuesta, y cinco lugares del código lo usan como
  /// `where: { codigo_interno_unico_por_proveedor: … }`. `map` es otra cosa —el
  /// nombre físico del índice— y se agrega para que una base creada desde cero
  /// use el mismo que ya tiene producción.
  @@unique([grupoId, proveedorId, codigoInterno], name: "codigo_interno_unico_por_proveedor", map: "codigo_interno_unico_por_proveedor")
  @@index([grupoId, proveedorId, codigoInterno])
  /// El nombre físico de producción quedó cortado en los 63 caracteres que
  /// permite Postgres, y Prisma trunca distinto. Se fija el de producción tal
  /// cual, sin "arreglarlo": el objetivo es que las dos bases coincidan, no que
  /// el nombre quede lindo.
  @@index([grupoId, proveedorId, descripcionNormalizada], map: "ProductoCodigoProveedor_grupoId_proveedorId_descripcionNorma_id")
  @@index([productoBaseId])
  @@index([proveedorId])
}

/// LO QUE YA SE DECIDIÓ SOBRE EL PRECIO DE UN PRODUCTO DE UN PROVEEDOR.
///
/// ── QUÉ PROBLEMA RESUELVE ──────────────────────────────────────────────────
///
/// La diferencia entre lo que factura el proveedor y el costo interno es la
/// ganancia del depósito: es ESTABLE y esperada, así que vuelve idéntica en
/// cada factura. Hasta ahora nada la recordaba, y la pantalla volvía a
/// preguntar lo mismo sobre el mismo número en cada recepción. Medido sobre el
/// comprobante 5 del pedido 232: TRECE de sus quince renglones preguntan, y
/// ninguna de las trece respuestas sobrevive a la recepción.
///
/// ── POR QUÉ POR PROVEEDOR + PRODUCTO, IGUAL QUE EL ALIAS ───────────────────
///
/// Es la misma idea que `ProductoCodigoProveedor` —"ya te dije qué hacer con
/// esto"— aplicada al precio en vez de al producto. No va en la línea del
/// comprobante porque ahí muere con el papel, que es exactamente lo que pasa
/// hoy; ni en el producto, porque cada proveedor factura a su precio y una
/// decisión sobre el de uno no dice nada sobre el del otro.
///
/// ── SE GUARDAN LAS DOS RESPUESTAS, NO UNA ──────────────────────────────────
///
/// "Acepto el de la factura" y "dejo el mío" son las dos decisiones, y las dos
/// tienen que callar la pregunta la próxima vez. Guardar solo la primera —que
/// es la que deja rastro, porque escribe un costo— dejaría a la segunda
/// preguntando para siempre, que es el caso que más molesta.
///
/// ── Y SE GUARDAN LOS DOS PRECIOS QUE SE COMPARARON ─────────────────────────
///
/// Una decisión vale mientras el papel siga diciendo lo mismo CONTRA lo mismo.
/// Por eso se guardan los dos lados de la comparación tal como se le mostraron
/// a quien decidió: si cambia el de la factura, o si cambia el propio porque
/// alguien tocó el costo por otro lado, la comparación es OTRA y hay que
/// volver a preguntar — mostrando que antes se había decidido otra cosa.
///
/// Un hecho por columna: la decisión, y los dos números sobre los que se tomó.
/// Con un solo número guardado no se podría distinguir "cambió la factura" de
/// "cambió mi costo", que son dos cosas distintas para quien mira.
model DecisionDePrecioProveedor {
  id             Int @id @default(autoincrement())
  grupoId        Int
  proveedorId    Int
  productoBaseId Int

  /// ACEPTA_FACTURA | DEJA_EL_MIO. Los valores son los de DECISION_DE_PRECIO en
  /// `lib/compras-proveedor/decisionDePrecio.js`, que es el único lugar donde se
  /// escriben — la ruta y la pantalla los importan de ahí.
  decision String

  /// El precio de la factura sobre el que se decidió, en escala final y de
  /// bulto: el MISMO número que la pantalla mostró, no el neto impreso.
  precioFacturado Decimal @db.Decimal(18, 6)
  /// El costo propio contra el que se lo comparó, el mismo instante.
  precioPropio    Decimal @db.Decimal(18, 6)

  /// El costo maestro del catálogo —`ProductoBase.precio_costo`, en su misma
  /// escala— que el servidor tenía al tomar la decisión. NO es `precioPropio`,
  /// que es el costo de la LÍNEA del pedido. Si el catálogo ya no está en este
  /// número, la decisión se tomó mirando otro estado y deja de valer. NULL en
  /// las decisiones anteriores a la columna: no se reconstruye.
  costoMaestroObservado Decimal? @db.Decimal(12, 2)

  /// De qué renglón salió. Sirve para rastrear una decisión hasta el papel que
  /// la originó; no se usa para leerla, que siempre es por los tres primeros
  /// campos. Sin relación a propósito: la línea puede borrarse con su
  /// comprobante y la decisión sigue valiendo.
  comprobanteLineaId   Int?
  decididaPorUsuarioId Int?
  decididaEn           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grupo        Grupo        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)

  /// UNA decisión por producto y proveedor, igual que "no lo cambio": la última
  /// manda. No se acumula historial — lo que hay que contestar es "qué dijiste
  /// sobre esto", y dos respuestas viejas no ayudan a contestarlo.
  @@unique([grupoId, proveedorId, productoBaseId], name: "decision_precio_unica_por_proveedor", map: "decision_precio_unica_por_proveedor")
  @@index([grupoId, proveedorId])
  @@index([productoBaseId])
}

model ProductoLocal {
  id           Int      @id @default(autoincrement())
  localId      Int
  baseId       Int
  nombre       String?
  descripcion  String?
  precio_costo Decimal? @db.Decimal(12, 2)
  precio_venta Decimal? @db.Decimal(12, 2)
  margen       Decimal? @db.Decimal(6, 2)
  // Cómo se calcula el precio de venta EN ESTA UBICACIÓN. Es por ubicación igual
  // que el precio: dos locales pueden usar reglas distintas para el mismo producto.
  //   MARGEN_PORCENTUAL   → costo × (1 + margen/100). Es lo de siempre y el default,
  //                         así que ningún registro existente cambia de comportamiento.
  //   RECARGO_FIJO_UNIDAD → costo UNITARIO + recargoFijoUnidad, en pesos. No usa
  //                         `margen` ni el de la ficha.
  reglaPrecio       ReglaPrecio @default(MARGEN_PORCENTUAL)
  // Pesos que se suman al costo UNITARIO cuando la regla es RECARGO_FIJO_UNIDAD.
  // null en modo margen. El valor guardado NO se reconstruye desde el precio: solo
  // una edición manual del precio de venta puede cambiarlo (ver lib/precios).
  recargoFijoUnidad Decimal? @db.Decimal(12, 2)
  // Override por local del recargo del servicio de importe variable (0..100).
  // null → hereda ProductoBase.recargoServicioDefaultPct (y este, si null, → 0).
  recargoServicioPct Decimal? @db.Decimal(5, 2)
  // Código de barras PROPIO de esta ubicación (opcional). NO reemplaza los dos
  // códigos globales de ProductoBase: es un tercer código que solo funciona en este
  // local. null = sin código propio (default para productos existentes, sin backfill).
  codigo_barra_propio String?

  // ── ÚLTIMA REVISIÓN DEL PRECIO EN ESTA UBICACIÓN ──────────────────────────
  //
  // Es "última REVISIÓN", no "último cambio": mirar un precio hoy y decidir que
  // sigue estando bien lo pone al día aunque el importe no se toque. De eso vive
  // el control "Precios +30 días" de la pantalla de Productos.
  //
  // POR QUÉ UNA COLUMNA PROPIA Y NO `updatedAt`. Ese campo se mueve con
  // CUALQUIER escritura de la fila —un cambio de nombre, de proveedor, del
  // código propio— y diría que el precio se revisó cuando nadie lo miró.
  //
  // POR QUÉ POR UBICACIÓN. El precio de venta puede ser distinto por local, así
  // que revisar el de un local no dice nada sobre el de otro.
  //
  // `null` significa "sin evidencia de revisión" y cuenta como pendiente. Las
  // filas históricas se quedan en null a propósito: no se backfillea con
  // `updatedAt` porque esa fecha puede corresponder a otra edición.
  precioRevisadoAt DateTime?

  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  base  ProductoBase @relation(fields: [baseId], references: [id])
  local Local        @relation(fields: [localId], references: [id])

  stock    StockLocal[]
  detalles TransferenciaDetalle[]

  posDetalles             PosTransferenciaDetalle[]
  pedidoProveedorDetalles PedidoProveedorDetalle[]

  // Combos exclusivos por local (E1). Las FK son COMPUESTAS a (id, localId).
  combosComoCombo         ComboComponente[]        @relation("ComboComponente_comboPL")
  combosComoComponente    ComboComponente[]        @relation("ComboComponente_componentePL")
  ventaDetalleComponentes VentaDetalleComponente[]
  ofertaLineas            OfertaLinea[]

  @@unique([localId, baseId])
  @@unique([id, localId]) // destino de las FK compuestas de ComboComponente
  // Unicidad del código propio POR LOCAL: dos productos del mismo local no pueden
  // compartir codigo_barra_propio. En Postgres los NULL son distintos entre sí, así
  // que múltiples productos SIN código propio conviven sin chocar. El mismo código
  // propio SÍ puede repetirse en locales distintos (localId difiere).
  @@unique([localId, codigo_barra_propio])
  @@index([localId])
  @@index([baseId])
  /// Existe en producción desde `20260821030000_producto_local_precio_revisado`,
  /// creado por SQL crudo y nunca declarado acá.
  @@index([precioRevisadoAt])
}

model StockLocal {
  id         Int      @id @default(autoincrement())
  localId    Int
  productoId Int
  // Escala FÍSICA: 3 decimales, la misma que VentaDetalle.cantidadStock y que
  // piezasToKg(). Con 2 decimales una venta de 1.925 kg descontaba 1.92 pero
  // acreditaba 1.93 a enTransito, y vender+corregir dejaba 10.00 → 10.01.
  cantidad   Decimal  @db.Decimal(12, 3)
  enTransito Decimal  @default(0) @db.Decimal(12, 3)
  // stockMin/stockMax NO son cantidades movidas sino umbrales de alerta: quedan
  // en 2 decimales, alineados con AuditoriaStock.stockMin*/stockMax*.
  stockMin   Decimal? @db.Decimal(12, 2)
  stockMax   Decimal? @db.Decimal(12, 2)
  // ── QUÉ DISTINGUE "SIN AJUSTAR" DE "AJUSTADO EN CERO" ────────────────────
  //
  // Un límite en 0 es un valor CONFIGURADO válido, así que los VALORES no
  // alcanzan para contestar si alguien los ajustó alguna vez. Y el null tampoco:
  // cinco rutas creaban la fila con `stockMin: 0, stockMax: 0` mientras otras
  // tres la creaban en null, así que el mismo "nunca configurado" quedaba escrito
  // de dos formas. La peor era `stock_locales/listar`: ABRIR la pantalla creaba
  // filas con ceros.
  //
  // Medido en erpazul_dev antes de esta tanda, sobre 4.008 filas: 3.820 en null,
  // 126 en 0/0 —de las cuales UNA tenía auditoría de LIMITES, o sea un cero
  // puesto a propósito— y 62 con algún valor positivo. Esas 126 eran
  // indistinguibles entre sí mirando los valores.
  //
  // Por eso esto es una columna y no un predicado: es un HECHO propio —cuándo se
  // ajustaron los límites— y no algo derivable de otros datos. Regla 3 del
  // proyecto.
  //
  // LA ESCRIBE `/api/stock_locales/ajustar` con `modo: "limites"`, que es la
  // ruta que los dos modales usan de verdad. `/api/stock_locales/limites` es una
  // duplicada que HOY NO SE CONSUME —lo dice su propio encabezado— y se mantiene
  // coherente por si alguien la conecta, pero no es la única escritora ni la
  // principal. Decirlo importa: la especificación de la tanda apuntaba a esa
  // ruta, y sellar solo ahí habría dejado esta columna en null para siempre.
  limitesConfiguradosAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  local    Local         @relation(fields: [localId], references: [id])
  producto ProductoLocal @relation(fields: [productoId], references: [id])

  @@unique([localId, productoId])
  @@index([localId])
  @@index([productoId])
}

// ---------------------------------------------------------------------------
// LIBRO HISTÓRICO FÍSICO DE STOCK
// ---------------------------------------------------------------------------
//
// `StockLocal` es el estado VIVO: dice cuánto hay ahora y nada más. Este libro
// dice cómo se llegó ahí. Cada cambio real de `cantidad` o de `enTransito` deja
// una fila, y esa fila la escribe POSTGRESQL, no la aplicación: un trigger sobre
// `StockLocal` que corre dentro de la misma transacción que el cambio. Si la
// transacción se revierte, se van los dos; si confirma, quedan los dos. No hay
// forma de que `StockLocal` diga 18 y el libro 19.
//
// Es un trigger y no una puerta de la aplicación porque los relevamientos de
// escritores de stock se saltearon caminos tres veces, y un escritor que se
// olvida de la puerta deja un hueco sin avisar. El trigger no depende de que
// nadie se acuerde: captura rutas, scripts y SQL crudo por igual.
//
// La aplicación sólo DECLARA el origen —`lib/stock/libro/libroStock.js`— con una
// configuración local a la transacción. El que no lo declara queda como
// SIN_ORIGEN: la cantidad es igual de verdadera, lo que falta es la causa.
//
// Las funciones, los triggers y el punto cero viven en la migración
// `20260927120000_libro_stock`: Prisma no sabe expresarlos. El verificador es
// `scripts/verificar-libro-stock.mjs`.
//
// ── POR QUÉ NINGUNA COLUMNA TIENE CLAVE FORÁNEA ─────────────────────────────
//
// Porque el libro tiene que sobrevivir a lo que describe. `productos/eliminar`
// borra el producto físicamente, y una clave foránea obligaría a elegir entre
// impedir el borrado o borrar la historia con él. Es el mismo criterio que ya
// sigue `AuditoriaStock.productoLocalId`.
//
// ── CÓMO SE LEE ─────────────────────────────────────────────────────────────
//
// La cadena de un producto en una ubicación es `(localId, productoLocalId)`
// ordenada por `id`. El cierre de un día es el `...Posterior` del último
// movimiento con `dia` menor o igual; no hace falta sumar nada. Semana, mes y año
// son rangos de `dia`, y no reescriben ninguna fila si cambia la Semana
// Operativa.
enum TipoMovimientoStock {
  // El primer estado que el libro conoce de una fila, observado al activarse.
  // Sus `...Anterior` van en NULL: no dicen "había cero", dicen "no se sabe".
  ESTADO_INICIAL
  // La fila de StockLocal nace. Anteriores en NULL, incluso si nace en cero.
  ALTA
  // Cambió la cantidad, el tránsito o los dos.
  CAMBIO
  // La fila de StockLocal se borra. Posteriores en NULL y la identidad del
  // producto congelada, porque el producto puede desaparecer después.
  BAJA
}

model MovimientoStock {
  id              Int                 @id @default(autoincrement())
  // La fila de StockLocal que cambió. Distingue una fila recreada de la vieja
  // con el mismo producto y ubicación.
  stockLocalId    Int
  localId         Int
  productoLocalId Int
  // No se puede derivar después de un borrado, y es la clave con la que las
  // ventas nombran al producto (`VentaDetalle.productoBaseId`).
  productoBaseId  Int
  tipo            TipoMovimientoStock

  // La MISMA escala que StockLocal: son copias de sus valores.
  cantidadAnterior    Decimal? @db.Decimal(12, 3)
  cantidadPosterior   Decimal? @db.Decimal(12, 3)
  enTransitoAnterior  Decimal? @db.Decimal(12, 3)
  enTransitoPosterior Decimal? @db.Decimal(12, 3)

  // El reloj de POSTGRESQL, leído con el candado de fila tomado. En UTC y sin
  // zona, como todo el resto de la base.
  instante DateTime @db.Timestamp(3)
  // El día argentino de `instante`, calculado en la base con la zona explícita.
  // Se guarda y no se deriva: es un hecho del momento del cambio.
  dia      DateTime @db.Date

  // Lo que la aplicación declaró. SIN_ORIGEN si no declaró nada.
  origen    String
  origenRef String?

  // Solo en BAJA: lo mínimo para que el movimiento se entienda cuando el
  // producto ya no exista.
  nombreCongelado       String?
  codigoBarraCongelado  String?
  unidadMedidaCongelada String?

  // El verificador recorre cada cadena por `id`.
  @@index([localId, productoLocalId, id])
  @@index([localId, dia])
  // El Stock Diario: el último estado de una cadena ANTES de un día (apertura)
  // o HASTA un día (cierre) es un solo descenso de este índice, ordenando por
  // (dia, id). Sin él, un local entero recorre toda la historia de cada cadena
  // (`lib/stock/libro/stockDiarioServer.js`).
  @@index([localId, productoLocalId, dia, id])
}

// Lo que el trigger de StockLocal NO puede ver: un campo del producto o de la
// ubicación que cambia QUÉ SIGNIFICA la cantidad sin cambiar el número. Ayer
// `cantidad = 10` eran piezas y hoy son kilos.
//
// Acá no se convierte nada ni se decide nada: se deja constancia, con el valor
// anterior y el nuevo, de que la lectura de la cantidad cambió. Qué campos
// cuentan está en la migración y en `lib/stock/libro/libroStock.js`.
model ReinterpretacionDeStock {
  id             Int      @id @default(autoincrement())
  // "ProductoBase" o "Local".
  entidad        String
  entidadId      Int
  campo          String
  valorAnterior  String?
  valorPosterior String?
  // Cuántas filas de StockLocal tenían cantidad o tránsito distinto de cero en
  // ese momento. Cero: el cambio no reinterpretó nada. Es un hecho del momento y
  // no se puede reconstruir después.
  filasConStock  Int
  instante       DateTime @db.Timestamp(3)
  dia            DateTime @db.Date
  origen         String
  origenRef      String?

  @@index([entidad, entidadId])
  @@index([dia])
}

// ---------------------------------------------------------------------------
// EL LIBRO DE COSTOS: LA HISTORIA INMUTABLE DE LO QUE COSTABA CADA COSA
// ---------------------------------------------------------------------------
//
// El Stock Diario valoriza cada día con el costo vigente a las 00:00, hora
// Argentina, y lo congela todo el día aunque a las 14:00 cambie. Para eso hace
// falta saber qué costo había a una hora dada, y la base solo guarda el de
// ahora. Estas tablas guardan cada estado, escritas por triggers de PostgreSQL
// dentro de la misma transacción que el cambio: los ven Prisma, `createMany`,
// SQL directo y los scripts por igual.
//
// ── DOS HISTORIAS, UNA SOLA SECUENCIA ───────────────────────────────────────
//
// `CostoBaseVersion` guarda el estado de ProductoBase que decide el costo y su
// escala; `CostoUbicacionVersion`, el de ProductoLocal. Las dos toman su
// `version` de la MISMA secuencia, `libro_costo_seq`: el orden entre cualquier
// par de versiones es total aunque compartan instante o transacción. `txid` es
// la transacción que las produjo, para juntar lo que hizo una misma operación
// (la base y la propagación a sus locales, por ejemplo).
//
// ── CADA VERSIÓN ES EL ESTADO COMPLETO ──────────────────────────────────────
//
// No es un parche: se lee sola, sin recorrer las anteriores. `camposCambiados`
// dice qué movió un CAMBIO, y un UPDATE que no mueve nada de esto no deja fila.
// La BAJA lleva el último estado conocido y la identidad congelada: desde su
// instante, la fila ya no existe.
//
// ── LO QUE NO SE GUARDA, A PROPÓSITO ────────────────────────────────────────
//
// El costo EFECTIVO de una ubicación no se guarda: se reconstruye con la regla
// que ya existe, `precioDeLaUbicacion(base, local)`, sobre la versión de la base
// y la de la ubicación vigentes al mismo instante. Guardarlo sería una segunda
// verdad. Tampoco se convierte nada: la escala se guarda cruda —unidad, factor,
// peso, modos, combo, depósito— y la conversión es la de
// `lib/conversiones/costoPorUnidadFisica.js`.
//
// ── POR QUÉ NINGUNA COLUMNA TIENE CLAVE FORÁNEA ─────────────────────────────
//
// Porque el libro tiene que sobrevivir a lo que describe: un producto borrado
// sigue teniendo su historia. Mismo criterio que MovimientoStock.
//
// ── CUÁNDO EMPIEZA ──────────────────────────────────────────────────────────
//
// Esta estructura está inerte hasta que alguien llama a
// `libro_costo_activar()`: ahí se instalan los triggers de captura y se escribe
// el PUNTO_CERO, en una sola transacción. Antes del punto cero el libro no sabe
// nada y no inventa nada. Las funciones, los triggers y la activación viven en la
// migración `20260929120000_libro_costos`; el procedimiento, en
// `docs/architecture/libro-de-costos.md`.
enum TipoVersionCosto {
  // El estado observado al activarse el libro. No dice "desde cuándo": dice
  // "esto había cuando el libro empezó a mirar".
  PUNTO_CERO
  // La fila nace después del punto cero.
  ALTA
  // Cambió al menos un campo de los que el libro guarda. `camposCambiados` dice
  // cuáles; el resto de la fila es el estado completo.
  CAMBIO
  // La fila se borra, o deja de ser esta fila (otro local, otra base). Lleva el
  // último estado conocido.
  BAJA
}

model CostoBaseVersion {
  // De `libro_costo_seq`, compartida con CostoUbicacionVersion. La asigna el
  // trigger: nadie más escribe esta tabla.
  version        BigInt           @id
  productoBaseId Int
  grupoId        Int
  tipo           TipoVersionCosto
  instante       DateTime         @db.Timestamp(3)
  // El día argentino del instante (America/Argentina/Cordoba), el mismo reloj
  // que el libro de stock.
  dia            DateTime         @db.Date

  // El costo tal como está cargado: $/kg para lo que se mide en kilos, del
  // bulto para pack y cajón. Cero se guarda como cero: que no sea un costo
  // válido lo decide la regla de precios, no el libro.
  precioCosto         Decimal  @db.Decimal(12, 2)
  // La escala. En texto y no con los enums de ProductoBase: la historia tiene
  // que poder leerse aunque mañana cambien los valores de esos enums.
  unidadMedida        String
  factorPack          Int?
  pesoReferenciaKg    Decimal? @db.Decimal(10, 3)
  pesoEsFijo          Boolean
  modoCompraProveedor String
  modoVentaDeposito   String
  esCombo             Boolean

  camposCambiados String[]
  origen          String
  origenRef       String?
  txid            BigInt

  // Solo en la BAJA: quién era, porque el producto puede no existir más.
  nombreCongelado      String?
  codigoBarraCongelado String?

  // El estado de un producto a un instante: la versión con mayor `instante`
  // menor o igual —el candado de la fila hace que, dentro de un producto,
  // `instante` y `version` crezcan juntos—. Y su historia ordenada.
  @@index([productoBaseId, instante, version])
  @@index([txid])
}

model CostoUbicacionVersion {
  version         BigInt           @id
  productoLocalId Int
  productoBaseId  Int
  localId         Int
  tipo            TipoVersionCosto
  instante        DateTime         @db.Timestamp(3)
  dia             DateTime         @db.Date

  // CRUDO: el costo propio de la ubicación, o NULL si hereda el de la base. El
  // efectivo es `precioDeLaUbicacion(base, esto)`.
  precioCosto Decimal? @db.Decimal(12, 2)
  // Congelado: si la ubicación era depósito en ese momento. Decide si el stock
  // de peso fijo se cuenta en piezas o en kilos.
  esDeposito  Boolean

  camposCambiados String[]
  origen          String
  origenRef       String?
  txid            BigInt

  // El estado de todas las ubicaciones de un local a un instante —lo que pide
  // el Stock Diario de ese local— y la historia de una sola.
  @@index([localId, productoLocalId, instante, version])
  @@index([txid])
}

// La activación del libro: una sola fila, escrita por `libro_costo_activar()`
// en la misma transacción que el punto cero. Si no existe, el libro no está
// activo; si la activación falló, no existe ni ella ni nada del punto cero.
model LibroCostoActivacion {
  id                Int      @id
  instante          DateTime @db.Timestamp(3)
  // El día de la activación es PARCIAL: el primer día completo es el siguiente.
  dia               DateTime @db.Date
  txid              BigInt
  // Cotas EXCLUSIVAS: todas las versiones del punto cero están estrictamente
  // entre las dos, y todo lo posterior es mayor que `versionHasta`.
  versionDesde      BigInt
  versionHasta      BigInt
  cantidadBase      Int
  cantidadUbicacion Int
  // md5 del estado de las fuentes en el instante del punto cero, con el mismo
  // formato que `libro_costo_huella_punto_cero()` calcula sobre las versiones:
  // se puede volver a comprobar en cualquier momento.
  huellaBase        String
  huellaUbicacion   String
}

// ---------------------------------------------------------------------------
// COMBOS EXCLUSIVOS POR LOCAL (E1)
// ---------------------------------------------------------------------------
// Composición de un combo (ProductoBase.es_combo = true) atada a UNA ubicación.
// El combo y cada componente son ProductoLocal del MISMO local: se garantiza
// con dos FK COMPUESTAS a ProductoLocal(id, localId) + un CHECK de igualdad
// (comboLocalId = componenteLocalId) que se agrega en la migración.
// El combo NO tiene StockLocal propio; su disponibilidad se calcula (etapas
// posteriores) a partir del stock de sus componentes en ese local.
model ComboComponente {
  id                        Int      @id @default(autoincrement())
  comboProductoLocalId      Int
  comboLocalId              Int
  componenteProductoLocalId Int
  componenteLocalId         Int
  cantidad                  Decimal  @db.Decimal(12, 3)
  createdAt                 DateTime @default(now())

  // Borrar el ProductoLocal del combo elimina su composición (Cascade).
  comboPL      ProductoLocal @relation("ComboComponente_comboPL", fields: [comboProductoLocalId, comboLocalId], references: [id, localId], onDelete: Cascade, map: "ComboComponente_comboPL_fkey")
  // No se puede borrar un ProductoLocal que es componente de un combo (Restrict).
  componentePL ProductoLocal @relation("ComboComponente_componentePL", fields: [componenteProductoLocalId, componenteLocalId], references: [id, localId], onDelete: Restrict, map: "ComboComponente_componentePL_fkey")

  // Nombres explícitos (map): algunos superan los 63 chars y Prisma los truncaría.
  @@unique([comboProductoLocalId, componenteProductoLocalId], map: "ComboComponente_combo_componente_key") // sin componentes duplicados
  @@index([componenteProductoLocalId, componenteLocalId], map: "ComboComponente_componentePL_idx")
  @@index([comboLocalId])
}

model ListaPrecio {
  id               Int                 @id @default(autoincrement())
  localId          Int?
  grupoId          Int
  nombre           String
  tipoBase         ListaPrecioTipoBase @default(PRECIO_VENTA)
  margenPorcentaje Decimal?            @db.Decimal(6, 2)
  esDefault        Boolean             @default(false)
  /// Legacy (pre–listas comerciales por grupo): preferir `margenPorcentaje` + `tipoBase`.
  margen_default   Decimal?            @db.Decimal(6, 2)
  redondeo_100     Boolean             @default(false)
  activo           Boolean             @default(true)
  notas            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  local         Local?                @relation(fields: [localId], references: [id], onDelete: Cascade)
  grupo         Grupo                 @relation(fields: [grupoId], references: [id])
  productos     ProductoListaPrecio[]
  clientes      Cliente[]
  ventas        Venta[]
  ventaDetalles VentaDetalle[]
  depositosDefault GrupoDeposito[]

  @@unique([localId, nombre], name: "lista_unica_por_local")
  @@unique([grupoId, nombre], name: "lista_unica_por_grupo")
  @@index([localId])
  @@index([grupoId])
}

model ProductoListaPrecio {
  id              Int      @id @default(autoincrement())
  listaPrecioId   Int
  baseId          Int
  precio_final    Decimal? @db.Decimal(12, 2)
  margen_especial Decimal? @db.Decimal(6, 2)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  base  ProductoBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  lista ListaPrecio  @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, baseId], name: "precio_por_lista_y_producto")
  @@index([listaPrecioId])
  @@index([baseId])
}

model Transferencia {
  id                 Int       @id @default(autoincrement())
  origenId           Int
  destinoId          Int
  estado             String    @default("Pendiente")
  fechaEnvio         DateTime?
  fechaRecepcion     DateTime?
  creadaPor          Int?
  posTransferenciaId Int?
  /// Venta que originó este envío. NULL = transferencia manual (todas las de hoy,
  /// originadas en PosTransferencia). Uno a uno: una venta no puede generar dos
  /// remitos, así que aporta idempotencia estructural. El @unique ya crea el
  /// índice, no hace falta un @@index aparte. Convive con posTransferenciaId;
  /// todavía sin constraint de exclusión entre ambos.
  ventaId            Int?      @unique

  tieneDiferencias Boolean @default(false)

  // ── CANCELACIÓN ────────────────────────────────────────────────────────────
  //
  // ERP Azul no borra la historia de una operación. Una transferencia cancelada
  // conserva su fila, sus líneas y sus cantidades originales: lo único que cambia
  // es el estado y que deja de sumar al movimiento operativo del período.
  //
  // POR QUÉ NO ALCANZABA CON `updatedAt`. Hasta el 2026-08-20 la cancelación no
  // registraba nada: el propio código lo decía —"se usa updatedAt como registro
  // implícito de cuándo se canceló"— y eso no contesta ninguna de las tres
  // preguntas de una auditoría. `updatedAt` se mueve con CUALQUIER escritura, así
  // que ni siquiera prueba la fecha; y quién y por qué no estaban en ningún lado.
  //
  // Mismo patrón que `Venta.anuladaEn`: el estado se deriva de la fecha, no hay
  // booleano al lado. Los tres campos van juntos o no van — una cancelación sin
  // autor y sin motivo es indistinguible dentro de un mes de un error de datos.
  canceladaEn        DateTime?
  canceladaPorId     Int?
  motivoCancelacion  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destino          Local                  @relation("destino", fields: [destinoId], references: [id])
  origen           Local                  @relation("origen", fields: [origenId], references: [id])
  posTransferencia PosTransferencia?      @relation(fields: [posTransferenciaId], references: [id], onDelete: SetNull)
  venta            Venta?                 @relation("VentaTransferencia", fields: [ventaId], references: [id], onDelete: SetNull)
  detalle          TransferenciaDetalle[]

  @@index([origenId])
  @@index([destinoId])
  @@index([estado])
  @@index([createdAt])
  @@index([posTransferenciaId])
}

model TransferenciaDetalle {
  id              Int         @id @default(autoincrement())
  transferenciaId Int
  productoId      Int
  // Escala FÍSICA: 3 decimales, igual que StockLocal.cantidad. Enviar y recibir
  // tienen que poder expresar exactamente lo que el inventario movió.
  cantidad        Decimal     @db.Decimal(12, 3)
  recibido        Decimal?    @db.Decimal(12, 3)
  precioCosto     Decimal?    @db.Decimal(12, 2)
  unidadEnviada   ModoPedido? // BULTO o UNIDAD según cómo se envió

  motivoDiferencia String?
  motivoPrincipal  String? // ← AGREGADO
  motivoDetalle    String? // ← AGREGADO

  confirmadoPorId Int?
  fechaRecepcion  DateTime?

  // ── UNA LÍNEA QUE NO ESTABA EN EL REMITO ──────────────────────────────────
  //
  // Al abrir los bultos puede aparecer mercadería que el envío no registró. Esa
  // línea se agrega DURANTE la recepción, y para el inventario significa algo
  // distinto de una línea original: su `cantidad` es 0 —nunca se envió— así que
  // no tiene tránsito que limpiar, y su recibido es un descuento adicional al
  // origen.
  //
  // ── POR QUÉ UN BOOLEANO Y NO `cantidad === 0` ────────────────────────────
  //
  // Porque `cantidad === 0` es una coincidencia aritmética, no un hecho
  // registrado: una línea original enviada en 0 —que hoy el sistema no impide—
  // se leería igual, y sobre todo no contesta QUIÉN la agregó ni CUÁNDO. Ese
  // dato no se puede reconstruir después, y es exactamente lo que una auditoría
  // pregunta cuando aparece stock que nadie mandó.
  //
  // Los tres van juntos por el mismo motivo que `canceladaEn` / `canceladaPorId`
  // / `motivoCancelacion` unas líneas más arriba: una línea agregada sin autor y
  // sin fecha es indistinguible dentro de un mes de un error de datos.
  //
  // Default `false` y las otras dos nulables: las transferencias históricas
  // quedan exactamente como estaban, que es la verdad —ninguna línea vieja se
  // agregó en recepción, porque no se podía—.
  agregadoEnRecepcion     Boolean   @default(false)
  agregadoEnRecepcionPorId Int?
  agregadoEnRecepcionAt   DateTime?

  // ── EL PACK INCOMPLETO ────────────────────────────────────────────────────
  //
  // Salieron 6 PACK de 6 y llegaron 5 packs enteros más 5 unidades. Son 35
  // unidades físicas, y guardarlas como `recibido = 5.833` sería un error de
  // exactitud, no de redondeo: 5.833 × 6 = 34.998, y eso es lo que quedaría
  // escrito en el `Decimal(12,3)` del stock, en cada pack incompleto, para
  // siempre.
  //
  // Por eso son DOS datos explícitos y la intención queda en la estructura:
  //
  //   recibido                = 5   ← packs enteros, en la unidad del envío
  //   recibidoUnidadesSueltas = 5   ← unidades físicas fuera de los packs
  //
  // El total sale de multiplicar UNA vez y sumar —`milesimasFisicas`—, así que
  // no hay doble conversión ni decimal periódico.
  //
  // Nulable: la enorme mayoría de las líneas no tiene pack incompleto, y en una
  // línea enviada en UNIDAD el desglose no existe —se rechaza con
  // UNIDADES_SUELTAS_SIN_BULTO—.
  recibidoUnidadesSueltas Decimal? @db.Decimal(12, 3)

  // ── EL SNAPSHOT DE CÓMO SALIÓ DEL ORIGEN ──────────────────────────────────
  //
  // ── EL PROBLEMA, MEDIDO ───────────────────────────────────────────────────
  //
  // `unidadEnviada` es `ModoPedido`: BULTO o UNIDAD y nada más. Y el camino que
  // crea casi todas estas transferencias —la venta interna del POS— convierte
  // los packs a unidades ANTES de guardar, así que escribe UNIDAD siempre. Está
  // dicho en `mapearVentaATransferencia`: *"unidadEnviada='UNIDAD' y factorPack=1
  // SIEMPRE"*.
  //
  // Contado sobre producción el 2026-09-09: de 4631 líneas de productos `pack`,
  // solo 5 tenían BULTO. De 234 de cajón, 1. De 411 de kg, ninguna.
  //
  // Así que "6 CAJÓN x8" no era un problema de presentación: el dato no existía.
  //
  // ── Y NO ALCANZA CON CONGELAR UNA ETIQUETA ────────────────────────────────
  //
  // Hoy la aritmética lee el catálogo VIVO. `confirmar-recepcion` convierte
  // piezas a kilos con `base.pesoReferenciaKg` en el momento de confirmar, y la
  // recepción multiplica por `base.factor_pack`. Editar cualquiera de los dos
  // después de despachar cambia cuánto stock entra al destino de una
  // transferencia que ya salió. Por eso se congelan los NÚMEROS, no el rótulo.
  //
  // ── LOS CINCO HECHOS, Y POR QUÉ SON CINCO ─────────────────────────────────
  //
  // Se guarda lo mínimo que hace a esta fila autosuficiente. Nada que se pueda
  // derivar de lo que ya está.
  //
  // `cantidad` (física) NO se toca: es la que mantiene paridad con el descuento
  // de stock del origen. El snapshot agrega la otra mitad — cómo se contó.
  presentacionEnvio  PresentacionEnvio?
  /// Cuánto se despachó EN esa presentación: 6 cajones, 3,250 kg, 2 piezas.
  /// No se deriva de `cantidad` porque con un envío mixto no da entero: 4 packs
  /// de 6 más 5 sueltas son 29 unidades, y 29/6 no es 4.
  cantidadPresentada Decimal?           @db.Decimal(12, 3)
  /// Las unidades que viajaron FUERA de los bultos completos. Es lo que permite
  /// representar "4 PACK x6 + 5" sin escribir 4,833 packs, que es el mismo error
  /// de exactitud que `recibidoUnidadesSueltas` evita del lado de la recepción.
  sueltasEnviadas    Decimal?           @db.Decimal(12, 3)
  /// El factor CONGELADO. Sin esto, cambiar `factor_pack` de 8 a 12 reescribe
  /// cuántas unidades físicas dice haber movido una transferencia vieja.
  factorPresentacion Int?
  /// El peso de referencia CONGELADO, solo para PIEZA. Sin esto, editar
  /// `pesoReferenciaKg` después de despachar cambia cuántos kilos acredita
  /// `confirmar-recepcion` al destino.
  pesoPiezaKg        Decimal?           @db.Decimal(12, 3)

  // ── LOS CINCO DE ARRIBA PUEDEN VENIR DE DOS LADOS ─────────────────────────
  //
  // Nacieron como "así SALIÓ del origen". Pero una transferencia HISTÓRICA
  // —creada antes de que el snapshot existiera— sigue pudiendo estar abierta, y
  // el operador tiene cinco cajones en la mano mientras la pantalla le pide
  // contar 40 unidades. La salida es que él ADOPTE explícitamente la
  // presentación que el depósito usa hoy, para contar.
  //
  // Eso llena los mismos cinco campos, y ahí está el riesgo: sin una marca, esa
  // línea pasaría a afirmar que su presentación se registró al despachar. Sería
  // falso, y dentro de un mes indistinguible de una que sí se registró.
  //
  // ── POR QUÉ UNA FECHA Y UN AUTOR, Y NO UN ENUM DE PROCEDENCIA ────────────
  //
  // Porque las tres procedencias posibles ya se distinguen con lo que la fila
  // tiene: sin `presentacionEnvio` es reconstruida, con `agregadoEnRecepcion` es
  // un no declarado, y lo que falta es separar "se despachó así" de "alguien lo
  // adoptó acá". Un enum que repitiera lo que estas columnas ya dicen podría
  // contradecirlas. Ver `origenDePresentacion`.
  //
  // Y van los dos juntos por el mismo motivo que `agregadoEnRecepcionPorId` y su
  // fecha: una decisión sin autor ni momento no se puede auditar.
  //
  // Nulables las dos, sin default y sin backfill: ninguna línea existente fue
  // adoptada, porque no se podía. Y una fila con snapshot y sin esta marca se lee
  // como despacho, que es exactamente lo que era.
  presentacionAdoptadaAt   DateTime?
  presentacionAdoptadaPorId Int?

  // ── EL CONTROL FÍSICO TERMINADO ───────────────────────────────────────────
  //
  // "Revisado" NO es `recibido != null`. Son dos hechos distintos: alguien puede
  // haber empezado a escribir una cantidad y no haber terminado de contar. Esto
  // dice que esta persona TERMINÓ de verificar físicamente este producto.
  //
  // Y no puede ser estado de React: con 150 productos, cerrar el navegador y
  // volver tiene que conservar el avance. Por eso se persiste, y con autor y
  // fecha — sin ellos, dentro de un mes un checklist a medias es indistinguible
  // de un error de datos.
  //
  // `revisadoEnRecepcionAt` además ORDENA: los productos revisados se muestran
  // en el orden real en que aparecieron físicamente, que es como el operador
  // recorrió la mercadería.
  //
  // Default `false` y las otras dos nulables: las transferencias históricas
  // quedan exactamente como estaban. Ninguna se revisó con este mecanismo porque
  // no existía, y no se inventa quién ni cuándo.
  revisadoEnRecepcion      Boolean   @default(false)
  revisadoEnRecepcionPorId Int?
  revisadoEnRecepcionAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto      ProductoLocal @relation(fields: [productoId], references: [id])
  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  confirmadoPor Usuario?      @relation("TransferenciaDetalleConfirmadoPor", fields: [confirmadoPorId], references: [id])
  /// Quién agregó esta línea durante la recepción. Nombrada porque `Usuario` ya
  /// recibe otra relación desde esta misma tabla —el confirmador— y sin nombre
  /// Prisma no puede distinguirlas.
  agregadoEnRecepcionPor Usuario? @relation("TransferenciaDetalleAgregadoPor", fields: [agregadoEnRecepcionPorId], references: [id])
  /// Quién dio por terminado el control físico de esta línea. Nombrada por el
  /// mismo motivo: `Usuario` ya recibe otras dos relaciones desde esta tabla.
  revisadoEnRecepcionPor Usuario? @relation("TransferenciaDetalleRevisadoPor", fields: [revisadoEnRecepcionPorId], references: [id])
  /// Quién decidió recibir esta línea histórica en la presentación actual del
  /// depósito. Nombrada por el mismo motivo que las tres de arriba.
  presentacionAdoptadaPor Usuario? @relation("TransferenciaDetallePresentacionAdoptadaPor", fields: [presentacionAdoptadaPorId], references: [id])

  /// Los movimientos de stock que esta línea produjo al recibirse. La relación
  /// existe para que la auditoría no dependa del texto libre de `motivo`.
  auditoriasStock AuditoriaStock[]

  @@index([transferenciaId])
  @@index([productoId])
  @@index([agregadoEnRecepcionPorId])
  /// Sostiene la guarda de confirmación —"¿queda algún original sin revisar?"—,
  /// que corre en cada intento de confirmar filtrando por transferencia + flag.
  /// NO se indexa `revisadoEnRecepcionPorId`: nadie consulta "qué revisó tal
  /// persona", y un índice que nadie usa solo cuesta escrituras.
  @@index([transferenciaId, revisadoEnRecepcion])
}

enum DiaPedido {
  Lunes
  Martes
  Miercoles
  Jueves
  Viernes
  Sabado
  Domingo
}

enum UnidadMedida {
  unidad
  pack
  cajon
  kg
}

enum ModoPedido {
  BULTO
  UNIDAD
}

enum ModoEnvio {
  SOLO_BULTO
  MIXTO
  SOLO_UNIDAD
}

enum ModoStock {
  BULTO
  UNIDAD
}

enum ModoVentaDeposito {
  PIEZA
  PESO
}

/// EN QUÉ SE CONTÓ LO QUE UNA RECEPCIÓN SUMÓ A `StockLocal.cantidad`.
///
/// Son las tres ramas del cierre de una compra (`recibir/[id]`), y nada más: la
/// que no es de peso suma UNIDADES —un pack o un cajón ya entran multiplicados—,
/// y la de peso suma KILOS, salvo el fiambre de pieza fija en el depósito, que
/// suma PIEZAS. PACK y CAJÓN no están a propósito: son cómo se compra, no en qué
/// quedó contado el stock.
enum UnidadFisicaStock {
  UNIDAD
  KG
  PIEZA
}

/// ── EN QUÉ PRESENTACIÓN SALIÓ LA MERCADERÍA DEL ORIGEN ──────────────────────
///
/// `ModoPedido` solo sabe decir BULTO o UNIDAD, y con eso no se puede distinguir
/// un pack de un cajón, ni un kilo de una pieza. Un remito de 6 cajones de 8
/// quedaba escrito como 48 UNIDAD, y la pantalla no mentía: mostraba lo que el
/// dato decía.
///
/// Estos cinco valores son los que el dominio ya usa —`UnidadMedida` tiene
/// unidad, pack, cajon y kg, y `ModoVentaDeposito` agrega PIEZA— reunidos en una
/// sola pregunta: cómo se contó lo que salió.
enum PresentacionEnvio {
  UNIDAD
  PACK
  CAJON
  KG
  PIEZA
}

// Modalidad del producto. NORMAL = producto de precio/stock habitual.
// IMPORTE_VARIABLE = servicio cuyo importe lo ingresa el cajero en el POS
// (cargas de colectivo / cargas virtuales). No es un flag simulado (combo/peso/
// no-stock/lista): es una dimensión propia y explícita del producto.
enum ModalidadProducto {
  NORMAL
  IMPORTE_VARIABLE
}

enum EstadoPedidoProveedor {
  BORRADOR
  CONFIRMADO
  ENVIADO
  RECIBIDO
  ANULADO
}

model PosTransferencia {
  id        Int @id @default(autoincrement())
  origenId  Int
  destinoId Int
  usuarioId Int

  estado              String    @default("Borrador")
  origenManual        Boolean   @default(false)
  solicitadoAt        DateTime?
  solicitadoPorUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origen        Local    @relation("pos_origen", fields: [origenId], references: [id])
  destino       Local    @relation("pos_destino", fields: [destinoId], references: [id])
  usuario       Usuario  @relation("pos_usuario", fields: [usuarioId], references: [id])
  solicitadoPor Usuario? @relation("pos_solicitado_por", fields: [solicitadoPorUserId], references: [id])

  detalles       PosTransferenciaDetalle[]
  transferencias Transferencia[]

  @@index([origenId])
  @@index([destinoId])
  @@index([usuarioId])
  @@index([estado])
}

model PosTransferenciaDetalle {
  id                 Int @id @default(autoincrement())
  posTransferenciaId Int
  productoId         Int

  sugerido        Decimal?    @db.Decimal(12, 2)
  preparado       Decimal?    @db.Decimal(12, 2)
  tipo            String      @default("sugerido")
  unidadSugerida  ModoPedido  @default(BULTO)
  unidadPreparada ModoPedido? // BULTO o UNIDAD según cómo se preparó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pos      PosTransferencia @relation(fields: [posTransferenciaId], references: [id], onDelete: Cascade)
  producto ProductoLocal    @relation(fields: [productoId], references: [id])

  @@index([posTransferenciaId])
  @@index([productoId])
  @@index([tipo])
}

enum PrecioUpdateMetodo {
  MANUAL
  AUMENTO
  REGLAS
  PEGADO
  XLSX
  SCAN
  MARGEN_MASIVO
}

enum PrecioUpdatePricingMode {
  KEEP_VENTA
  RECALC_BY_MARGIN
  SET_VENTA
}

/// Cómo se deriva el precio de venta de una ubicación a partir del costo.
/// MARGEN_PORCENTUAL es el default y el comportamiento histórico.
enum ReglaPrecio {
  MARGEN_PORCENTUAL
  RECARGO_FIJO_UNIDAD
}

model PrecioUpdate {
  id          Int                     @id @default(autoincrement())
  grupoId     Int
  proveedorId Int?
  usuarioId   Int?
  metodo      PrecioUpdateMetodo
  pricingMode PrecioUpdatePricingMode
  createdAt   DateTime                @default(now())

  items PrecioUpdateItem[]

  @@index([grupoId])
  @@index([proveedorId])
}

model PrecioUpdateItem {
  id             Int @id @default(autoincrement())
  precioUpdateId Int
  productoBaseId Int

  costoAnterior Decimal @db.Decimal(12, 2)
  costoNuevo    Decimal @db.Decimal(12, 2)
  ventaAnterior Decimal @db.Decimal(12, 2)
  ventaNueva    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  update PrecioUpdate @relation(fields: [precioUpdateId], references: [id], onDelete: Cascade)

  @@index([productoBaseId])
}

// ---------------------------------------------------------------------------
// CLIENTES
// ---------------------------------------------------------------------------

model Cliente {
  id                  Int      @id @default(autoincrement())
  grupoId             Int
  /// Local PROPIETARIO de la ficha (ámbito de la agenda de clientes). NO indica
  /// que el cliente "sea" ese local: para eso está localVinculadoId.
  localId             Int?
  /// Local INTERNO del grupo que este cliente representa. NULL = cliente externo
  /// (el caso normal; en Postgres los NULL son distintos entre sí, así que todos
  /// los externos conviven bajo el @unique). Uno a uno: un local no puede estar
  /// representado por dos clientes. El @unique ya crea el índice, no hace falta
  /// un @@index aparte. Vínculo EXPLÍCITO: el local nunca se infiere por el nombre.
  localVinculadoId    Int?     @unique
  listaPrecioId       Int?
  nombre              String
  documento           String?
  telefono            String?
  email               String?
  direccion           String?
  observaciones       String?
  limiteCredito       Decimal? @db.Decimal(12, 2)
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  grupo             Grupo                    @relation(fields: [grupoId], references: [id])
  local             Local?                   @relation(fields: [localId], references: [id])
  localVinculado    Local?                   @relation("ClienteLocalVinculado", fields: [localVinculadoId], references: [id], onDelete: SetNull)
  listaPrecio       ListaPrecio?             @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  ventas            Venta[]
  tags              ClienteTag[]
  movimientosCC     MovimientoCuenta[]
  movimientosPuntos ClientePuntoMovimiento[]

  @@index([grupoId])
  @@index([localId])
  @@index([grupoId, localId])
  @@index([nombre])
  @@index([listaPrecioId])
}

model TagCliente {
  id                  Int      @id @default(autoincrement())
  localId             Int
  nombre              String
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  local    Local        @relation(fields: [localId], references: [id], onDelete: Cascade)
  clientes ClienteTag[]

  @@unique([localId, nombre])
  @@index([localId])
}

model ClienteTag {
  clienteId Int
  tagId     Int

  cliente Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tag     TagCliente @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clienteId, tagId])
  @@index([clienteId])
  @@index([tagId])
}

model MovimientoCuenta {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  clienteId Int
  tipo      String // "VENTA" | "PAGO" | "AJUSTE"
  direccion String // "DEBITO" | "CREDITO"
  monto     Decimal  @db.Decimal(12, 2)
  ventaId   Int?
  // Corrección de ventas (Fase B): discrimina los movimientos compensatorios de
  // una corrección. 0 = movimiento original (venta/pago/ajuste normal). >0 = id
  // de VentaCorreccion que lo generó. Permite reversas + nuevos débitos sin borrar
  // historial, preservando la idempotencia del alta (VENTA con correccionId=0).
  correccionId Int   @default(0)
  userId    Int?
  nota      String?
  createdAt DateTime @default(now())

  grupo   Grupo    @relation(fields: [grupoId], references: [id])
  local   Local    @relation(fields: [localId], references: [id])
  cliente Cliente  @relation(fields: [clienteId], references: [id])
  venta   Venta?   @relation(fields: [ventaId], references: [id])
  user    Usuario? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ventaId, tipo, correccionId])
  @@index([grupoId, localId, clienteId])
  @@index([clienteId])
  @@index([localId])
  @@index([createdAt])
  @@index([userId])
}

// POS VENTAS
// ---------------------------------------------------------------------------

model Venta {
  id               Int      @id @default(autoincrement())
  localId          Int
  vendedorId       Int
  operadorId       Int?
  clienteId        Int?
  listaPrecioId    Int?
  turnoId          Int?
  numero           Int
  clientTxnId      String?  @unique
  fecha            DateTime @default(now())
  subtotal         Decimal  @db.Decimal(12, 2)
  descuento        Decimal  @default(0) @db.Decimal(12, 2)
  descuentoAutomatico  Decimal? @db.Decimal(12, 2)
  descuentoManual      Decimal? @db.Decimal(12, 2)
  descuentoPorPuntos   Decimal? @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  comisionBancaria Decimal  @default(0) @db.Decimal(12, 2)
  comisionPct      Decimal? @db.Decimal(5, 2)
  // LOS IMPORTES DE ARRIBA Y DE ABAJO SON EXACTOS SOLO SI ESTO ES `false`.
  //
  // `true` significa que al menos un tender que cobra comisión se cobró SIN la
  // comisión configurada. `comisionBancaria`, `netoRecibido` y `gananciaNeta`
  // quedan con un cero estructural que NO es una medición.
  //
  // Es un snapshot de lo que se sabía al vender: configurar la comisión mañana
  // no lo cambia, porque la venta de hoy se cobró sin ese dato. Ver
  // `lib/pos-ventas/comisionPendiente.js`.
  comisionPendiente Boolean @default(false)
  netoRecibido     Decimal  @default(0) @db.Decimal(12, 2)
  costoTotal       Decimal  @default(0) @db.Decimal(12, 2)
  gananciaBruta    Decimal  @default(0) @db.Decimal(12, 2)
  gananciaNeta     Decimal  @default(0) @db.Decimal(12, 2)
  formaPago        String
  esFiado          Boolean  @default(false)

  // ── OFERTA Y RECARGO COMERCIAL — SNAPSHOT DE LA VENTA ──────────────────────
  //
  // Todo nullable y todo aditivo: las ventas anteriores a esta tanda quedan en
  // null y significan exactamente lo que significaban —no hubo oferta ni
  // recargo—, sin backfill y sin reinterpretar una sola columna vieja.
  //
  // `recargoPagoImporte` NO ES `comisionBancaria` Y NO SE PUEDE DEDUCIR DE ELLA.
  // El recargo se lo cobra el comercio AL CLIENTE y SUBE el total; la comisión
  // se la cobra el procesador AL COMERCIO y baja el neto. Un débito con 5 % de
  // recargo y 7 % de comisión sobre $10.000 da tres números distintos: el
  // cliente paga 10.500, el banco se queda 735, el comercio recibe 9.765.
  //
  // Por qué `totalAntesRecargo` es su propia columna y no `total menos
  // recargoPagoImporte`: la resta da lo mismo hoy, pero deja la ganancia de
  // mercadería dependiendo de que nadie toque nunca la fórmula. Guardado, el
  // reporte de "venta de mercadería" no necesita saber cómo se compone el total.
  //
  // `recargoPagoMedio` es el medio que IMPUSO la condición (el de mayor
  // recargo), no "el medio de la venta": en un pago mixto son cosas distintas y
  // esa diferencia es justamente lo que hay que poder auditar después.
  descuentoPromocional Decimal?   @db.Decimal(12, 2)
  totalAntesRecargo    Decimal?   @db.Decimal(12, 2)
  recargoPagoPct       Decimal?   @db.Decimal(5, 2)
  recargoPagoImporte   Decimal?   @db.Decimal(12, 2)
  recargoPagoMedio     MedioPago?

  // ── QUIÉN IMPUSO EL RECARGO, CUANDO FUE UNA MODALIDAD ────────────────────
  //
  // `recargoPagoMedio` congela el TIPO CONTABLE del que ganó, y en un pago mixto
  // eso ya era ambiguo: `CREDITO` no dice si fue "Mercado Pago · Crédito" o
  // "Banco X · Crédito". Con modalidades se vuelve indistinguible del todo.
  //
  // NO se duplica el porcentaje: `recargoPagoPct` ya congela el ganador. Lo que
  // se agrega es solo la IDENTIDAD, y en pares referencia + texto por el mismo
  // motivo que en `VentaPago`: la referencia opera, el texto explica, y el texto
  // sobrevive a que se renombre, se desactive o se borre la configuración.
  //
  // Misma distinción que en `VentaPago`, y por el mismo motivo:
  //
  //   · venta HISTÓRICA anterior a esto → los cuatro en null;
  //   · venta nueva cuyo recargo ganó un medio SIN modalidad → congela
  //     `recargoPagoMedioCobroLocalId` y `recargoPagoMedioNombre`, y deja los dos
  //     de modalidad en null;
  //   · venta nueva cuyo recargo ganó una modalidad → congela los cuatro.
  recargoPagoMedioCobroLocalId Int?
  /// Nombre del medio visible que impuso la condición, congelado.
  recargoPagoMedioNombre       String?
  recargoPagoModalidadId       Int?
  /// Nombre de la modalidad que impuso la condición, congelado.
  recargoPagoModalidadNombre   String?

  // Corrección de ventas (in-place versionada; ver model VentaCorreccion).
  // version = token de bloqueo optimista (se incrementa en cada corrección).
  version            Int      @default(0)
  corregida          Boolean  @default(false)
  ultimaCorreccionId Int?

  // ── ANULACIÓN ──────────────────────────────────────────────────────────────
  //
  // Una venta anulada SE MARCA, no se borra. El ticket conserva su número: el
  // contador es monótono y borrar la fila dejaría un hueco imposible de explicar
  // frente a una inspección, además de perder el rastro de que la venta existió.
  //
  // NO HAY UN BOOLEANO `anulada`, y es a propósito. El estado se deriva de
  // `anuladaEn`, igual que `Turno` deriva abierto/cerrado de `cierre`: dos
  // fuentes de verdad —un flag más una fecha— pueden discrepar, y el día que
  // discrepan no hay forma de saber cuál manda. Con una sola columna la pregunta
  // "¿está anulada?" tiene una sola respuesta posible.
  //
  // Los tres campos van juntos o no van: una anulación sin autor y sin motivo es
  // indistinguible dentro de un mes de un error de datos. La ruta los exige.
  // `anuladaPorId` es un Int suelto y no una relación a Usuario, siguiendo el
  // precedente de `VentaCorreccion.usuarioId`: una relación obligaría a agregar
  // el campo inverso en Usuario y ese modelo no se toca por un dato de autoría.
  // El nombre se resuelve con una consulta aparte donde haga falta mostrarlo.
  anuladaEn          DateTime?
  anuladaPorId       Int?
  motivoAnulacion    String?

  // Campos descriptivos editables por corrección SIMPLE (sin stock ni dinero).
  observaciones      String?
  referenciaInterna  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  local             Local                    @relation(fields: [localId], references: [id])
  vendedor          Usuario                  @relation(fields: [vendedorId], references: [id])
  operador          OperadorLocal?           @relation(fields: [operadorId], references: [id])
  cliente           Cliente?                 @relation(fields: [clienteId], references: [id])
  listaPrecio       ListaPrecio?             @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  turno             Turno?                   @relation(fields: [turnoId], references: [id])
  // `SetNull` por la misma razón que en `VentaPago`: borrar una modalidad de la
  // configuración no puede borrar ventas ni dejarlas sin explicación. El texto
  // congelado sigue ahí aunque la referencia se pierda.
  recargoPagoMedioCobro MedioCobroLocal?         @relation("RecargoImpuestoPorMedio", fields: [recargoPagoMedioCobroLocalId], references: [id], onDelete: SetNull)
  recargoPagoModalidad MedioCobroModalidadLocal? @relation("RecargoImpuestoPorModalidad", fields: [recargoPagoModalidadId], references: [id], onDelete: SetNull)
  detalles          VentaDetalle[]
  pagos             VentaPago[]
  movimientoCC      MovimientoCuenta[]
  movimientosPuntos ClientePuntoMovimiento[]
  /// Remito generado por esta venta (inversa de Transferencia.ventaId). Uno a uno:
  /// el campo del otro lado es @unique, así que hay a lo sumo un remito por venta.
  /// Si algún día se admite despacho parcial, se retira ese @unique, se agrega un
  /// número de remito y este campo pasa a lista.
  transferencia     Transferencia?           @relation("VentaTransferencia")

  @@unique([localId, numero])
  @@index([localId])
  @@index([fecha])
  @@index([clienteId])
  @@index([turnoId])
  @@index([clientTxnId])
  @@index([operadorId])
  @@index([listaPrecioId])
  // El filtro de venta comercial pregunta `anuladaEn: null` en TODA consulta de
  // arqueo, reportes y estadísticas. Sin índice, cada una de ésas hace un scan
  // más por una columna que en el 99,9 % de las filas vale null.
  @@index([anuladaEn])
  // Índices de las dos FK del snapshot de recargo, por la convención del repo:
  // toda FK lleva su índice.
  @@index([recargoPagoMedioCobroLocalId])
  @@index([recargoPagoModalidadId])
}

// LIBRO DE CORRECCIONES DE VENTA (antes/después) — inmutable, sin FKs duras
// (mismo patrón que AuditoriaBitacora). Una fila por corrección aplicada.
// Soporta desde el inicio la corrección de turno cerrado (movimientos
// compensatorios en el turno actual), aunque su UI se habilite en otra etapa.
model VentaCorreccion {
  id                Int      @id @default(autoincrement())
  ventaId           Int
  // "SIMPLE" | "COMPLETA" | "ANULACION"
  // ANULACION: la venta se declara inexistente. Devuelve el stock, revierte
  // cuenta corriente y puntos, y cancela el remito vinculado si lo hay.
  // `totalNuevo` va en 0 y `diferencia` en menos el total. Puede cruzar turnos:
  // `turnoIdOriginal` es el de la venta y `turnoIdCorreccion` el turno abierto
  // donde cae la diferencia, que pueden ser distintos.
  // Es un String y no un enum, así que este comentario es lo único que enumera
  // los valores — mantenerlo.
  tipo              String
  motivo            String
  // Idempotencia de la corrección COMPLETA: dos POST con la misma clave no la
  // aplican dos veces (se devuelve la corrección ya registrada).
  idempotencyKey    String?
  usuarioId         Int? // autor de la corrección
  operadorId        Int?
  localId           Int?
  grupoId           Int?
  turnoIdOriginal   Int? // turno de la venta al momento de corregir
  turnoIdCorreccion Int? // turno actual abierto donde impacta la diferencia (si hay)
  turnoCerrado      Boolean  @default(false)
  versionAntes      Int
  versionDespues    Int
  totalAnterior     Decimal  @db.Decimal(12, 2)
  totalNuevo        Decimal  @db.Decimal(12, 2)
  diferencia        Decimal  @db.Decimal(12, 2) // totalNuevo - totalAnterior
  // Snapshots completos (venta + detalles + componentes + pagos + CC) para
  // reconstruir el estado original y el resultante. JSON legible.
  snapshotAntes     Json
  snapshotDespues   Json
  diffProductos     Json? // [{productoBaseId, nombre, cantidadAntes, cantidadDespues, estado}]
  diffPagos         Json? // [{medio, montoAntes, montoDespues}]
  impactoStock      Json? // [{productoLocalId, nombre, delta, resultante}]
  impactoCaja       Json? // {signo, monto, medios, movimientoIds, cajaMovimientoIds}
  createdAt         DateTime @default(now())

  @@unique([ventaId, idempotencyKey])
  @@index([ventaId])
  @@index([usuarioId])
  @@index([createdAt])
  @@index([tipo])
}

model VentaDetalle {
  id                 Int                @id @default(autoincrement())
  ventaId            Int
  productoBaseId     Int
  listaPrecioId      Int?
  nombre             String
  /// Precio unitario final de línea (no duplicar con precioUnitario).
  precio             Decimal            @db.Decimal(12, 2)
  /// Costo unitario (no duplicar con costoUnitario).
  precioCosto        Decimal            @default(0) @db.Decimal(12, 2)
  cantidad           Decimal            @db.Decimal(12, 3)
  subtotal           Decimal            @db.Decimal(12, 2)
  ganancia           Decimal            @default(0) @db.Decimal(12, 2)
  comisionLinea      Decimal?           @db.Decimal(12, 2)
  tipoPrecioAplicado TipoPrecioAplicado @default(PRECIO_VENTA)
  margenAplicado     Decimal?           @db.Decimal(6, 2)

  // Snapshot histórico de SERVICIO de importe variable (nullable en líneas normales).
  // esServicio permite reconstruir la modalidad de la línea aunque el producto cambie.
  // El % y el importe del recargo quedan CONGELADOS al vender (no leer el producto actual).
  esServicio             Boolean  @default(false)
  importeBaseServicio    Decimal? @db.Decimal(12, 2)
  recargoServicioPct     Decimal? @db.Decimal(5, 2)
  recargoServicioImporte Decimal? @db.Decimal(12, 2)

  // Consumo físico CONGELADO de la línea (para reversión exacta al corregir).
  // productoLocalId = fila ProductoLocal descontada de StockLocal (junto a venta.localId).
  // cantidadStock = cantidad exacta descontada, en escala de StockLocal.
  // NULL en combos (su consumo vive en VentaDetalleComponente) y en servicios (sin stock).
  productoLocalId    Int?
  cantidadStock      Decimal? @db.Decimal(12, 3)

  // ── OFERTA APLICADA A ESTA LÍNEA — SNAPSHOT ────────────────────────────────
  //
  // `precio` (arriba) ya es el precio REALMENTE COBRADO, y `ganancia` ya se
  // calcula contra él: no se duplican. Lo que faltaba para poder reconstruir la
  // línea dentro de diez años es el precio que HABRÍA tenido sin la oferta, y
  // cuál era esa oferta.
  //
  // `ofertaNombre` es un snapshot y no un join: sobrevive a que la oferta se
  // borre. `ofertaId` va con SetNull para que se pueda borrar una oferta que
  // nunca se usó sin arrastrar historial, y para que una oferta borrada deje el
  // id en null en vez de apuntar a una fila que no existe. El nombre queda.
  precioNormal         Decimal? @db.Decimal(12, 2)
  ofertaId             Int?
  ofertaNombre         String?
  descuentoPromocional Decimal? @db.Decimal(12, 2)

  createdAt          DateTime           @default(now())

  venta        Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id])
  listaPrecio  ListaPrecio? @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  componentes  VentaDetalleComponente[]
  oferta       Oferta?      @relation(fields: [ofertaId], references: [id], onDelete: SetNull)

  @@index([ventaId])
  @@index([productoBaseId])
  @@index([listaPrecioId])
  @@index([ofertaId])
}

// COMPONENTES CONSUMIDOS POR UNA LÍNEA DE VENTA DE COMBO (E1)
// ---------------------------------------------------------------------------
// Congela QUÉ stock se descontó al vender un combo, para poder (a futuro)
// anular reponiendo cada componente y para trazabilidad/ticket. Una fila por
// componente consumido. Se puebla recién en la etapa del POS; la tabla nace en E1.
model VentaDetalleComponente {
  id              Int      @id @default(autoincrement())
  ventaDetalleId  Int
  productoBaseId  Int // identidad comercial/histórica del componente
  productoLocalId Int? // fila exacta de stock descontada
  cantidad        Decimal  @db.Decimal(12, 3) // ya multiplicada por la cantidad de combos vendidos
  precioCosto     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  // Cascade: borrar la línea de venta borra sus componentes congelados.
  ventaDetalle VentaDetalle @relation(fields: [ventaDetalleId], references: [id], onDelete: Cascade)
  // Restrict (intencional): si un ProductoBase participó como componente vendido,
  // NO puede eliminarse físicamente mientras exista este historial —preserva
  // identidad y trazabilidad—. El producto igual puede DESACTIVARSE (activo=false).
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id])
  // SetNull: la fila de stock exacta se conserva mientras exista; si algún día se
  // borra el ProductoLocal, la referencia queda null sin bloquear ni borrar el
  // historial (fallback: resolver por Venta.localId + productoBaseId).
  productoLocal ProductoLocal? @relation(fields: [productoLocalId], references: [id], onDelete: SetNull)

  @@index([ventaDetalleId])
  @@index([productoBaseId])
  @@index([productoLocalId])
}

// PAGOS DE LA VENTA (pago dividido / múltiples medios)
// ---------------------------------------------------------------------------
// Fuente de verdad de la DISTRIBUCIÓN del cobro de una venta. Una venta tiene 1+
// tenders cuya suma de `monto` == Venta.total (validado en el backend con Decimal).
// Los campos de pago en Venta (formaPago/comisionBancaria/comisionPct/netoRecibido/
// esFiado) se conservan como DERIVADOS/legacy. Cada tender congela su comisión.
// `monto` del tender efectivo = importe APLICADO a la venta (no el "paga con"/vuelto).
enum MedioPago {
  EFECTIVO
  MERCADOPAGO
  DEBITO
  CREDITO
  FIADO
}

model VentaPago {
  id          Int       @id @default(autoincrement())
  ventaId     Int
  medio       MedioPago
  monto       Decimal   @db.Decimal(12, 2) // aplicado a la venta (> 0)
  comisionPct Decimal?  @db.Decimal(5, 2) // % congelado (null si el medio no tiene comisión)
  comision    Decimal   @default(0) @db.Decimal(12, 2) // importe de comisión de ESTE tender
  neto        Decimal   @default(0) @db.Decimal(12, 2) // monto - comision
  createdAt   DateTime  @default(now())

  // ── CON QUÉ SE COBRÓ ESTE TENDER, Y CÓMO SOBREVIVE A LA CONFIGURACIÓN ─────
  //
  // `medio` sigue congelando el TIPO CONTABLE realmente utilizado, y
  // `comisionPct`, `comision` y `neto` siguen siendo el snapshot autoritativo de
  // la comisión. Lo que faltaba era la IDENTIDAD: dos tenders con
  // `medio = CREDITO` pueden ser "Mercado Pago · Crédito" y "Banco X · Crédito",
  // y hoy son indistinguibles para siempre.
  //
  // Van EN PARES, y no es redundancia. La referencia sirve para operar —agrupar,
  // conciliar, filtrar— y el texto para explicar. Si mañana se renombra el medio,
  // se renombra la modalidad, o se borra la configuración, la venta vieja tiene
  // que seguir diciendo lo que decía. Por eso las FK son `SetNull`: perder la
  // referencia no puede borrar el pago ni dejarlo mudo.
  //
  // ── "LEGACY" ES UNA FILA VIEJA, NO UN MEDIO SIN MODALIDADES ──────────────
  //
  // La distinción importa y es fácil de confundir. Hay TRES situaciones:
  //
  //   1. VENTA HISTÓRICA, anterior a esta funcionalidad.
  //      Los cinco en null. Es compatibilidad hacia atrás y nada más: nadie va a
  //      reescribirlas.
  //
  //   2. VENTA NUEVA con un medio configurable SIN modalidades.
  //      Congela `medioCobroLocalId`, `medioNombre` y `procesador`. Solo
  //      `modalidadId` y `modalidadNombre` quedan en null.
  //
  //      NO puede quedar identificada solo como `CREDITO`: dos medios distintos
  //      —"Banco X" y "Mercado Pago"— comparten ese enum, y agregar identidad
  //      operativa e histórica es justamente el punto de esta tanda. Un medio sin
  //      modalidades igual tiene nombre y procesador que congelar.
  //
  //   3. VENTA NUEVA con modalidad.
  //      Congela los cinco, y `medio` toma el `tipoContable` DE LA MODALIDAD.
  //
  // Nullable para que 1 siga siendo posible, no para que 2 se quede vacía.
  medioCobroLocalId Int?
  /// Nombre del medio visible tal como se leía al cobrar.
  medioNombre       String?
  /// POR DÓNDE pasó. Congelado: cambiar el procesador del medio no reescribe ventas.
  procesador        ProcesadorCobro?
  modalidadId       Int?
  /// Nombre de la modalidad tal como se leía al cobrar.
  modalidadNombre   String?

  // Cascade: la eliminación física de una venta arrastra sus pagos (hoy las ventas
  // no se anulan/eliminan; queda coherente para el futuro y para recuperación).
  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  medioCobro MedioCobroLocal?          @relation("PagoConMedioCobro", fields: [medioCobroLocalId], references: [id], onDelete: SetNull)
  modalidad  MedioCobroModalidadLocal? @relation("PagoConModalidad", fields: [modalidadId], references: [id], onDelete: SetNull)

  // ── UN TENDER POR MEDIO, Y UNO POR MODALIDAD ─────────────────────────────
  //
  // El `@@unique([ventaId, medio])` que había acá NO alcanza desde que un medio
  // puede tener modalidades: Mercado Pago/Débito y Mercado Pago/Crédito son dos
  // tenders del mismo enum y la restricción rechazaba el segundo. Medido.
  //
  // Y NO se reemplaza por `@@unique([ventaId, medio, modalidadId])`, que sería lo
  // obvio y estaría MAL: en PostgreSQL dos `NULL` nunca son iguales en un índice
  // único, así que dos tenders legacy —los dos con `modalidadId` en null— dejarían
  // de chocar. Eso aflojaría en silencio la protección que hoy funciona.
  //
  // Se reemplaza por DOS índices únicos PARCIALES, escritos a mano en la
  // migración porque Prisma no los expresa:
  //
  //   UNIQUE (ventaId, medio)      WHERE modalidadId IS NULL      ← contrato legacy, idéntico
  //   UNIQUE (ventaId, modalidadId) WHERE modalidadId IS NOT NULL ← una vez cada modalidad
  //
  // Nada que hoy se rechaza pasa a aceptarse. El candado estructural y las dos
  // contrapruebas están en `scripts/pruebas-db/mediosCobro.mjs`.
  @@index([ventaId])
  @@index([medio])
  @@index([medioCobroLocalId])
  @@index([modalidadId])
}

// TURNOS DE CAJA
// ---------------------------------------------------------------------------

model Turno {
  id           Int       @id @default(autoincrement())
  localId      Int
  vendedorId   Int
  operadorId   Int?
  cerradoPorId Int?
  apertura     DateTime  @default(now())
  cierre       DateTime?
  montoInicial Decimal   @db.Decimal(12, 2)

  montoEsperadoEfectivo Decimal? @db.Decimal(12, 2)
  montoRealEfectivo     Decimal? @db.Decimal(12, 2)
  diferenciaEfectivo    Decimal? @db.Decimal(12, 2)

  totalVentasEfectivo Decimal? @db.Decimal(12, 2)
  totalVentasDigital  Decimal? @db.Decimal(12, 2)
  cantidadVentas      Int?

  // ── CIRCUITO DEL DINERO FÍSICO ─────────────────────────────────────────────
  //
  // Antes el cierre guardaba cuánto se contó, pero no qué pasaba después con esa
  // plata. Como no había forma de registrar el retiro, el efectivo se quedaba en
  // el cajón: el turno siguiente declaraba un fondo de $10.000 mientras el cajón
  // tenía cientos de miles, y ese arrastre tapaba los faltantes reales.
  //
  // Ahora el cierre reparte el efectivo contado, sin resto:
  //     efectivoRetiradoCierre + fondoDejadoCierre = montoRealEfectivo
  //
  // Todo NULLABLE: los turnos cerrados antes de esto no se tocan y siguen
  // leyéndose igual (ver el test "turno histórico con campos NULL").
  efectivoRetiradoCierre   Decimal? @db.Decimal(12, 2)
  fondoDejadoCierre        Decimal? @db.Decimal(12, 2)
  /// CajaMovimiento RETIRO creado por el cierre. Se crea DESPUÉS del arqueo FINAL
  /// para que no altere el esperado de su propio cierre.
  retiroCierreMovimientoId Int?
  destinoRetiroCierre      String?
  /// Quién recibió la plata retirada. Texto libre a propósito: muchas veces es
  /// alguien que no tiene usuario en el sistema (el dueño, un familiar).
  recibidoPorCierre        String?

  // ── RECEPCIÓN DEL FONDO AL ABRIR ───────────────────────────────────────────
  //
  // El fondo sugerido es lo que dejó el cierre anterior; el recibido es lo que el
  // cajero contó de verdad. `montoInicial` SIEMPRE toma el recibido: si el sistema
  // impusiera el sugerido, una diferencia de recepción quedaría escondida y
  // reaparecería como faltante al cerrar, culpando al cajero equivocado.
  fondoSugeridoApertura    Decimal? @db.Decimal(12, 2)
  fondoRecibidoApertura    Decimal? @db.Decimal(12, 2)
  diferenciaFondoApertura  Decimal? @db.Decimal(12, 2)
  observacionFondoApertura String?
  /// Turno cuyo cierre dejó este fondo. @unique = el fondo de un cierre lo puede
  /// tomar UN solo turno: la base lo garantiza, no la aplicación.
  fondoOrigenTurnoId       Int?     @unique
  /// Inverso denormalizado: qué turno se llevó el fondo que dejó ESTE cierre.
  fondoConsumidoEnTurnoId  Int?

  // ── CIERRE CON RELEVO DE OPERADOR ──────────────────────────────────────────
  //
  // Instante en que se tomó el CORTE CONGELADO del turno. Desde acá el turno deja
  // de operar —no acepta ventas, ni Caja +/−, ni retiros, ni otro cierre— pero
  // todavía no está cerrado: el cajero saliente cuenta con calma en otra pestaña
  // mientras el operador que lo releva ya abre su turno y sigue vendiendo.
  //
  // POR QUÉ UN CAMPO NULLABLE Y NO UN ENUM `estado`
  //
  // El modelo ya expresa el estado del turno por presencia/ausencia: `cierre`
  // distingue abierto de cerrado y `anuladoEn` marca la anulación. Un enum nuevo
  // obligaría a backfillear los ~miles de turnos existentes y a mantener dos
  // fuentes de verdad que pueden discrepar (¿qué pasa si `estado = ABIERTO` y
  // `cierre != null`?). Con el campo nullable el estado se sigue derivando de los
  // datos, sin backfill: null = "sin corte", que es exactamente lo que eran todos
  // los turnos hasta hoy.
  //
  // Los tres estados, y son excluyentes en ese orden:
  //   cierre != null                                → CERRADO
  //   cierre = null, cierreEnPreparacionEn != null  → CIERRE_EN_PREPARACION
  //   cierre = null, cierreEnPreparacionEn = null   → ABIERTO
  //
  // Se deriva SIEMPRE con `estadoDelTurno()` (lib/caja/cierreRelevo.js), nunca
  // comparando campos a mano en cada consumidor.
  cierreEnPreparacionEn DateTime?

  // ── ANULACIÓN TÉCNICA ──────────────────────────────────────────────────────
  //
  // Un turno que se abrió por error o para probar el sistema NO es un cierre: no
  // hubo plata, no hubo conteo y no hubo diferencia. Cerrarlo como si fuera uno
  // normal obliga a inventar un contado —y con un fondo ficticio de $230.000 eso
  // significaba fabricar un faltante de $230.000 que nadie debe—.
  //
  // Con la marca, el turno se conserva ENTERO y auditable: la fila no se borra,
  // `montoInicial` no se pisa (es la evidencia de qué se cargó) y los importes de
  // cierre quedan en NULL, que significa "no se contó" y no "contó cero".
  //
  // Mismo patrón que ya usa el modelo en EstadoPedidoProveedor.ANULADO +
  // fechaAnulado. Las vistas los muestran como "Anulado" y los excluyen de las
  // métricas de caja, pero siguen listándose.
  anuladoEn       DateTime?
  anuladoPorId    Int?
  motivoAnulacion String?

  // ── TURNO OPERATIVO ────────────────────────────────────────────────────────
  //
  // ESTE MODELO SIGUE SIENDO UNA CAJA. El turno operativo es del catálogo del
  // local (`TurnoOperativo`) y la caja lo recibe al abrirse: la apertura lo
  // propone por la ventana de reconocimiento y quien abre confirma o cambia;
  // se guarda el FINAL. La fecha operativa es la de la jornada de ese turno y
  // la fija el servidor al abrir. Ninguno de los dos se recalcula después por
  // la hora, ni porque la caja cruce la medianoche.
  //
  // Los dos van juntos o ninguno, por CHECK; y una vez escritos no cambian, por
  // trigger, salvo la corrección de una caja ABIERTA de un turno a otro, sin
  // efectivo en una verificación vigente (migración
  // 20261005100000_correccion_turno_operativo_de_caja; la hace
  // `corregirTurnoOperativoDeCaja`). NULL = caja anterior a esto: NO se infiere a qué turno perteneció,
  // y Tesorería la muestra como "Sin turno asignado". La FK compuesta con
  // `localId` impide usar el turno de otro local. Migración
  // 20261004200000_turno_operativo.
  turnoOperativoId Int?
  fechaOperativa   DateTime? @db.Date

  /// DOS ÍNDICES PARCIALES QUE VIVEN SOLO EN SQL — no se pueden declarar acá.
  ///
  /// LA CAJA ES DEL OPERADOR. La cuenta ERP (`vendedorId`) autentica el acceso y
  /// queda como auditoría de quién abrió; el operador del PIN (`operadorId`)
  /// responde por el cajón. Varios operadores comparten la cuenta del local y
  /// cada uno tiene su propia caja.
  ///
  ///   CREATE UNIQUE INDEX "Turno_local_operador_abierto_key"
  ///       ON "Turno" ("localId", "operadorId")
  ///    WHERE "cierre" IS NULL AND "cierreEnPreparacionEn" IS NULL
  ///      AND "operadorId" IS NOT NULL;
  ///
  ///   CREATE UNIQUE INDEX "Turno_local_cuenta_sin_operador_abierto_key"
  ///       ON "Turno" ("localId", "vendedorId")
  ///    WHERE "cierre" IS NULL AND "cierreEnPreparacionEn" IS NULL
  ///      AND "operadorId" IS NULL;
  ///
  /// Con operador: a lo sumo una caja OPERATIVA por operador y local, con la
  /// cuenta que sea. Sin operador —locales sin operario, Admin y Dueño sin PIN,
  /// turnos históricos—: a lo sumo una por cuenta y local, como siempre. La
  /// regla en código es `whereCajaPropia` / `esCajaPropia` en
  /// lib/caja/cierreRelevo.js, y estos índices son su garantía ante dos
  /// aperturas simultáneas. Prisma no soporta `WHERE` en @@unique, y un @@unique
  /// común impediría tener dos turnos CERRADOS, que es lo normal.
  ///
  /// La condición sobre `cierreEnPreparacionEn` NO es un detalle: un turno con el
  /// corte de cierre tomado sigue con `cierre IS NULL`, así que sin esa cláusula
  /// la base rechazaría la apertura del relevo y el cierre en dos tiempos sería
  /// imposible.
  ///
  /// Reemplazan a "Turno_local_vendedor_abierto_key" (localId, vendedorId), que
  /// obligaba a dos operadores de la misma cuenta a compartir un cajón. El
  /// cambio es la migración 20261002120000_caja_por_operador. Prisma no ve estos
  /// índices; los cuida scripts/pruebas-db/estructura.mjs con su predicado.

  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  local       Local          @relation(fields: [localId], references: [id])
  vendedor    Usuario        @relation(fields: [vendedorId], references: [id])
  operador    OperadorLocal? @relation(fields: [operadorId], references: [id])
  cerradoPor  Usuario?       @relation("turnoCerradoPor", fields: [cerradoPorId], references: [id])
  turnoOperativo TurnoOperativo? @relation("caja_del_turno_operativo", fields: [turnoOperativoId, localId], references: [id, localId], onDelete: Restrict, onUpdate: Restrict)
  ventas      Venta[]
  cajaMovimientos CajaMovimiento[]
  arqueos         ArqueoCaja[]
  postergaciones  ArqueoPostergacion[]
  /// Cortes de cierre de ESTE turno. Es lista y no uno solo porque un corte
  /// cancelado deja su fila como evidencia y el turno puede tomar otro; el
  /// índice parcial garantiza que a lo sumo UNO esté vigente.
  cierresPreparacion CierrePreparacion[]
  /// Retiros de recaudación en preparación o ya confirmados de ESTE turno. Lista
  /// porque una caja hace varios retiros por jornada; el índice parcial garantiza
  /// que a lo sumo UNO esté en preparación a la vez.
  retirosPreparacion RetiroPreparacion[]
  /// Cambio que el cierre de ESTE turno dejó para el siguiente operador.
  /// Los sobres que ESTE turno publicó. Lista y no uno solo porque un corte
  /// cancelado deja su sobre CANCELADO como evidencia y el turno puede volver a
  /// cortar; el índice parcial garantiza que a lo sumo UNO esté vigente.
  cambiosDejados    CambioPendiente[]  @relation("cambioTurnoOrigen")
  /// Cambio que ESTE turno recibió al abrirse, si abrió tomando uno pendiente.
  cambioRecibido    CambioPendiente?   @relation("cambioTurnoDestino")
  /// Pagos a proveedor en EFECTIVO que salieron del cajón de ESTE turno.
  pagosProveedor    PagoProveedor[]
  /// Pagos de gastos en EFECTIVO que salieron del cajón de ESTE turno.
  pagosGasto        PagoGasto[]

  @@index([localId])
  @@index([vendedorId])
  @@index([apertura])
  @@index([operadorId])
  /// El POS pregunta "¿tengo turno operativo?" en cada carga: localId +
  /// vendedorId + los dos campos de estado, resuelto por índice.
  @@index([localId, vendedorId, cierre, cierreEnPreparacionEn])
  /// Tesorería toma las cajas de un período por su fecha operativa.
  @@index([localId, fechaOperativa])
  @@index([turnoOperativoId])
}

/// Arqueo de caja: foto contable de un conteo físico en un momento del turno.
///
/// Un turno puede tener CERO, uno o muchos arqueos PARCIALES y como mucho un
/// FINAL. El parcial NO cierra la caja ni corrige nada: solo deja registrado
/// qué esperaba el sistema y qué había realmente en el cajón.
///
/// Las diferencias de arqueos anteriores NO son movimientos de dinero y no
/// entran en el esperado del siguiente: un faltante detectado a las 10:00 sigue
/// faltando a las 12:00, pero es el MISMO faltante, no dos.
model ArqueoCaja {
  id      Int @id @default(autoincrement())
  turnoId Int
  localId Int

  /// Cajero responsable del turno (Turno.vendedorId, copiado al momento del arqueo).
  usuarioId Int
  /// Operario que estaba operando el POS, si el local los exige.
  operadorId Int?
  /// Quién ejecutó materialmente el conteo (puede no ser el responsable del turno).
  realizadoPorId Int

  fechaHora    DateTime @default(now())
  /// Ventana controlada por este corte: desde la apertura o el arqueo anterior,
  /// hasta el instante de confirmación calculado por el BACKEND.
  periodoDesde DateTime
  periodoHasta DateTime

  /// Misma precisión monetaria que Turno. Nunca float.
  efectivoEsperado Decimal @db.Decimal(12, 2)
  efectivoContado  Decimal @db.Decimal(12, 2)
  /// contado − esperado. Positiva = sobrante, negativa = faltante.
  diferencia       Decimal @db.Decimal(12, 2)

  observacion String?
  /// PARCIAL | FINAL
  tipo        String  @default("PARCIAL")

  // ── Alerta y auditoría de cumplimiento ──────────────────────────────────
  alertaProgramadaPara  DateTime?
  minutosDemora         Int?
  fuePostergado         Boolean   @default(false)
  postergadoPorId       Int?
  motivoPostergacion    String?
  cantidadPostergaciones Int      @default(0)

  /// Clave de idempotencia del cliente: dos envíos del mismo conteo (doble clic,
  /// dos pestañas) colapsan en una sola fila en vez de duplicar el arqueo.
  ///
  /// OJO: en Postgres los NULL no colisionan en un UNIQUE, así que una fila sin
  /// clave NO queda protegida. Para un conteo puro eso era tolerable (duplicar
  /// una foto molesta); para un RETIRO no lo es, porque duplicaría el descuento.
  /// Por eso /retiros/registrar EXIGE la clave, a diferencia de /arqueos/registrar.
  idempotencyKey String?

  // ── RETIRO DE DINERO ────────────────────────────────────────────────────
  //
  // Todos nullable a propósito. Los ~70 registros históricos fueron conteos
  // puros: no se sabe cuánto se retiró en ellos, y `0` afirmaría que no se
  // retiró nada. `null` = "esta operación no registraba retiros"; es la misma
  // distinción null ≠ 0 que ya sostiene el circuito del dinero en Turno.

  /// Lo que salió del cajón en esta operación.
  efectivoRetirado Decimal? @db.Decimal(12, 2)
  /// Fondo que el local quiere conservar. Se COPIA acá en vez de leerse de la
  /// configuración al mostrar: si mañana el local cambia su fondo objetivo, los
  /// retiros de ayer tienen que seguir explicándose con el que regía ese día.
  fondoObjetivo    Decimal? @db.Decimal(12, 2)
  /// Lo que quedó en el cajón. Invariante: retirado + dejado = contado.
  fondoDejado      Decimal? @db.Decimal(12, 2)

  /// Movimiento de caja que materializa el retiro. La relación es por ID y es
  /// 1:1 real (UNIQUE): dos registros no pueden apuntar al mismo movimiento, así
  /// que la base misma impide el doble descuento.
  cajaMovimientoRetiroId Int? @unique

  // ── Entrega diferida (etapa 4; acá solo se persiste el estado inicial) ───
  /// null = conteo histórico sin retiro. No se hace backfill: inventar
  /// PENDIENTE_ENTREGA en registros viejos afirmaría que hay plata sin rendir.
  estadoEntrega      EstadoEntregaRetiro?
  destino            String?
  recibidoPor        String?
  entregadoAt        DateTime?
  entregadoPorId     Int?
  observacionEntrega String?

  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  turno        Turno          @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local        Local          @relation(fields: [localId], references: [id])
  usuario      Usuario        @relation("arqueoCajero", fields: [usuarioId], references: [id])
  operador     OperadorLocal? @relation(fields: [operadorId], references: [id])
  realizadoPor Usuario        @relation("arqueoRealizadoPor", fields: [realizadoPorId], references: [id])
  postergadoPor Usuario?      @relation("arqueoPostergadoPor", fields: [postergadoPorId], references: [id])
  entregadoPor Usuario?       @relation("arqueoEntregadoPor", fields: [entregadoPorId], references: [id])
  cajaMovimientoRetiro CajaMovimiento? @relation("retiroDeArqueo", fields: [cajaMovimientoRetiroId], references: [id])
  /// La preparación que produjo este arqueo, si vino del flujo con corte. `null`
  /// en los arqueos históricos y en los del cierre, que tienen su propia tabla.
  retiroPreparacion    RetiroPreparacion? @relation("retiroDePreparacion")

  @@unique([turnoId, idempotencyKey])
  @@index([turnoId])
  @@index([localId])
  @@index([fechaHora])
  @@index([tipo])
}

/// Estado de la RENDICIÓN de un retiro, no del retiro en sí.
///
/// El dinero sale del cajón al confirmar el retiro; esto solo dice si ya se
/// documentó a quién se entregó. Un retiro PENDIENTE_ENTREGA ya descontó: no
/// vuelve a mover plata cuando se completa la entrega.
enum EstadoEntregaRetiro {
  PENDIENTE_ENTREGA
  ENTREGADO
}

/// Postergación de una alerta de arqueo vencida.
///
/// Vive aparte de ArqueoCaja porque ocurre ANTES de que el arqueo exista: es el
/// acto de posponer el conteo, no el conteo. Al registrarse finalmente el
/// arqueo, sus contadores se copian a la fila de ArqueoCaja como resumen.
model ArqueoPostergacion {
  id      Int @id @default(autoincrement())
  turnoId Int
  localId Int

  /// Vencimiento que se estaba postergando.
  alertaProgramadaPara DateTime
  /// Hasta cuándo corre esta postergación.
  venceEn              DateTime
  minutosDemora        Int      @default(0)

  postergadoPorId Int
  motivo          String?
  /// Presente solo cuando la demora superó la tolerancia y el local exige
  /// autorización: deja registrado QUIÉN habilitó seguir sin contar.
  autorizadoPorId Int?

  creadoEn DateTime @default(now())

  turno         Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local         Local    @relation(fields: [localId], references: [id])
  postergadoPor Usuario  @relation("postergacionPor", fields: [postergadoPorId], references: [id])
  autorizadoPor Usuario? @relation("postergacionAutorizadaPor", fields: [autorizadoPorId], references: [id])

  @@index([turnoId])
  @@index([localId])
  @@index([venceEn])
}

// ═══════════════════════════════════════════════════════════════════════════
// CIERRE CON RELEVO DE OPERADOR
// ═══════════════════════════════════════════════════════════════════════════
//
// El problema real: cerrar caja bloqueaba el mostrador. El cajero que se va tiene
// que contar el cajón billete por billete, y mientras tanto nadie puede vender
// porque el turno sigue abierto y el POS está tomado por el modal de cierre.
//
// La solución es partir el cierre en dos actos separados en el tiempo:
//
//   1. CORTE  — instantáneo. Congela el efectivo esperado y la frontera de qué
//               ventas y movimientos pertenecen a este turno. El turno deja de
//               operar; el relevo ya puede abrir el suyo y seguir vendiendo.
//   2. CONFIRMACIÓN — cuando el cajero terminó de contar, en su propia pestaña.
//               Usa el esperado CONGELADO en el paso 1: nunca se recalcula.
//
// Que el esperado no se recalcule es la razón de ser de todo esto. Si al
// confirmar se volviera a calcular, incluiría las ventas que el relevo hizo
// mientras tanto y el cajero saliente aparecería con un faltante gigante por
// plata que nunca tuvo en las manos.

/// Estado del CORTE. No describe el dinero —eso es EstadoCambioPendiente—, solo
/// en qué punto del cierre está el turno.
enum EstadoCierrePreparacion {
  /// Corte tomado, conteo pendiente. El turno no opera.
  PREPARANDO
  /// Conteo confirmado: existe el arqueo FINAL y el turno quedó cerrado.
  CONFIRMADO
  /// Corte anulado antes de confirmar. Solo posible si nada dependía de él.
  CANCELADO
  /// Pasó el plazo sin confirmar. VENCIDO NO significa liberado: el corte sigue
  /// congelado, el turno sigue sin operar y el cierre todavía puede confirmarse.
  /// Es una marca de ATRASO para que alguien lo resuelva, nada más.
  VENCIDO
  /// Resuelto ADMINISTRATIVAMENTE sin conteo: el corte venció y el conteo físico
  /// ya no existe. El turno queda cerrado con el esperado congelado y con lo
  /// contado y la diferencia DESCONOCIDOS —NULL, no cero—. No hay arqueo FINAL
  /// ni movimiento de retiro, porque nadie observó esa plata. Es final. No es
  /// CONFIRMADO: confirmado significa que alguien contó.
  CERRADO_SIN_CONTEO
}

/// Estado de un RETIRO DE RECAUDACIÓN en preparación.
///
/// Tres estados y no cuatro: a diferencia del cierre, un retiro NO congela el
/// turno —la caja sigue vendiendo— así que dejarlo abierto no traba a nadie y no
/// hace falta una marca de atraso que alguien tenga que resolver.
enum EstadoRetiroPreparacion {
  /// Corte tomado y cambio separado. El turno SIGUE OPERANDO.
  PREPARANDO
  /// Conteo confirmado: existe el ArqueoCaja PARCIAL y el CajaMovimiento.
  CONFIRMADO
  /// Abandonado antes de confirmar. No movió plata: el cambio nunca salió del
  /// cajón y no se creó ningún movimiento.
  CANCELADO
}

/// Estado del CAMBIO físico que un cierre dejó en el local para el próximo turno.
enum EstadoCambioPendiente {
  /// Está en el local y cualquier operador habilitado puede tomarlo.
  DISPONIBLE
  /// Alguien lo eligió y está contándolo. La reserva vence sola.
  RESERVADO
  /// Ya lo tomó un turno concreto. Es terminal.
  RECIBIDO
  CANCELADO
  /// Sin resolver por demasiado tiempo. Igual que arriba: no libera la plata,
  /// solo la marca como pendiente de resolución.
  VENCIDO
}

/// El CORTE CONGELADO de un turno: la foto del cierre antes de contar.
///
/// SOBRE LOS IDs DE ACTORES SIN RELACIÓN PRISMA
///
/// `iniciadoPorUsuarioId`, `iniciadoPorOperadorId` y los equivalentes de
/// CambioPendiente son Int planos, igual que `Turno.anuladoPorId` y
/// `Turno.retiroCierreMovimientoId`. Es el patrón que ya usa este circuito: son
/// sellos de autoría histórica, no dueños del registro, y no hay ninguna consulta
/// que navegue desde el usuario hacia acá.
model CierrePreparacion {
  id Int @id @default(autoincrement())

  /// Llave de acceso a la pantalla de cierre. Aleatoria y no adivinable.
  ///
  /// POR QUÉ UN TOKEN Y NO EL OPERADOR ACTIVO
  ///
  /// El operador vive en una cookie httpOnly del NAVEGADOR, no de la pestaña:
  /// cuando el relevo hace login en la pestaña del POS, la pestaña del cierre
  /// —que revalida al recuperar el foco— pasa a ver al operador nuevo. Si el
  /// cierre dependiera del operador activo, terminaría firmado por quien no
  /// contó. Con el token, la pantalla del cierre no lee el operador activo en
  /// absoluto: la autoría es la que quedó grabada acá al tomar el corte.
  token String @unique

  /// ÍNDICE PARCIAL QUE VIVE SOLO EN SQL — no se puede declarar acá.
  ///
  ///   CREATE UNIQUE INDEX "CierrePreparacion_turno_vigente_key"
  ///       ON "CierrePreparacion" ("turnoId")
  ///       WHERE "estado" IN ('PREPARANDO', 'CONFIRMADO');
  ///
  /// "Un corte VIGENTE por turno", no "un corte por turno". La diferencia
  /// importa: un corte CANCELADO es un corte que se deshizo, y el turno volvió a
  /// operar — tiene que poder tomar otro. Con un @unique común, cancelar por
  /// error quemaba el turno para siempre y no había forma de volver a cerrarlo.
  ///
  /// Mismo patrón que "Turno_local_operador_abierto_key": Prisma no soporta
  /// `WHERE` en @@unique. Vive en la migración 20260804200000_cierre_relevo_operador.
  turnoId Int
  localId Int
  grupoId Int

  iniciadoPorUsuarioId  Int
  iniciadoPorOperadorId Int?
  iniciadoEn            DateTime @default(now())
  /// Instante exacto del corte. Es el `periodoHasta` del arqueo FINAL.
  corteEn               DateTime

  estado EstadoCierrePreparacion @default(PREPARANDO)

  /// EL NÚMERO QUE NO SE RECALCULA. Efectivo esperado al instante del corte,
  /// con la fórmula única de lib/caja/efectivoEsperado.js.
  efectivoEsperadoCorte Decimal @db.Decimal(12, 2)

  /// FRONTERA POR ID, NO POR TIMESTAMP.
  ///
  /// Dos filas creadas en el mismo milisegundo son indistinguibles por fecha, y
  /// una venta que entra justo durante el corte caería de los dos lados o de
  /// ninguno. Con `id <= ultimaVentaId` el universo del turno queda cerrado sin
  /// ambigüedad. Son Int planos a propósito: una FK impediría borrar una venta
  /// vieja por el solo hecho de haber sido la última antes de un corte.
  ultimaVentaId       Int?
  ultimoMovimientoId  Int?
  cantidadVentasCorte Int  @default(0)

  /// EL CAMBIO SE SEPARA ANTES DEL CORTE, no al final.
  ///
  /// Estos dos se graban al INICIAR, no al confirmar. Ese es el orden físico
  /// real: primero se aparta el dinero que queda para seguir vendiendo, después
  /// se corta, y recién entonces se cuenta lo que se retira. Desde el corte son
  /// INMUTABLES: el sobre ya está publicado y el relevo puede haberlo tomado.
  ///
  /// Json como `ConfiguracionLocal.aparienciaJson` y los diffs de la bitácora: se
  /// lee siempre entero y nunca se consulta "cuántos billetes de $10.000 hubo en
  /// agosto". Lo valida el servidor con `validarDesgloseServidor`; nunca se
  /// confía en lo que manda el cliente.
  desgloseCambio  Json?
  totalCambio     Decimal? @db.Decimal(12, 2)

  /// EL SEGUNDO NÚMERO QUE NO SE RECALCULA: `efectivoEsperadoCorte − totalCambio`.
  ///
  /// Es contra éste que se compara el conteo del retiro. Se congela con el corte
  /// por la misma razón que el esperado: si se recalculara al confirmar traería
  /// las ventas que hizo el relevo mientras el saliente contaba.
  ///
  /// Nullable sólo por compatibilidad: los cortes tomados con el orden anterior
  /// —cambio elegido al final— no lo tienen, y se confirman por el camino viejo.
  /// Ver `calcularCierreDesdeConteo`.
  efectivoRetiradoEsperado Decimal? @db.Decimal(12, 2)

  /// El conteo del RETIRO, cargado al confirmar. Es la única pila que se cuenta
  /// después del corte: el cambio ya se contó antes y no está en el montón.
  desgloseRetiroContado Json?
  totalRetiroContado    Decimal? @db.Decimal(12, 2)

  /// TOTAL EQUIVALENTE DEL CAJÓN: `totalRetiroContado + totalCambio`.
  ///
  /// No cambia de significado respecto de la versión anterior —sigue siendo todo
  /// el efectivo que había en el cajón al momento del corte— y por eso conserva
  /// el nombre. Es el número que se copia a `ArqueoCaja.efectivoContado` y a
  /// `Turno.montoRealEfectivo`, para que ningún reporte histórico cambie de
  /// semántica. Con el orden nuevo se DERIVA en vez de contarse de una sola vez.
  desgloseContado Json?
  totalContado    Decimal? @db.Decimal(12, 2)

  /// Lo que efectivamente salió del cajón. Con el orden nuevo es igual a
  /// `totalRetiroContado`; con el anterior era `contado − cambio`. El mismo
  /// número por los dos caminos.
  retiroFinal     Decimal? @db.Decimal(12, 2)

  /// `totalRetiroContado − efectivoRetiradoEsperado`. Se persiste en vez de
  /// derivarse en cada lectura: es el hallazgo del arqueo, y un número que se
  /// recalcula es un número que puede cambiar de valor con el tiempo.
  diferencia      Decimal? @db.Decimal(12, 2)

  observacion     String?

  /// Misma clave que el ArqueoCaja FINAL: `cierre-<turnoId>`. Que sea la misma
  /// es deliberado — el cierre clásico y el cierre con relevo compiten por la
  /// @@unique([turnoId, idempotencyKey]) de ArqueoCaja, así que nunca pueden
  /// generar dos cortes finales sobre el mismo turno.
  ///
  /// No lleva @unique acá, y no hace falta: la clave se deriva del turnoId, así
  /// que el índice parcial de arriba ya impide dos cortes vigentes con la misma
  /// clave. Un @unique global habría quemado la clave de un turno cuyo corte se
  /// canceló, con el mismo efecto que quemar el turnoId. La garantía dura contra
  /// el doble arqueo FINAL está donde tiene que estar: en ArqueoCaja.
  idempotencyKey String

  /// Plazo de referencia. Vencer NO libera nada: ver EstadoCierrePreparacion.
  venceEn      DateTime
  confirmadoEn DateTime?
  /// ArqueoCaja FINAL que produjo la confirmación. @unique: un arqueo no puede
  /// pertenecer a dos cortes.
  arqueoFinalId Int? @unique

  canceladoEn           DateTime?
  canceladoPorUsuarioId Int?
  motivoCancelacion     String?

  /// La resolución CERRADO_SIN_CONTEO: cuándo, quién y por qué. Los tres van
  /// juntos, igual que los de la cancelación de arriba: una resolución sin autor
  /// ni motivo es indistinguible dentro de un mes de un error de datos. Son
  /// columnas propias y no se reusan las de cancelar porque son hechos
  /// distintos: cancelar devuelve el turno a operar; esto lo cierra.
  cerradoSinConteoEn           DateTime?
  cerradoSinConteoPorUsuarioId Int?
  motivoCierreSinConteo        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turno           Turno            @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local           Local            @relation(fields: [localId], references: [id])
  cambioPendiente CambioPendiente?

  @@index([turnoId])
  @@index([localId, estado])
  @@index([grupoId])
  @@index([venceEn])
}

/// El CORTE CONGELADO de un RETIRO DE RECAUDACIÓN.
///
/// EN QUÉ SE PARECE AL CIERRE Y EN QUÉ NO
///
/// Se parece en lo técnico: congela el efectivo esperado y la frontera de qué
/// ventas y movimientos entran, se accede por token, y se confirma en una
/// transacción contra el número congelado.
///
/// NO se parece en lo semántico, y por eso es una tabla aparte en vez de un
/// estado de CierrePreparacion: un retiro NO cierra el turno, NO lo libera y NO
/// publica ningún sobre de cambio. La caja sigue vendiendo con el cambio que se
/// separó, y las ventas posteriores se acumulan encima de él. Meter las dos
/// cosas en la misma tabla habría obligado a que cada consulta del cierre
/// recordara excluir los retiros, y basta una que se olvide para cerrar un turno
/// con los datos de un retiro parcial.
model RetiroPreparacion {
  id Int @id @default(autoincrement())

  /// Llave de acceso a la pantalla de conteo. Misma decisión que en el cierre: el
  /// operador vive en una cookie del NAVEGADOR, no de la pestaña, así que la
  /// pantalla no puede depender de él. La autoría es la grabada acá al cortar.
  token String @unique

  /// ÍNDICE PARCIAL QUE VIVE SOLO EN SQL — no se puede declarar acá.
  ///
  ///   CREATE UNIQUE INDEX "RetiroPreparacion_turno_vigente_key"
  ///       ON "RetiroPreparacion" ("turnoId")
  ///       WHERE "estado" = 'PREPARANDO';
  ///
  /// "Un retiro EN PREPARACIÓN por turno", no "un retiro por turno": una caja
  /// hace varios retiros a lo largo del día y todos conviven. Sólo se excluyen
  /// los que están a medio contar. Mismo patrón que
  /// "CierrePreparacion_turno_vigente_key". Vive en la migración
  /// 20260805120000_retiro_preparacion.
  turnoId Int
  localId Int

  iniciadoPorUsuarioId  Int
  iniciadoPorOperadorId Int?
  /// Instante exacto del corte. Es el `periodoHasta` del ArqueoCaja PARCIAL.
  corteEn               DateTime

  estado EstadoRetiroPreparacion @default(PREPARANDO)

  /// EL NÚMERO QUE NO SE RECALCULA. Efectivo esperado al instante del corte, con
  /// la fórmula única de lib/caja/efectivoEsperado.js.
  efectivoEsperadoCorte Decimal @db.Decimal(12, 2)

  /// FRONTERA POR ID, NO POR TIMESTAMP. Misma razón que en el cierre: dos filas
  /// del mismo milisegundo son indistinguibles por fecha. Int planos a propósito:
  /// una FK impediría borrar una venta vieja por haber sido la última antes de un
  /// corte.
  ultimaVentaId      Int?
  ultimoMovimientoId Int?

  /// EL CAMBIO SEPARADO ANTES DEL CORTE. Inmutable desde que se toma el corte.
  /// A diferencia del cierre, no genera ningún CambioPendiente: esta plata no
  /// cambia de manos, se queda en el mismo cajón del mismo turno.
  desgloseCambio Json
  totalCambio    Decimal @db.Decimal(12, 2)

  /// `efectivoEsperadoCorte − totalCambio`, congelado. Es contra este número que
  /// se compara el conteo.
  efectivoRetiradoEsperado Decimal @db.Decimal(12, 2)

  /// El conteo del retiro, cargado al confirmar. La única pila que se cuenta
  /// después del corte.
  desgloseRetiroContado Json?
  totalRetiroContado    Decimal? @db.Decimal(12, 2)

  /// `totalRetiroContado + totalCambio`. Es el total equivalente del cajón, y es
  /// el que se copia a `ArqueoCaja.efectivoContado` para no cambiarle el
  /// significado histórico a esa columna.
  totalCajonDerivado Decimal? @db.Decimal(12, 2)

  /// `totalRetiroContado − efectivoRetiradoEsperado`.
  diferencia  Decimal? @db.Decimal(12, 2)
  observacion String?

  /// Clave de idempotencia. A diferencia del cierre NO se deriva del turnoId —una
  /// caja hace varios retiros por jornada y todos son legítimos—, así que la
  /// genera el corte y se conserva hasta la confirmación. Es la que termina en
  /// `ArqueoCaja.idempotencyKey`, donde la @@unique([turnoId, idempotencyKey])
  /// impide que una confirmación repetida duplique el descuento.
  idempotencyKey String

  confirmadoEn DateTime?
  /// ArqueoCaja PARCIAL que produjo la confirmación. @unique: un arqueo no puede
  /// pertenecer a dos preparaciones.
  arqueoCajaId Int? @unique

  canceladoEn           DateTime?
  canceladoPorUsuarioId Int?
  motivoCancelacion     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turno Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local Local      @relation(fields: [localId], references: [id])
  arqueo ArqueoCaja? @relation("retiroDePreparacion", fields: [arqueoCajaId], references: [id])

  @@index([turnoId])
  @@index([localId, estado])
  @@index([corteEn])
}

/// El CAMBIO físico que quedó en el local esperando al próximo operador.
///
/// Es la ÚNICA fuente de verdad del traspaso. Los campos viejos de Turno
/// (`fondoSugeridoApertura`, `fondoOrigenTurnoId` y compañía) quedan intactos por
/// compatibilidad histórica pero NO se escriben: aquella cadena era automática
/// —adivinaba qué cierre correspondía a qué cajón— y por eso se desactivó. Acá el
/// operador ELIGE de una lista qué sobre de cambio está tomando.
model CambioPendiente {
  id      Int @id @default(autoincrement())
  localId Int
  grupoId Int

  /// Un corte deja a lo sumo un sobre de cambio.
  cierrePreparacionId Int @unique
  /// Y un turno lo deja una sola vez.
  /// UN SOBRE VIGENTE POR TURNO, no uno solo para siempre.
  ///
  /// ÍNDICE PARCIAL QUE VIVE SOLO EN SQL:
  ///
  ///   CREATE UNIQUE INDEX "CambioPendiente_turnoOrigen_vigente_key"
  ///       ON "CambioPendiente" ("turnoOrigenId")
  ///       WHERE "estado" <> 'CANCELADO';
  ///
  /// Era un @unique común hasta que el sobre pasó a publicarse AL CORTAR. Con
  /// esa unicidad total, un turno que tomaba el corte, lo cancelaba y volvía a
  /// cortar chocaba contra el sobre cancelado del intento anterior y quedaba
  /// imposible de cerrar. Reproducido en la integración: el turno se trababa
  /// para siempre después de una cancelación legítima.
  ///
  /// Borrar el sobre cancelado en vez de excluirlo habría perdido la evidencia
  /// de que un cambio se publicó y se retiró de circulación.
  turnoOrigenId       Int
  operadorOrigenId    Int?
  dejadoEn            DateTime @default(now())

  /// Lo que el cierre decidió dejar. Calculado por el servidor desde `desglose`.
  total       Decimal @db.Decimal(12, 2)
  desglose    Json
  observacion String?

  estado EstadoCambioPendiente @default(DISPONIBLE)

  reservadoPorUsuarioId  Int?
  reservadoPorOperadorId Int?
  reservadoEn            DateTime?
  /// La reserva SÍ vence de verdad y vuelve a DISPONIBLE. Es lo contrario del
  /// vencimiento del cierre, y la diferencia es material: una reserva
  /// abandonada no movió plata —el sobre sigue físicamente en el local—, así
  /// que liberarla no pierde nada. Un corte vencido, en cambio, ya congeló un
  /// turno: liberarlo sí perdería el cierre.
  reservaVenceEn         DateTime?

  /// LA GARANTÍA DURA CONTRA EL DOBLE CONSUMO. @unique: dos turnos no pueden
  /// tomar el mismo sobre aunque fallen todas las validaciones de la aplicación.
  turnoDestinoId Int? @unique

  recibidoPorUsuarioId  Int?
  recibidoPorOperadorId Int?
  recibidoEn            DateTime?
  /// Lo que el operador entrante contó de verdad. `Turno.montoInicial` toma
  /// SIEMPRE este número, no `total`: si el sistema impusiera lo esperado, una
  /// diferencia de recepción quedaría escondida y reaparecería como faltante al
  /// cerrar, culpando al cajero equivocado.
  totalRecibido    Decimal? @db.Decimal(12, 2)
  desgloseRecibido Json?
  /// recibido − esperado. Positiva = sobrante, negativa = faltante.
  diferencia       Decimal? @db.Decimal(12, 2)
  motivoDiferencia String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  local             Local             @relation(fields: [localId], references: [id])
  cierrePreparacion CierrePreparacion @relation(fields: [cierrePreparacionId], references: [id], onDelete: Cascade)
  turnoOrigen       Turno             @relation("cambioTurnoOrigen", fields: [turnoOrigenId], references: [id], onDelete: Cascade)
  turnoDestino      Turno?            @relation("cambioTurnoDestino", fields: [turnoDestinoId], references: [id])

  @@index([localId, estado])
  @@index([grupoId])
  @@index([reservaVenceEn])
  /// El único que reemplaza al @unique que tenía `turnoOrigenId`. La unicidad
  /// real —uno VIGENTE por turno— vive en el índice parcial de la migración.
  @@index([turnoOrigenId])
}

model CajaMovimiento {
  id        Int      @id @default(autoincrement())
  turnoId   Int
  usuarioId Int
  tipo      String   // INGRESO | RETIRO
  /// Ampliado de (10,2) a (12,2) para igualar al resto del circuito.
  ///
  /// Era el ÚNICO campo monetario de caja en (10,2): Turno y ArqueoCaja usan
  /// (12,2). El retiro automático copia acá un importe que nace en un campo
  /// (12,2), así que un valor válido en el origen podía no entrar en el destino
  /// y hacer fallar la transacción entera — convirtiendo un retiro legítimo en
  /// un error. Ensanchar un `numeric` en Postgres no reescribe la tabla ni
  /// pierde datos.
  monto     Decimal  @db.Decimal(12, 2)
  motivo    String?
  createdAt DateTime @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  /// Inverso 1:1 del retiro que lo originó. Sin lista: un movimiento pertenece
  /// a lo sumo a UN retiro.
  arqueoRetiro ArqueoCaja? @relation("retiroDeArqueo")
  /// Inverso 1:1 del pago a proveedor en efectivo que lo originó. El vínculo es
  /// `PagoProveedor.cajaMovimientoId`, con UNIQUE: el motivo del movimiento es
  /// texto para un humano y nunca decide de qué pago es.
  pagoProveedor PagoProveedor?
  /// Inverso 1:1 del pago de un gasto en efectivo que lo originó, por
  /// `PagoGasto.cajaMovimientoId` con UNIQUE. Misma regla: el motivo no decide.
  pagoGasto PagoGasto?
  /// Qué pago lo tiene, de los dos tipos. Es lo que impide que sea de un
  /// `PagoProveedor` y de un `PagoGasto` a la vez: ver `CajaMovimientoDePago`.
  dePago CajaMovimientoDePago?
  /// Las verificaciones de Tesorería que cubrieron esta entrega (a lo sumo una vigente).
  verificacionesEntrega VerificacionEfectivoEntrega[]

  @@index([turnoId])
}

// PUNTOS DE FIDELIDAD
// ---------------------------------------------------------------------------

model PuntosConfigLocal {
  id              Int      @id @default(autoincrement())
  grupoId         Int
  localId         Int      @unique
  activo          Boolean  @default(false)
  reglasJson      Json? // { "puntosPorPeso": 0.01 }
  redencionJson   Json? // { "pesoPorPunto": 10 }
  exclusionesJson Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id])

  @@index([grupoId])
  @@index([localId])
}

model ClientePuntoMovimiento {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  clienteId Int
  direccion String // "CREDITO" | "DEBITO"
  tipo      String // "ACREDITACION" | "CANJE" | "AJUSTE" | "EXPIRACION"
  puntos    Int
  ventaId   Int?
  // Corrección de ventas (Fase B): 0 = movimiento original; >0 = id de
  // VentaCorreccion. Habilita ajustes de puntos por corrección (delta / traslado
  // por cambio de cliente) sin romper la idempotencia del alta (correccionId=0).
  correccionId Int   @default(0)
  userId    Int?
  nota      String?
  createdAt DateTime @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  venta   Venta?   @relation(fields: [ventaId], references: [id])
  usuario Usuario? @relation(fields: [userId], references: [id])
  local   Local    @relation(fields: [localId], references: [id])

  @@unique([ventaId, tipo, correccionId])
  @@index([grupoId, localId, clienteId])
  @@index([localId])
  @@index([createdAt])
}

// CONTADOR DE VENTAS POR LOCAL (thread-safe)
// ---------------------------------------------------------------------------

model PosVentaCounter {
  id           Int      @id @default(autoincrement())
  grupoId      Int
  localId      Int      @unique
  ultimoNumero Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id])
  grupo Grupo @relation(fields: [grupoId], references: [id])

  @@index([localId])
  @@index([grupoId])
}

// VÍNCULOS DE INTEGRACIÓN: UNA PERSONA AUTORIZA A UNA APLICACIÓN EXTERNA
// ---------------------------------------------------------------------------
//
// Azul Chat consulta al ERP EN NOMBRE de una persona. No alcanza con que la
// aplicación esté autenticada ni con que nombre un `usuarioId`: la persona tuvo
// que autorizarla antes, desde su propia sesión del ERP. Esta tabla es esa
// autorización. Ver DEC-0013 y lib/integraciones/vinculos/.
//
// El vínculo NO da permisos. Cada consulta relee el usuario, su rol y su
// alcance; un vínculo activo de alguien que perdió `reportes.ver` no le deja
// ver ventas.
//
// Al autorizar, el ERP genera un CÓDIGO DE CANJE al azar, se lo muestra una sola
// vez a la persona para que lo pegue en Azul Chat, y guarda solo su SHA-256 en
// `codigoHash`. Desde la migración 20261006150000_delegacion_integracion el
// código NO viaja en las consultas: vale 10 minutos y UNA vez, para canjearlo
// por un token de delegación (ver DelegacionIntegracion). Ni el código, ni
// secretos, ni JWT, ni cookies se guardan acá.
//
// No se borra ni se edita: se REVOCA, una vez, y queda la historia. Lo exigen
// dos CHECK y un trigger que viven solo en SQL (migración
// 20261006120000_vinculo_integracion), igual que el índice único PARCIAL "un
// solo vínculo activo por usuario y aplicación". Revocarlo invalida su
// delegación: la delegación no tiene estado propio, vale mientras su vínculo
// esté vigente.
enum AplicacionIntegracion {
  AZUL_CHAT
}

model VinculoIntegracion {
  id            Int                   @id @default(autoincrement())
  usuarioId     Int
  aplicacion    AplicacionIntegracion
  /// SHA-256 (hex) del código que se le mostró a la persona. El código no se guarda.
  codigoHash    String                @unique
  autorizadoEn  DateTime              @default(now())
  /// NULL = vigente. Se escribe una sola vez.
  revocadoEn    DateTime?
  /// Quién revocó: la persona misma, o quien hoy puede darla de baja.
  revocadoPorId Int?

  usuario     Usuario  @relation("vinculo_integracion_del_usuario", fields: [usuarioId], references: [id], onDelete: Restrict)
  revocadoPor Usuario? @relation("vinculo_integracion_revocado_por", fields: [revocadoPorId], references: [id], onDelete: Restrict)
  delegacion  DelegacionIntegracion?

  @@index([usuarioId, aplicacion])
  @@index([revocadoPorId])
}

// DELEGACIÓN: EL CANJE DEL CÓDIGO POR UNA CREDENCIAL DE MÁQUINA
// ---------------------------------------------------------------------------
//
// El código de canje de un vínculo es una credencial HUMANA: la persona lo ve y
// lo copia. No sirve para consultar. Azul Chat lo canjea UNA vez, dentro de los
// 10 minutos de autorizado, por un TOKEN DE DELEGACIÓN que solo conoce el
// backend de Azul Chat. Esta fila es ese canje; el ERP guarda solo el SHA-256
// del token. Ver DEC-0013 y lib/integraciones/vinculos/canje.js.
//
// Lo que la base garantiza, en SQL (migración 20261006150000_delegacion_integracion):
//   · `vinculoId` único: un código se canjea una sola vez, también con dos
//     canjes simultáneos — el segundo choca contra el índice;
//   · un trigger BEFORE INSERT que bloquea el vínculo (FOR SHARE) y rechaza el
//     canje de un vínculo revocado o autorizado hace más de 10 minutos, y pone
//     `canjeadoEn` con el reloj de la base;
//   · un trigger que impide editar o borrar una delegación;
//   · `tokenHash` único y con forma de SHA-256 en hex: el token en claro no entra.
//
// La delegación NO tiene revocación propia: vale mientras su vínculo esté
// vigente. Revocar o volver a autorizar el vínculo la invalida en la próxima
// consulta, sin que Azul Chat tenga que hacer nada.
model DelegacionIntegracion {
  id         Int                @id @default(autoincrement())
  vinculoId  Int                @unique
  /// SHA-256 (hex) del token de delegación. El token no se guarda.
  tokenHash  String             @unique
  /// Cuándo se canjeó el código. Lo pone el trigger con el reloj de la base.
  canjeadoEn DateTime           @default(now())

  vinculo VinculoIntegracion @relation(fields: [vinculoId], references: [id], onDelete: Restrict)
}

// COBROS OFFLINE: LA EVIDENCIA DE UN COBRO DECLARADO POR EL POS
// ---------------------------------------------------------------------------
//
// Un cobro hecho sin conexión vive en el navegador hasta que vuelve la red. Al
// volver, el POS lo REGISTRA acá antes de intentar la venta: así el servidor
// sabe que existe y conserva su contenido aunque después se pierda el
// almacenamiento local. Registrarlo NO es una venta: no mueve stock, caja,
// libros ni Finanzas. La venta la crea, o no, `/api/pos-ventas/crear` con sus
// reglas de siempre (PIN, caja propia, caja operativa, día — DEC-0012); cuando
// la crea, este registro pasa a SINCRONIZADA en la misma transacción.
//
// SIN CLAVES FORÁNEAS, a propósito: una FK hacia Venta, Local, Usuario u
// OperadorLocal toma un candado sobre esas tablas al crearse —chocaría con
// cada venta del POS mientras espera— y obligaría a tocar modelos calientes.
// Varios de estos ids son DECLARADOS por el navegador y pueden no existir. La
// integridad que importa la dan los dos únicos (`clientTxnId`, `ventaId`), el
// candado del local que comparte con `crear` y el código. Mismo criterio que
// AuditoriaBitacora. Ver lib/pos-ventas/cobroOfflineServidor.js.
enum EstadoCobroOffline {
  /// Registrado, con turno de su local: se puede intentar la venta.
  PENDIENTE
  /// Registrado, pero algo impide sincronizarlo solo (sin turno, turno ajeno,
  /// id usado por una venta de otra caja). Lo mira una persona. Igual puede
  /// sincronizarse si `crear` lo logra con sus reglas.
  REQUIERE_REVISION
  /// La venta existe y este registro apunta a ella. Terminal.
  SINCRONIZADA
  /// Una persona decidió que no se sincroniza, con motivo. Terminal: bloquea
  /// cualquier venta posterior con ese id.
  DESCARTADA
}

model CobroOffline {
  id          Int    @id @default(autoincrement())
  /// El `clientVentaId` de la cola: el mismo id con que se intenta la venta.
  clientTxnId String @unique
  /// Del ámbito de la sesión que registra, nunca del cuerpo del pedido.
  localId     Int
  grupoId     Int

  // Quién lo registró: verificado por el servidor.
  registradoPorUsuarioId  Int
  /// El PIN activo validado en el local al registrar. Registrar no lo exige.
  registradoPorOperadorId Int?

  // Lo que declara la cola: evidencia, no autorización.
  cuentaDeclaradaId    Int?
  operadorDeclaradoId  Int?
  /// El operador que firma el voucher de la cola, si valida en este local. Se
  /// guarda el resultado de verificarlo; el voucher en sí NO se guarda.
  operadorVerificadoId Int?
  /// Solo si el turno declarado existe y es de este local. El declarado crudo
  /// queda en `payload`.
  turnoId              Int?

  // Tiempo. Ninguna hora del dispositivo es fecha contable.
  cobradoEnDispositivo        DateTime?
  relojDispositivoAlRegistrar DateTime?
  registradoEn                DateTime  @default(now())
  ultimoRegistroEn            DateTime  @default(now())

  // Contenido: el cobro de la cola, saneado por lista blanca.
  totalDeclarado     Decimal @db.Decimal(12, 2)
  formaPagoDeclarada String
  payload            Json
  /// SHA-256 de la forma canónica de `payload`.
  payloadHash        String

  estado               EstadoCobroOffline @default(PENDIENTE)
  intentos             Int                @default(0)
  ultimoIntentoEn      DateTime?
  ultimoRechazoStatus  Int?
  ultimoRechazoCodigo  String?
  ultimoRechazoMensaje String?
  /// Por qué entró en revisión: SIN_TURNO | TURNO_AJENO | ID_EN_OTRA_VENTA.
  revisionMotivo       String?

  ventaId               Int?      @unique
  sincronizadaEn        DateTime?
  resueltoPorUsuarioId  Int?
  resueltoPorOperadorId Int?
  resueltoEn            DateTime?
  motivoResolucion      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([localId, estado])
  @@index([turnoId])
  @@index([registradoEn])
}

// ---------------------------------------------------------------------------
// COMPRAS / PEDIDOS A PROVEEDOR
// ---------------------------------------------------------------------------

model PedidoProveedor {
  id              Int                    @id @default(autoincrement())
  grupoId         Int
  depositoId      Int
  // Ubicación que CREÓ el pedido (aislamiento por ubicación). Se llena con el
  // localId del contexto al crear; puede ser un local o el depósito. `depositoId`
  // sigue siendo "dónde entra el stock". Backfill: creadoEnLocalId ← depositoId.
  creadoEnLocalId Int?
  proveedorId     Int
  estado          EstadoPedidoProveedor  @default(BORRADOR)
  /// NACIÓ DE UNA FACTURA, sin que nadie hubiera pedido nada.
  ///
  /// Llega mercadería de un proveedor al que no se le encargó: se elige el
  /// proveedor, se le saca una foto al papel y el pedido se arma con lo que el
  /// papel dice. Es un hecho del pedido y por eso es una columna y no algo que
  /// se deduzca de "no tiene fecha de enviado" o de "se creó el mismo día" —
  /// las dos cosas son ciertas también en pedidos normales.
  ///
  /// Lo que cambia cuando está en true, y está decidido: la tarjeta NO muestra
  /// "Pediste" —no hubo pedido, y un "Pediste 0" o un "sobra 8" serían falsos—,
  /// no existe el bloque de "productos que el papel no trajo" porque todo sale
  /// del papel, y la hoja de cierre no pregunta por ellos.
  nacidoDeFactura Boolean                @default(false)
  /// SE RECIBIÓ CON UN PAPEL QUE NO CERRABA (Emanuel, 2026-10-10: "siempre se
  /// tiene que poder recibir"). Entró el stock de lo vinculado y NINGÚN costo
  /// se tocó: queda para la segunda revisión. `motivoSinCerrar` dice por qué,
  /// en castellano —qué comprobante y por cuánto no cerraba—.
  recibidoSinCerrar Boolean              @default(false)
  motivoSinCerrar   String?
  notas           String?
  fechaConfirmado DateTime?
  fechaEnviado    DateTime?
  fechaRecibido   DateTime?
  fechaAnulado    DateTime?
  totalFactura    Decimal?               @db.Decimal(12, 2)
  totalReal       Decimal?               @db.Decimal(12, 2)
  nroFactura      String?
  fechaFactura    DateTime?
  creadoPorId     Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  deposito   Local     @relation(fields: [depositoId], references: [id])
  proveedor  Proveedor @relation(fields: [proveedorId], references: [id])
  detalles   PedidoProveedorDetalle[]
  /// La obligación con el proveedor que nació de esta compra. A lo sumo UNA:
  /// el UNIQUE está en `CuentaPorPagarProveedor.pedidoProveedorId`.
  cuentaPorPagar CuentaPorPagarProveedor?

  @@index([grupoId])
  @@index([depositoId])
  @@index([creadoEnLocalId])
  @@index([proveedorId])
  @@index([estado])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// PAGOS A PROVEEDORES (Finanzas)
// ---------------------------------------------------------------------------

/// CON QUÉ SE LE PAGÓ AL PROVEEDOR.
///
/// NO es `MedioPago` ni los medios de cobro del POS: aquéllos dicen cómo ENTRA
/// la plata de un cliente —débito, crédito, fiado— y éste dice cómo SALE hacia
/// un proveedor. Compartir el enum habría ofrecido "Fiado" para pagarle a Arcor.
enum MedioPagoProveedor {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
  OTRO
}

/// LO QUE SE LE DEBE AL PROVEEDOR POR UNA COMPRA.
///
/// Nace de una compra —`PedidoProveedor`— por UNA sola puerta,
/// `crearCuentaPorPagarDesdeCompra` (lib/finanzas/pagosProveedoresServer.js).
/// Finanzas no la origina a mano: no hay endpoint para crear deuda.
///
/// ── LO QUE NO SE GUARDA ─────────────────────────────────────────────────
///
/// Ni "pagado", ni "saldo", ni "PENDIENTE / PARCIAL / PAGADA". Los tres se
/// derivan de `total` y de la suma de `pagos` con `estadoDeCuenta`
/// (lib/finanzas/pagosProveedores.js). Una columna de saldo sería una segunda
/// verdad que un pago cargado por otro camino dejaría vieja sin que nada falle.
///
/// ── DOS FECHAS, Y NO SON LA MISMA ───────────────────────────────────────
///
/// `vencimientoProveedor` es la condición que dio el PROVEEDOR; `fechaPrevistaPago`
/// es una decisión NUESTRA y se cambia desde Finanzas. Las dos pueden faltar:
/// null es "sin fecha / pasa a cobrar", no un día por defecto. Son `DATE` y no
/// `TIMESTAMP`: un vencimiento es un día, y con hora el mismo día se leería
/// distinto según la zona del proceso.
model CuentaPorPagarProveedor {
  id                   Int       @id @default(autoincrement())
  grupoId              Int
  pedidoProveedorId    Int       @unique
  proveedorId          Int
  /// A QUIÉN PERTENECE LA DEUDA. Es también la única ubicación que la paga: cada
  /// pago sale de ella (`PagoProveedor.localOrigenId` igual a ésta) y lo
  /// registra quien la opera. Lo impone `registrarPagoProveedor`.
  localGastoId         Int
  total                Decimal   @db.Decimal(12, 2)
  vencimientoProveedor DateTime? @db.Date
  fechaPrevistaPago    DateTime? @db.Date
  creadoPorId          Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  pedido     PedidoProveedor @relation(fields: [pedidoProveedorId], references: [id])
  proveedor  Proveedor       @relation(fields: [proveedorId], references: [id])
  localGasto Local           @relation("cuenta_gasto", fields: [localGastoId], references: [id])
  creadoPor  Usuario         @relation("cuenta_creada_por", fields: [creadoPorId], references: [id])
  pagos      PagoProveedor[]

  @@index([grupoId])
  @@index([localGastoId])
  @@index([proveedorId])
}

/// UN PAGO A UN PROVEEDOR: el hecho financiero.
///
/// No es un `CajaMovimiento`. Aquél es plata física saliendo de un cajón; éste
/// es la deuda bajando. Solo el EFECTIVO tiene las dos cosas, y entonces el pago
/// apunta a su movimiento por `cajaMovimientoId` —UNIQUE, un movimiento es de a
/// lo sumo un pago— y al turno de cuyo cajón salió. Transferencia, Mercado Pago
/// y Otro no tocan la caja y dejan las dos columnas en null. La migración lo
/// exige con un CHECK: la base no acepta un efectivo sin movimiento ni un
/// movimiento en un pago que no es efectivo.
model PagoProveedor {
  id               Int                @id @default(autoincrement())
  cuentaId         Int
  monto            Decimal            @db.Decimal(12, 2)
  /// El día del pago. En efectivo es el instante en que salió del cajón.
  fecha            DateTime           @default(now())
  medio            MedioPagoProveedor
  /// DE DÓNDE SALIÓ EL DINERO. Siempre la ubicación de la deuda
  /// (`CuentaPorPagarProveedor.localGastoId`): ninguna ubicación paga deudas de otra.
  localOrigenId    Int
  usuarioId        Int
  turnoId          Int?
  cajaMovimientoId Int?               @unique
  nota             String?
  /// Clave de idempotencia del INTENTO de pago, que genera el cliente al abrir
  /// el formulario y conserva en cada reintento. Misma regla que el retiro de
  /// Caja: un envío que mueve plata la EXIGE —por eso no es nullable; en
  /// Postgres dos NULL no chocan en un UNIQUE y el pago sin clave quedaría sin
  /// protección— y el mismo intento repetido devuelve el pago ya registrado en
  /// vez de crear otro, con su movimiento de caja si era efectivo.
  idempotencyKey   String
  createdAt        DateTime           @default(now())

  cuenta         CuentaPorPagarProveedor @relation(fields: [cuentaId], references: [id])
  localOrigen    Local                   @relation("pago_origen", fields: [localOrigenId], references: [id])
  usuario        Usuario                 @relation("pago_registrado_por", fields: [usuarioId], references: [id])
  turno          Turno?                  @relation(fields: [turnoId], references: [id])
  cajaMovimiento CajaMovimiento?         @relation(fields: [cajaMovimientoId], references: [id])
  movimientoExclusivo CajaMovimientoDePago?

  /// Por cuenta, como `ArqueoCaja` la tiene por turno: la clave identifica un
  /// intento sobre ESTA deuda. Reemplaza al índice simple de `cuentaId`, que
  /// queda cubierto por ser la primera columna.
  @@unique([cuentaId, idempotencyKey])
  @@index([localOrigenId])
  @@index([turnoId])
}

// ---------------------------------------------------------------------------
// GASTOS (Finanzas)
// ---------------------------------------------------------------------------
//
// Un GASTO es lo que una ubicación consumió y no es mercadería: la luz, el
// alquiler, un sueldo, la reparación de una heladera. No es una compra —la
// compra mueve stock y su deuda es `CuentaPorPagarProveedor`— y no es un
// RETIRO de caja: un retiro es plata saliendo de un cajón, que puede ser el
// pago de un gasto o no. Tampoco es costo de mercadería: el Libro de Costos no
// lo registra ni lo tiene que registrar.
//
// Son DOS hechos, en dos tablas: el gasto —qué se consumió, de qué ubicación,
// a qué día corresponde, cuánto— y sus pagos —cuándo y cómo salió el dinero—.
// Un gasto puede no tener ningún pago todavía. El saldo y el estado no se
// guardan: se derivan con `estadoDeCuenta` (lib/finanzas/pagosProveedores.js),
// la misma aritmética de las deudas con proveedores.
//
// Las dos únicas puertas que escriben están en `lib/finanzas/gastosServer.js`.

/// LAS CATEGORÍAS DE UN GASTO. Un catálogo, no un enum: se edita sin migración.
///
/// Global, como `Categoria` de productos —el catálogo equivalente del repo—: no
/// cuelga de un grupo. Las siete iniciales entran con la migración que crea la
/// tabla; `orden` es el orden en que se ofrecen, con "Otros" al final.
model CategoriaGasto {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gastos Gasto[]
}

/// CON QUÉ SE PAGÓ UN GASTO.
///
/// Los mismos cuatro valores que `MedioPagoProveedor`, pero un tipo propio: un
/// gasto no es un pago a un proveedor de mercadería y los dos pueden dejar de
/// coincidir. Solo EFECTIVO toca la caja. Los demás registran el medio y nada
/// más: todavía no existen cuentas financieras de origen (banco, Mercado Pago).
enum MedioPagoGasto {
  EFECTIVO
  TRANSFERENCIA
  MERCADO_PAGO
  OTRO
}

/// UN GASTO DE UNA UBICACIÓN: el hecho económico.
///
/// ── A QUIÉN PERTENECE ────────────────────────────────────────────────────
///
/// `localId` es la ubicación que consumió el gasto, y es también la ÚNICA que
/// lo paga: cada pago sale de ella (`PagoGasto.localOrigenId` igual a ésta) y
/// lo registra quien la opera. Lo imponen `crearGasto` y `registrarPagoGasto`.
/// El depósito no paga gastos de un local, ni un local los del depósito.
///
/// ── TRES FECHAS, Y NINGUNA ES LA DEL PAGO ────────────────────────────────
///
/// `fecha` es el día al que el gasto CORRESPONDE económicamente —la luz de
/// septiembre, cargada en octubre—; `createdAt` es cuándo se registró. El
/// vencimiento es la condición de quien cobra; la fecha prevista, una decisión
/// nuestra. Todas `DATE`: son días, y con hora se leerían distinto según la
/// zona del proceso. Cuándo salió la plata lo dice cada `PagoGasto`.
///
/// ── LO QUE NO SE GUARDA ─────────────────────────────────────────────────
///
/// Ni saldo, ni pagado, ni PENDIENTE / PARCIAL / PAGADO: salen de `total` y la
/// suma de `pagos`. Una columna de saldo sería una segunda verdad.
model Gasto {
  id                Int       @id @default(autoincrement())
  grupoId           Int
  localId           Int
  categoriaId       Int
  concepto          String
  total             Decimal   @db.Decimal(12, 2)
  fecha             DateTime  @db.Date
  /// A quién se le paga, en texto libre: EPEC, el dueño del local, el técnico.
  /// No es un `Proveedor`: aquéllos son de mercadería.
  beneficiario      String?
  comprobanteNumero String?
  comprobanteFecha  DateTime? @db.Date
  vencimiento       DateTime? @db.Date
  fechaPrevistaPago DateTime? @db.Date
  creadoPorId       Int
  /// Clave de idempotencia del INTENTO de alta, que genera el cliente al abrir
  /// el formulario. Obligatoria, por la misma razón que la del pago: un alta
  /// repetida —doble clic, respuesta perdida— con un pago inicial en efectivo
  /// sacaría dos veces la plata del cajón.
  idempotencyKey    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  local     Local          @relation("gasto_del_local", fields: [localId], references: [id])
  categoria CategoriaGasto @relation(fields: [categoriaId], references: [id])
  creadoPor Usuario        @relation("gasto_creado_por", fields: [creadoPorId], references: [id])
  pagos     PagoGasto[]

  /// El mismo intento no crea dos gastos en la misma ubicación.
  @@unique([localId, idempotencyKey])
  @@index([grupoId])
  @@index([categoriaId])
  @@index([localId, fecha])
}

/// UN PAGO DE UN GASTO: el hecho financiero. La forma de `PagoProveedor`.
///
/// Solo el EFECTIVO sale de un cajón: apunta a su `CajaMovimiento` RETIRO por
/// `cajaMovimientoId` —UNIQUE, un movimiento es de a lo sumo un pago— y al
/// turno. Los demás medios dejan las dos columnas en null. Lo exige un CHECK.
///
/// Cuando existan cuentas financieras, la cuenta de ORIGEN del dinero es una
/// columna de ESTA tabla, no del gasto: el gasto no cambia.
model PagoGasto {
  id               Int            @id @default(autoincrement())
  gastoId          Int
  monto            Decimal        @db.Decimal(12, 2)
  /// El día del pago. En efectivo es el instante en que salió del cajón.
  fecha            DateTime       @default(now())
  medio            MedioPagoGasto
  /// DE DÓNDE SALIÓ EL DINERO. Siempre la ubicación del gasto.
  localOrigenId    Int
  usuarioId        Int
  turnoId          Int?
  cajaMovimientoId Int?           @unique
  nota             String?
  /// Clave de idempotencia del INTENTO de pago. Obligatoria: el mismo intento
  /// repetido devuelve el pago ya registrado, con su RETIRO si era efectivo.
  idempotencyKey   String
  createdAt        DateTime       @default(now())

  gasto          Gasto           @relation(fields: [gastoId], references: [id])
  localOrigen    Local           @relation("pago_gasto_origen", fields: [localOrigenId], references: [id])
  usuario        Usuario         @relation("pago_gasto_registrado_por", fields: [usuarioId], references: [id])
  turno          Turno?          @relation(fields: [turnoId], references: [id])
  cajaMovimiento CajaMovimiento? @relation(fields: [cajaMovimientoId], references: [id])
  movimientoExclusivo CajaMovimientoDePago?

  @@unique([gastoId, idempotencyKey])
  @@index([localOrigenId])
  @@index([turnoId])
}

/// UN MOVIMIENTO DE CAJA ES DE A LO SUMO UN PAGO, DE CUALQUIERA DE LOS DOS TIPOS.
///
/// El UNIQUE de `PagoProveedor.cajaMovimientoId` y el de `PagoGasto` impiden
/// dos pagos del MISMO tipo sobre un retiro, pero no uno de cada tipo: son dos
/// índices en dos tablas. Esta tabla es el índice común. Su clave primaria es el
/// movimiento, así que el segundo pago que lo reclame choca contra ella, sea del
/// tipo que sea y en la transacción que sea: dos intentos concurrentes no pueden
/// confirmarse los dos, porque el índice único lo arbitra la base.
///
/// NO SE ESCRIBE DESDE EL CÓDIGO. La llena un trigger AFTER INSERT de los dos
/// pagos —migración 20260929230000_gastos—, y cada fila se va con su pago por
/// `onDelete: Cascade`. Un pago no puede cambiar de movimiento: otro trigger lo
/// rechaza, porque esta fila quedaría apuntando al anterior.
model CajaMovimientoDePago {
  cajaMovimientoId Int  @id
  pagoProveedorId  Int? @unique
  pagoGastoId      Int? @unique

  cajaMovimiento CajaMovimiento @relation(fields: [cajaMovimientoId], references: [id])
  pagoProveedor  PagoProveedor? @relation(fields: [pagoProveedorId], references: [id], onDelete: Cascade)
  pagoGasto      PagoGasto?     @relation(fields: [pagoGastoId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════════════════════════════════════════
// TESORERÍA: LA VERIFICACIÓN DEL EFECTIVO
// ═══════════════════════════════════════════════════════════════════════════
//
// Tesorería verifica ENTREGAS de efectivo —los `CajaMovimiento` RECAUDACION y
// CIERRE de lib/tesoreria/lecturaTesoreria.js— y no toca cajas, ventas ni
// arqueos. Una verificación es un HECHO: lo que se declaró, lo que contó el
// responsable, la diferencia, quién y cuándo. No se edita. Se corrige
// anulándola y haciendo otra; la anulada queda como historia.
//
// La base sostiene las reglas sola —migración 20261004120000_verificacion_efectivo—:
//   · diferencia = verificado − declarado, por CHECK;
//   · declarado = suma de las fotos de sus entregas, por un trigger diferido al
//     commit; y al menos una entrega;
//   · cada foto es la del movimiento AL INSERTARLA: monto, turno, local,
//     operador e instante se comparan contra la fila real, y la clase contra el
//     vínculo estructural (arqueo para RECAUDACION, turno para CIERRE);
//   · una entrega está en a lo sumo UNA verificación VIGENTE: índice único
//     parcial sobre `vigente`, que es copia del padre mantenida por una FK
//     compuesta con ON UPDATE CASCADE, así que no puede divergir;
//   · una verificación no mezcla locales: FK compuesta (verificación, local);
//   · nada se edita salvo la anulación, y nada se borra: triggers.
//
// NO guarda turno comercial, franja ni día comercial: la agrupación es lectura
// derivada y provisoria, y cambiarla no puede invalidar una verificación.

/// Si una verificación cuenta o ya no. ANULADA es final.
enum EstadoVerificacionEfectivo {
  VIGENTE
  ANULADA
}

/// Las dos clases de movimiento que son entregas de efectivo.
enum ClaseEntregaEfectivo {
  RECAUDACION
  CIERRE
}

/// UN ACTO DE VERIFICACIÓN DEL EFECTIVO ENTREGADO.
///
/// `importeDeclarado` es la suma congelada de las entregas que cubre;
/// `importeVerificado` es lo que contó el responsable; `diferencia` es
/// verificado − declarado y la base no acepta otra cosa. Ninguno se edita.
///
/// `vigente` es `estado = VIGENTE`, por CHECK. Existe para que la FK compuesta de
/// las entregas la copie con ON UPDATE CASCADE y el índice parcial de exclusividad
/// pueda mirarla: el hijo no puede tener otra vigencia que su padre.
///
/// Autoría: `verificadaPorUsuarioId` es la cuenta ERP que ejecutó, y
/// `verificadaPorOperadorId` el operador del PIN si lo hubo —evidencia, no
/// autorización (DEC-0012)—; nullable porque hoy ningún flujo lo pide.
///
/// Idempotencia como `Gasto`: única por local.
model VerificacionEfectivo {
  id                       Int                        @id @default(autoincrement())
  localId                  Int
  importeDeclarado         Decimal                    @db.Decimal(12, 2)
  importeVerificado        Decimal                    @db.Decimal(12, 2)
  diferencia               Decimal                    @db.Decimal(12, 2)
  estado                   EstadoVerificacionEfectivo @default(VIGENTE)
  vigente                  Boolean                    @default(true)
  verificadaPorUsuarioId   Int
  verificadaPorOperadorId  Int?
  verificadaEn             DateTime                   @default(now())
  observacion              String?
  idempotencyKey           String
  anuladaEn                DateTime?
  anuladaPorUsuarioId      Int?
  motivoAnulacion          String?
  createdAt                DateTime                   @default(now())
  /// EL TURNO OPERATIVO QUE SE VERIFICÓ, congelado al verificar —migración
  /// 20261004200000_turno_operativo—. Los dos van juntos o ninguno, por CHECK.
  /// NULL = verificación anterior al turno operativo, o de cajas sin turno: no
  /// se le asigna uno después. La FK compuesta con `localId` impide que apunte
  /// al turno de otro local, y un trigger exige que cada entrega sea de una caja
  /// de ESE turno y ESA fecha operativa.
  turnoOperativoId         Int?
  fechaOperativa           DateTime?                  @db.Date

  local          Local   @relation("verificacion_efectivo_del_local", fields: [localId], references: [id], onDelete: Restrict)
  verificadaPor  Usuario @relation("verificacion_efectivo_hecha_por", fields: [verificadaPorUsuarioId], references: [id], onDelete: Restrict)
  anuladaPor     Usuario? @relation("verificacion_efectivo_anulada_por", fields: [anuladaPorUsuarioId], references: [id], onDelete: Restrict)
  turnoOperativo TurnoOperativo? @relation("verificacion_del_turno_operativo", fields: [turnoOperativoId, localId], references: [id, localId], onDelete: Restrict, onUpdate: Restrict)

  entregas         VerificacionEfectivoEntrega[] @relation("entrega_vigencia_del_padre")
  entregasDelLocal VerificacionEfectivoEntrega[] @relation("entrega_local_del_padre")

  @@unique([localId, idempotencyKey])
  /// Destinos de las dos FK compuestas de las entregas.
  @@unique([id, vigente])
  @@unique([id, localId])
  @@index([localId, verificadaEn])
  @@index([turnoOperativoId, fechaOperativa])
}

/// UN TURNO OPERATIVO DEL CATÁLOGO DE UN LOCAL. Nombre, cantidad, orden y
/// ventana los configura cada local. Migración 20261004200000_turno_operativo.
///
/// La VENTANA DE RECONOCIMIENTO ("HH:MM" → "HH:MM", obligatoria en un turno
/// activo, puede cruzar la medianoche) no es la duración del turno ni obliga a
/// cerrar la caja: ubica la ocurrencia y sirve para que la apertura proponga
/// el turno que probablemente se abre. Quien abre confirma o cambia, y la caja
/// guarda el turno FINAL con la fecha operativa de su jornada
/// (`lib/caja/turnoOperativo.js`). Tesorería agrupa y verifica por (local,
/// fecha operativa, turno operativo) de la caja, sin volver a mirar la hora.
///
/// No se borra —una caja o una verificación pueden apuntarlo—: se desactiva, y
/// uno inactivo no se ofrece para abrir.
model TurnoOperativo {
  id        Int      @id @default(autoincrement())
  localId   Int
  nombre    String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  /// Ventana de reconocimiento, "HH:MM". Las dos o ninguna, distintas entre sí,
  /// y las dos si el turno está activo (CHECK); inicio > fin cruza la
  /// medianoche. Se pueden solapar entre turnos.
  horaInicioReconocimiento String?
  horaFinReconocimiento    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade como `ConfiguracionLocal`: es configuración del local. En los
  /// hechos no borra nada —una caja o una verificación que lo apunten frenan el
  /// borrado del local por su propia FK—.
  local          Local                  @relation(fields: [localId], references: [id], onDelete: Cascade)
  cajas          Turno[]                @relation("caja_del_turno_operativo")
  verificaciones VerificacionEfectivo[] @relation("verificacion_del_turno_operativo")

  /// Un nombre por local. Dos turnos con el mismo nombre en un local serían
  /// dos grupos que se leen igual.
  @@unique([localId, nombre])
  /// Destino de las FK compuestas de `Turno` y `VerificacionEfectivo`: la caja
  /// y la verificación solo pueden apuntar a un turno de SU local.
  @@unique([id, localId])
  @@index([localId, activo, orden])
}

/// QUÉ ENTREGA CUBRIÓ UNA VERIFICACIÓN, CON LA FOTO DE CÓMO ERA AL VERIFICARLA.
///
/// `cajaMovimientoId` es FK real con RESTRICT: ninguna ruta borra movimientos de
/// caja, y si alguien lo intentara la base lo frena antes de dejar una
/// verificación apuntando a la nada. La FOTO no depende de ese vínculo: si mañana
/// la corrección histórica cambia el monto del movimiento, la foto sigue diciendo
/// lo que se verificó y la diferencia entre los dos se puede detectar.
///
/// Los snapshots son escalares sin FK a propósito: son una foto, no un vínculo
/// vivo.
model VerificacionEfectivoEntrega {
  id                       Int                  @id @default(autoincrement())
  verificacionEfectivoId   Int
  cajaMovimientoId         Int
  vigente                  Boolean              @default(true)
  montoDeclaradoSnapshot   Decimal              @db.Decimal(12, 2)
  localIdSnapshot          Int
  turnoIdSnapshot          Int
  operadorIdSnapshot       Int?
  claseSnapshot            ClaseEntregaEfectivo
  instanteEntregaSnapshot  DateTime

  verificacion        VerificacionEfectivo @relation("entrega_vigencia_del_padre", fields: [verificacionEfectivoId, vigente], references: [id, vigente], onDelete: Restrict, onUpdate: Cascade)
  verificacionDelLocal VerificacionEfectivo @relation("entrega_local_del_padre", fields: [verificacionEfectivoId, localIdSnapshot], references: [id, localId], onDelete: Restrict, onUpdate: Restrict)
  cajaMovimiento      CajaMovimiento       @relation(fields: [cajaMovimientoId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([verificacionEfectivoId, cajaMovimientoId])
  @@index([cajaMovimientoId])
}

model PedidoProveedorDetalle {
  id               Int        @id @default(autoincrement())
  pedidoId         Int
  productoLocalId  Int
  cantidad         Decimal    @db.Decimal(12, 2)
  unidad           ModoPedido @default(BULTO)
  cantidadRecibida Decimal?   @db.Decimal(12, 2)
  kgRecibidos      Decimal?   @db.Decimal(12, 3)
  /// Cuántas unidades sueltas llegaron, además de los bultos enteros. Solo
  /// tiene sentido en los productos que van por pack: 6 cajas y 5 unidades no
  /// es "6,2 bultos". NULL = no se preguntó, que es distinto de 0.
  unidadesSueltas  Int?
  /// CUÁNTAS UNIDADES DIJO LA HOJA QUE ENTRAN AL STOCK.
  ///
  /// No se deduce de `cantidadRecibida` a propósito: la deducción fue durante
  /// meses un TERCER criterio de escala —además de la tarjeta y de la hoja— y
  /// sobre la hamburguesa del pedido 242 los tres no coincidían. Lo que se ve
  /// es lo que entra, y para que siga siendo cierto después de un refresco el
  /// número tiene que estar acá y no en la memoria del navegador.
  unidadesFisicas  Decimal?   @db.Decimal(12, 3)
  /// Por qué la cantidad recibida no coincide con la pedida. Los MISMOS valores
  /// canónicos que usa la recepción de una transferencia —"Faltante",
  /// "Producto dañado", "Otro"— para que un reporte por motivo no vea dos
  /// vocabularios para lo mismo.
  motivoPrincipal  String?
  /// El texto libre cuando el motivo es "Otro".
  motivoDetalle    String?
  // Costo por unidad de pedido (BULTO/UNIDAD). Alta precisión (6 decimales) para
  // no perder el costo unitario derivado de packs con factor no divisor
  // (ej. 1480/18 = 82,222222). Los TOTALES/montos siguen en 2 decimales; la
  // conversión a centavos ocurre solo al mostrar o al persistir montos finales.
  precioCosto      Decimal?   @db.Decimal(18, 6)
  /// CUÁNTO SUMÓ ESTA LÍNEA A `StockLocal.cantidad` AL RECIBIR, Y EN QUÉ UNIDAD.
  ///
  /// Es el MISMO número que el cierre pasó al `increment` del stock, escrito en
  /// la misma transacción: no se recalcula, ni al guardarlo ni después. Sin él,
  /// saber qué entró obligaba a multiplicar `cantidadRecibida` por el
  /// `factor_pack` de HOY, y un producto que pasó de x12 a x6 reescribía la
  /// historia sin que nada lo avisara.
  ///
  /// La unidad sale de la rama del cierre que decidió qué significa el número
  /// —unidades, kilos o piezas—, no del producto de hoy: el mismo producto
  /// puede haber entrado en piezas al depósito y en kilos a un local.
  ///
  /// Los dos van juntos. NULL en los dos es "no hay dato": una línea recibida
  /// antes de que esto existiera —no se rellena, ERP Azul no lo guardaba— o un
  /// combo, que no mueve stock. Un 0 con su unidad es un hecho: se cerró y no
  /// entró nada. Solo los escribe `recibir/[id]`; después de RECIBIDO no los
  /// toca nadie.
  stockIngresado       Decimal?            @db.Decimal(12, 3)
  stockIngresadoUnidad UnidadFisicaStock?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pedido   PedidoProveedor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto ProductoLocal   @relation(fields: [productoLocalId], references: [id])

  @@index([pedidoId])
  @@index([productoLocalId])
}

// CONFIGURACION POR GRUPO
// ---------------------------------------------------------------------------

model ConfiguracionGrupo {
  id                            Int      @id @default(autoincrement())
  grupoId                       Int      @unique
  allowNegativeStock            Boolean  @default(false)
  requireMotivoAjusteStock      Boolean  @default(false)
  requireMotivoLimitesStock     Boolean  @default(false)
  exigirClienteVentasDeposito   Boolean  @default(false)
  exigirClienteVentasLocal      Boolean  @default(false)
  // NULABLES Y SIN DEFAULT: `null` es "todavía no se configuró", que no es lo
  // mismo que 0 %. Tenían `@default(7)`, así que todo grupo nacía con una
  // comisión que nadie había decidido. Las filas existentes conservan su valor:
  // la migración no las toca.
  comisionDebito                Decimal? @db.Decimal(5, 2)
  comisionCredito               Decimal? @db.Decimal(5, 2)
  comisionMercadopago           Decimal? @db.Decimal(5, 2)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId])
}

// CONFIGURACION DE TICKET POR LOCAL
// ---------------------------------------------------------------------------

model TicketConfig {
  id         Int      @id @default(autoincrement())
  localId    Int      @unique
  configJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@index([localId])
}

// AUDITORIA DE STOCK
// ---------------------------------------------------------------------------

model AuditoriaStock {
  id               Int      @id @default(autoincrement())
  grupoId          Int
  localId          Int
  productoLocalId  Int
  userId           Int
  accion           String
  // Son snapshots DIRECTOS de StockLocal.cantidad (ajustar/route.js), así que
  // siguen su ESCALA: con 2 decimales la auditoría registraría 8.08 mientras el
  // stock vale 8.075. Los umbrales de abajo copian stockMin/stockMax, que siguen
  // en 2 decimales: cada columna de auditoría mantiene la escala de su origen.
  //
  // Pero la PRECISIÓN es mayor a propósito: 14 dígitos, no 12. La auditoría es
  // historia y no se reescribe. Producción tiene una fila real de 9.999.999.999
  // (un AJUSTE_SUMAR erróneo de 2026-06-16) que no entra en numeric(12,3) —máximo
  // 999.999.999,999— y haría fallar el ALTER. Con (14,3) el registro histórico se
  // conserva intacto y los ajustes nuevos igual guardan sus tres decimales.
  //
  // StockLocal NO acompaña esta ampliación: ahí (12,3) es el rango operativo
  // correcto, y el valor absurdo se corrige por el flujo normal de ajuste.
  cantidadAnterior Decimal? @db.Decimal(14, 3)
  cantidadNueva    Decimal? @db.Decimal(14, 3)
  stockMinAnterior Decimal? @db.Decimal(12, 2)
  stockMinNuevo    Decimal? @db.Decimal(12, 2)
  stockMaxAnterior Decimal? @db.Decimal(12, 2)
  stockMaxNuevo    Decimal? @db.Decimal(12, 2)
  // ── LA CAUSA, Y APARTE EL DETALLE ────────────────────────────────────────
  //
  // `motivoPrincipal` es la causa elegida de una lista, con los MISMOS valores
  // que `TransferenciaDetalle.motivoPrincipal` y `PedidoProveedorDetalle.
  // motivoPrincipal` —"Faltante", "Producto dañado", "Sobrante", "Otro"—, que
  // viven en `lib/stock/motivosDeDiferencia.js`. Un CHECK de la migración no
  // deja guardar otro.
  //
  // `motivo` sigue siendo texto libre: el detalle de un ajuste manual, o el
  // texto que arma la recepción de una transferencia con sus números.
  //
  // Las filas anteriores quedan con la causa en NULL aunque `motivo` tenga
  // texto. No se deduce una causa leyendo castellano: "se rompió" puede ser un
  // producto dañado o un error de carga, y adivinarlo sería inventar el dato.
  motivoPrincipal  String?
  motivo           String?

  // ── DE QUÉ RECEPCIÓN SALIÓ ESTE MOVIMIENTO ────────────────────────────────
  //
  // Hasta acá el único rastro de que un ajuste venía de una recepción era el
  // texto de `motivo`, que arma la ruta con los números adentro de una frase.
  // Sirve para leerlo, no para preguntarle nada a la base: no se puede pedir
  // "todos los movimientos de la transferencia 97" sin parsear castellano.
  //
  // Estas dos referencias lo vuelven estructural. Nulables porque la enorme
  // mayoría de los movimientos de stock no vienen de una transferencia —un
  // ajuste manual, una venta— y esas filas quedan como estaban. `SetNull` en las
  // dos: borrar una transferencia no puede borrar la historia de que su stock se
  // movió, igual que en las FK de identidad de `VentaPago`.
  transferenciaId        Int?
  transferenciaDetalleId Int?

  createdAt        DateTime @default(now())

  local   Local   @relation(fields: [localId], references: [id])
  usuario Usuario @relation(fields: [userId], references: [id])
  transferenciaDetalle TransferenciaDetalle? @relation(fields: [transferenciaDetalleId], references: [id], onDelete: SetNull)

  @@index([grupoId, localId])
  @@index([productoLocalId])
  @@index([createdAt])
  @@index([transferenciaId])
  @@index([transferenciaDetalleId])
}

// CORRECCIÓN HISTÓRICA DE CAJA
// ---------------------------------------------------------------------------
// Una fila por incidente de caja corregido: el error ×1000 de un desglose y todo
// lo que el sistema copió de él. Es el registro AUTORITATIVO de la corrección —se
// escribe en la misma transacción que los cambios—, a diferencia de la bitácora
// central, que la llena un interceptor best-effort después del request.
//
// `codigo` es UNIQUE: es la idempotencia. El mismo incidente no se aplica dos
// veces, y una reversión futura es OTRA corrección con otro código. Las filas
// nunca se borran.
//
// Sin FK duras a Usuario, por el mismo motivo que la bitácora: el registro es
// inmutable y no tiene que bloquear el borrado de un usuario.
//
// Motor, manifiestos y reglas en lib/caja/correcciones/.
model CorreccionCaja {
  id     Int    @id @default(autoincrement())
  /// Código del incidente en el manifiesto, por ejemplo "I4".
  codigo String @unique
  /// Huella del plan exacto que se autorizó: valores antes y después de cada
  /// campo, más el alcance leído. Si algo cambió entre el ensayo y la
  /// aplicación, la huella no coincide y no se aplica.
  manifiestoHash String
  motivo         String
  evidencia      String

  autorizadoPorUsuarioId Int
  ejecutadoPorUsuarioId  Int
  ejecutadoEn            DateTime @default(now())

  /// [{ entidad, id, campo, antes, despues }], uno por campo tocado.
  cambios         Json
  /// Todas las filas del alcance, tocadas y no tocadas, antes y después.
  snapshotAntes   Json
  snapshotDespues Json

  @@index([ejecutadoEn])
}

// BITÁCORA DE AUDITORÍA CENTRAL
// ---------------------------------------------------------------------------
// Log central de escrituras sensibles, poblado por el interceptor de Prisma
// (lib/auditoria/interceptor.js) con el contexto del request propagado vía
// AsyncLocalStorage (lib/auditoria/contexto.js). Corre EN PARALELO a las islas
// existentes (AuditoriaStock, PrecioUpdate) — no las reemplaza.
// Sin FK duras (Int? standalone, patrón de PrecioUpdate.usuarioId): el log es
// inmutable y desacoplado, no bloquea el borrado de usuarios/locales/operadores.
model AuditoriaBitacora {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  usuarioId     Int? // autor (acceso). null = contexto no sembrado (script/fail-open)
  operadorId    Int? // identidad operativa. null a propósito (dueño exento / acción admin)
  localId       Int?
  grupoId       Int?
  accion        String // p.ej. "producto.editar", "pedido.anular"
  entidad       String // dominio en criollo, p.ej. "Producto", "Usuario", "Pedido"
  entidadId     String? // id primario afectado
  entidadNombre String? // nombre humano de la entidad, p.ej. "Coca Cola 500ml"
  // Cambios ya legibles. Una fila por acción de negocio (agrupada por request):
  // [{ entidad, nombre, campos: [{ campo, label, antes, despues }] }]
  cambios       Json?

  @@index([createdAt])
  @@index([localId])
  @@index([usuarioId])
  @@index([operadorId])
  @@index([entidad])
  @@index([accion])
}

// OPERADORES INTERNOS
// ---------------------------------------------------------------------------

model OperadorLocal {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  pinHash   String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales OperadorEnLocal[]
  ventas  Venta[]
  turnos  Turno[]
  arqueos ArqueoCaja[]
}

model OperadorEnLocal {
  operadorId Int
  localId    Int

  operador OperadorLocal @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  local    Local         @relation(fields: [localId], references: [id])

  @@id([operadorId, localId])
  @@index([localId])
}

// LISTAS DE PRECIOS COMERCIALES
// ---------------------------------------------------------------------------

enum ListaPrecioTipoBase {
  PRECIO_VENTA
  COSTO
  MANUAL_AUTORIZADO
}

enum TipoPrecioAplicado {
  PRECIO_VENTA
  COSTO_MAS_MARGEN
  COSTO_PURO
  MANUAL_AUTORIZADO
  OVERRIDE_PRODUCTO
}

// ---------------------------------------------------------------------------
// NOTIFICACIONES INTERNAS (v1)
// Tabla standalone (sin FK) para no acoplar a Grupo/Usuario. Scope por grupoId;
// usuarioId null = notificación para todo el grupo. tipo/entidadTipo como String
// para evitar migraciones de enum por cada tipo nuevo.
// ---------------------------------------------------------------------------
// Alcance real de una notificación (aislamiento por ubicación).
//  - USUARIO: solo el usuarioId destinatario.
//  - LOCAL: usuarios cuya ubicación activa == localId.
//  - DEPOSITO: usuarios cuya ubicación activa == localId (que es un depósito).
//  - PARTICIPANTES: usuarios en origenLocalId o destinoLocalId (transferencias).
//  - GRUPO: todo el grupo (anuncios globales; comportamiento legacy).
enum AlcanceNotificacion {
  USUARIO
  LOCAL
  DEPOSITO
  PARTICIPANTES
  GRUPO
}

model Notificacion {
  id          Int      @id @default(autoincrement())
  grupoId     Int
  usuarioId   Int?
  tipo        String
  titulo      String
  cuerpo      String?
  href        String?
  entidadTipo String?
  entidadId   Int?
  leida       Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Aislamiento por ubicación. `alcance` define cómo se combinan estos campos con
  // la ubicación activa del lector (ver lib/notificaciones/scope.js).
  localId          Int?
  origenLocalId    Int?
  destinoLocalId   Int?
  alcance          AlcanceNotificacion @default(GRUPO)
  permisoRequerido String?

  // Estado de lectura POR USUARIO. La columna `leida` de arriba quedó LEGACY (no
  // se usa para el estado por-usuario): una notif general no puede quedar leída
  // para todos cuando un usuario la abre. Ver lib/notificaciones/scope.js.
  lecturas NotificacionLectura[]

  @@index([grupoId])
  @@index([usuarioId])
  @@index([grupoId, leida])
  @@index([localId])
  @@index([alcance])
}

// Lectura por usuario de una notificación. Su AUSENCIA = no leída para ese
// usuario; su presencia = leída. Nunca se muta el estado global de la notif.
model NotificacionLectura {
  id             Int      @id @default(autoincrement())
  notificacionId Int
  usuarioId      Int
  leidaAt        DateTime @default(now())

  notificacion Notificacion @relation(fields: [notificacionId], references: [id], onDelete: Cascade)

  @@unique([notificacionId, usuarioId])
  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// SUSCRIPCIONES WEB PUSH (Etapa 1) — un registro por dispositivo/navegador.
// Standalone (sin FK). Scope por grupoId; usuarioId = dueño de la suscripción.
// No se borra físico: activo=false al desuscribir o si el push service da 404/410.
// ---------------------------------------------------------------------------
model PushSubscription {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  usuarioId Int?
  localId   Int?
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grupoId])
  @@index([usuarioId])
  @@index([localId])
  @@index([endpoint])
  @@index([grupoId, activo])
}

// ---------------------------------------------------------------------------
// IMPORTACIÓN DE LISTAS DE PRECIOS DE PROVEEDOR
//
// Un administrador sube el Excel del proveedor, el sistema lo parsea, lo concilia
// contra el catálogo y GUARDA el resultado. En esta etapa no se toca ningún
// costo: la importación es una propuesta revisable, y la cabecera + las filas SON
// la auditoría de esa propuesta.
//
// POR QUÉ SE GUARDAN TODAS LAS FILAS, INCLUSO LAS QUE NO SE PUEDEN APLICAR
//
// Una lista de Arcor trae 917 productos y solo una parte queda lista para
// actualizar. Guardar únicamente esa parte dejaría sin explicación las otras: por
// qué un producto no macheó, por qué un display quedó dudoso, por qué un kg quedó
// bloqueado. Esa explicación es lo que permite corregir el catálogo, y se pierde
// si no se persiste.
//
// ES ADITIVO. Dos tablas nuevas, tres enums nuevos y un campo nullable en
// Proveedor. No toca ninguna tabla existente ni requiere backfill.
// ---------------------------------------------------------------------------

enum EstadoImportacionLista {
  BORRADOR
  CONCILIADA
  APLICADA
  DESCARTADA
  /// Cancelada a mano. Queda como historial y LIBERA el archivo para poder
  /// volver a importarlo.
  CANCELADA
  /// Se aplicó una tanda pero quedan filas pendientes de decisión. La
  /// importación SIGUE ABIERTA: se puede vincular, seleccionar y aplicar de
  /// nuevo. Las filas ya aplicadas quedan cerradas una por una, no por el
  /// estado de la cabecera.
  PARCIALMENTE_APLICADA
  /// Cerrada a mano: "con esto alcanza". No acepta confirmar ni aplicar, y
  /// libera el archivo para la lista siguiente.
  ///
  /// SE DIFERENCIA DE CANCELADA EN UNA SOLA COSA, Y ES LA RAZÓN DE QUE EXISTA:
  /// una TERMINADA sí se puede REVERTIR. Cancelada nunca escribió un costo, así
  /// que no hay nada que deshacer; terminada suele haber escrito cientos, y el
  /// día que uno salga mal tiene que haber vuelta atrás.
  TERMINADA
}

/// Cómo se encontró el producto de una fila. Espeja TIPO_COINCIDENCIA del motor.
enum TipoCoincidenciaLista {
  CODIGO_INTERNO
  CODIGO_INTERNO_SIN_CEROS
  /// Fallback por terminación numérica. El número son los dígitos usados.
  SUFIJO_8
  SUFIJO_7
  SUFIJO_6
  SUFIJO_5
  SUFIJO_4
  /// Último camino que machea, dentro del universo del proveedor.
  CODIGO_BARRA
  AMBIGUA
  NINGUNA
}

/// Los ocho estados de `lib/proveedores/listas/estados.js`, sin inventar ninguno.
enum EstadoFilaLista {
  LISTO_PARA_ACTUALIZAR
  SIN_CAMBIOS
  NO_MACHEADO
  CODIGO_DUPLICADO
  FACTOR_DUDOSO

  /// OBSOLETO — NO CABLEAR. Nada escribe este valor y ninguna fila lo tiene:
  /// verificado en 2026-08-08, 0 de 2.751 filas en erpazul_al.
  ///
  /// La exclusión NO es un estado: vive en `ImportacionListaFila.excluidaManual`.
  /// Son dos cosas distintas y por eso son dos columnas. El estado explica POR QUÉ
  /// la fila está como está —lo que calculó el motor— y la marca dice QUÉ SE
  /// DECIDIÓ hacer con ella. Si excluir pisara el estado se perdería el motivo, y
  /// desexcluir —que es reversible— no podría restaurarlo.
  ///
  /// Sigue acá SOLO porque PostgreSQL no permite quitar valores de un enum: haría
  /// falta recrear el tipo entero y convertir la columna, una migración cara sobre
  /// una tabla grande para borrar algo que nadie usa. Del lado JS ya se sacó.
  ///
  /// Si estás por volver a usarlo porque "estaba en el enum": no. Usá
  /// `excluidaManual`.
  EXCLUIDO

  BLOQUEADO
  ERROR
}

model ImportacionListaProveedor {
  id               Int @id @default(autoincrement())
  grupoId          Int
  proveedorId      Int
  usuarioId        Int
  /// Ubicación desde la que se operó. Define la regla de propiedad del costo.
  localOperativoId Int

  archivoNombre    String
  archivoTamano    Int
  /// SHA-256 del contenido. Es la identidad del archivo: el nombre no alcanza,
  /// porque el mismo Excel se baja dos veces con nombres distintos.
  archivoHash      String
  /// Dónde quedó el binario. NULLABLE A PROPÓSITO: el proyecto todavía no tiene
  /// almacenamiento permanente de archivos, y escribirlo en el disco del
  /// contenedor lo perdería al recrearlo. La conciliación se guarda completa sin
  /// el binario; cuando exista un almacenamiento real, este campo lo apunta.
  archivoUbicacion String?

  /// Qué parser lo leyó y con qué versión, para poder explicar un resultado viejo.
  parser        String
  parserVersion String

  recargoPct         Decimal @db.Decimal(6, 3)
  umbralVariacionPct Decimal @db.Decimal(6, 3)
  /// ── RANGO DE AUMENTO ESPERADO ─────────────────────────────────────────
  ///
  /// Control de coherencia, SEPARADO del recargo. El recargo construye el costo
  /// propuesto; el rango compara ese costo contra el que el producto ya tiene.
  /// No se suman: un rango de 10 a 20 % sigue siendo 10 a 20 % con recargo 5.
  ///
  /// Configurable por importación. Cambiarlo solo recalcula la previsualización:
  /// no toca productos ni filas ya confirmadas.
  aumentoEsperadoMinPct Decimal? @db.Decimal(6, 3)
  aumentoEsperadoMaxPct Decimal? @db.Decimal(6, 3)
  /// El impuesto adicional CON EL QUE SE CONCILIÓ ESTA LISTA, copiado de la
  /// configuración del proveedor al crearla. Misma razón que el rango de acá
  /// arriba: cambiarle el impuesto al proveedor después no puede reescribir con
  /// qué criterio se decidió una lista vieja.
  impuestoAdicionalPct  Decimal? @db.Decimal(6, 3)
  /// ── QUÉ SE DECIDIÓ PARA TODA ESTA LISTA ───────────────────────────────
  ///
  /// Con qué columna de precio se leyó y si se aplicó el descuento de la fila.
  /// Se deciden UNA VEZ PARA TODA LA LISTA —probando cada opción contra los
  /// productos que tienen costo y quedándose con la que cae en el rango en la
  /// gran mayoría— para que nunca se lea un producto con el neto y el de al lado
  /// con el final.
  ///
  /// Se guardan para poder explicar meses después por qué una lista se leyó de
  /// una manera y otra del mismo proveedor de otra. `decisionDeLectura` lleva el
  /// detalle: cuántas filas votaron cada opción.
  /// PARA QUÉ SE SUBIÓ ESTA LISTA: `ACTUALIZAR` o `CONTROLAR`.
  ///
  /// `CONTROLAR` compara la lista contra los costos de hoy y NO escribe nada.
  /// Nace porque Emanuel subió una lista con el rango en 0 % a 0 % a propósito,
  /// para controlar, y el motor la tomó por una lista de actualizar imposible:
  /// con 0–0 una fila solo "explica" una columna si el precio da exactamente el
  /// costo, al centavo, así que ninguna columna llegó a la mayoría y quedaron
  /// 213 filas diciendo "entre 0,0 % y 0,0 %".
  ///
  /// Sin valor son las importaciones de antes de esta columna, y son todas de
  /// actualizar: `modoDeImportacion` cae a `ACTUALIZAR` y no hace falta
  /// escribir el histórico.
  modo                  String?
  columnaPrecioElegida  String?
  descuentoAplicado     Boolean?
  decisionDeLectura     Json?
  /// Qué se hará con el precio de venta al aplicar. Se guarda desde ahora para
  /// que la decisión quede registrada junto a la propuesta; todavía no se usa.
  modoPrecioVenta    String  @default("NO_TOCAR")

  estado EstadoImportacionLista @default(BORRADOR)

  totalFilas              Int @default(0)
  listoParaActualizar     Int @default(0)
  sinCambios              Int @default(0)
  noMacheadas             Int @default(0)
  codigoDuplicado         Int @default(0)
  factorDudoso            Int @default(0)
  excluidas               Int @default(0)
  bloqueadas              Int @default(0)
  errores                 Int @default(0)
  sugerenciasCodigoBarras Int @default(0)
  variacionAlta           Int @default(0)
  faltantes               Int @default(0)

  createdAt    DateTime  @default(now())
  conciliadaEn DateTime?
  aplicadaEn   DateTime?
  canceladaEn  DateTime?
  canceladaPorUsuarioId Int?
  /// Cuándo y quién cerró la importación por decisión propia. Misma convención
  /// que `canceladaEn`. Nulo significa que nunca se terminó.
  terminadaEn  DateTime?
  terminadaPorUsuarioId Int?
  /// Quién apretó "Aplicar". Se guarda acá y no solo en la bitácora porque
  /// esta pantalla tiene que poder explicar una corrida vieja sin depender
  /// de que el interceptor haya estado activo.
  aplicadaPorUsuarioId Int?
  /// Contadores del resultado. Se recalculan desde las filas, nunca se suman
  /// a mano.
  aplicadas Int @default(0)
  omitidas  Int @default(0)
  updatedAt    DateTime  @updatedAt

  grupo     Grupo                  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor Proveedor              @relation(fields: [proveedorId], references: [id])
  usuario   Usuario                @relation(fields: [usuarioId], references: [id])
  filas     ImportacionListaFila[]

  /// IDEMPOTENCIA REAL, a nivel base. Dos pedidos simultáneos con el mismo
  /// archivo no pueden crear dos importaciones: el segundo choca contra este
  /// índice. Un `findFirst` previo solo cubre el caso secuencial.
  /// El índice de archivo único es PARCIAL y vive en SQL: excluye las canceladas
  /// para que el mismo Excel se pueda volver a subir después de cancelar. Prisma
  /// no puede expresar un WHERE en @@unique, así que acá queda solo el índice de
  /// búsqueda y la unicidad la garantiza la migración.
  @@index([grupoId, proveedorId, archivoHash])
  @@index([grupoId, proveedorId, createdAt])
  @@index([grupoId, estado])
  @@index([usuarioId])
}

model ImportacionListaFila {
  id            Int @id @default(autoincrement())
  importacionId Int

  filaExcel  Int
  hojaNombre String

  codigoCrudo              String
  codigoNormalizado        String
  codigoComparableSinCeros String?
  codigoBarraProveedor     String?
  descripcionProveedor     String
  categoriaCruda           String?

  unidadProveedor  String
  unidadesPorBulto Int?
  /// Precio TAL COMO LO INFORMÓ el proveedor. Seis decimales: el archivo real
  /// trae valores como 1404.602001 y truncarlos falsearía la propuesta.
  precioConIva     Decimal  @db.Decimal(18, 6)
  precioSinIva     Decimal? @db.Decimal(18, 6)
  /// El descuento QUE TRAÍA ESTA FILA, tal como lo informó el archivo. NO es el
  /// que se aplicó: si se aplicó o no lo dice `descuentoAplicado` de la cabecera,
  /// que es una decisión de toda la lista. Dos hechos, dos lugares.
  descuentoPct     Decimal? @db.Decimal(6, 3)
  /// ── LO QUE DECÍA CADA COLUMNA DE PRECIO DEL ARCHIVO ──────────────────
  ///
  /// `{ "4": 858.86, "5": 1039.22 }` — el índice de columna contra su valor
  /// crudo. `precioConIva` guarda el de la columna ELEGIDA; esto guarda todas,
  /// para poder cambiar de columna después.
  ///
  /// ── POR QUÉ HACE FALTA GUARDARLAS ────────────────────────────────────
  ///
  /// Porque el archivo NO se guarda —`archivoUbicacion` queda en null— así que
  /// sin esto, descubrir que la lista se leyó con la columna equivocada obliga a
  /// volver a subir el archivo, y para eso hay que tenerlo a mano. Es
  /// justamente lo que no pasa cuando alguien abre el resultado dos días
  /// después desde el celular.
  ///
  /// Solo la tiene el camino GENÉRICO: Arcor trae las dos columnas en
  /// `precioConIva` y `precioSinIva`, que ya eran dos campos.
  ///
  /// Nullable a propósito: las 4.748 filas que ya existen no la tienen, y no se
  /// puede reconstruir sin el archivo. Una fila sin esto simplemente no admite
  /// cambio de columna, y la pantalla lo dice en vez de ofrecer un botón que
  /// falle.
  preciosPorColumna Json?

  productoBaseId           Int?
  codigoProveedorId        Int?
  tipoCoincidencia         TipoCoincidenciaLista @default(NINGUNA)
  /// Con cuántos dígitos resolvió el fallback por sufijo. null si el vínculo no
  /// vino por ahí. Aparte del enum para poder contar sin parsear su nombre.
  sufijoDigitos            Int?
  /// Producto sugerido por código de barras. NO es un vínculo: hay que confirmarlo.
  sugerenciaProductoBaseId Int?
  sugerenciaCodigoBarra    String?

  costoAnterior          Decimal? @db.Decimal(12, 2)
  recargoPct             Decimal  @db.Decimal(6, 3)
  montoRecargo           Decimal? @db.Decimal(18, 6)
  precioConRecargo       Decimal? @db.Decimal(18, 6)
  factorErp              Int?
  costoUnitarioCalculado Decimal? @db.Decimal(18, 6)
  costoMaestroPropuesto  Decimal? @db.Decimal(12, 2)
  diferencia             Decimal? @db.Decimal(12, 2)
  diferenciaPct          Decimal? @db.Decimal(12, 4)
  variacionAlta          Boolean  @default(false)

  /// El enum lo garantiza la base: una fila no puede quedar con un estado que el
  /// motor no produce.
  estado EstadoFilaLista
  /// Motivo textual, tal como lo devuelve el motor o la configuración del
  /// proveedor. NO es enum a propósito: cada proveedor puede aportar motivos
  /// propios y no queremos una migración por cada uno.
  motivo String?

  /// Si el motor pudo ELEGIR una interpretación del precio: RECOMENDADA (una
  /// sola creíble), AMBIGUA (varias) o REVISAR (ninguna). Sale de
  /// `recomendarHipotesis`, igual que `estado` sale de `clasificarLinea`.
  ///
  /// Se persiste por la misma razón que el estado: la pantalla necesita FILTRAR
  /// por él —la cola de "pendientes de decisión" son las filas que necesitan que
  /// alguien decida— y calcularlo al leer obligaría a traer las 917 filas para
  /// saber cuáles entran, rompiendo la paginación del servidor.
  ///
  /// No queda viejo: depende del recargo y del rango esperado, que son
  /// inmutables una vez creada la importación, y de la vinculación y el costo,
  /// que sí reconcilian cuando cambian.
  ///
  /// Nulo en filas conciliadas antes de que existiera la columna.
  resultadoInterpretacion String?

  seleccionable Boolean  @default(false)
  seleccionada  Boolean  @default(false)
  /// Excluida A MANO desde la pantalla de revisión. No pisa el estado que
  /// calculó el motor —que sigue explicando por qué la fila está como está—
  /// sino que la saca de lo aplicable y la deselecciona. Es reversible.
  excluidaManual Boolean @default(false)
  /// ── ARMADO CONFIRMADO A MANO ──────────────────────────────────────────
  ///
  /// Cuántas unidades del ERP cubre el precio del proveedor, cuando el motor
  /// no pudo deducirlo: el archivo y el producto declaran armados distintos, o
  /// el proveedor cotiza por display y el ERP no tiene ese concepto.
  ///
  /// Vive en la FILA y no en el producto a propósito: cambiar factor_pack
  /// reescribiría la ficha del producto para todo el ERP —compras, stock,
  /// transferencias— a partir de una lista de precios.
  /// ── PRESENTACIÓN CONFIRMADA A MANO ────────────────────────────────────
  ///
  /// Dos datos que NO se mezclan:
  ///
  ///   baseConfirmada       qué es el producto del ERP respecto de lo que cotiza
  ///                        el proveedor. MISMA_PRESENTACION no multiplica nada;
  ///                        POR_UNIDAD_SUELTA multiplica por la cantidad, y solo
  ///                        se admite cuando el archivo dice que el precio es
  ///                        por unidad suelta.
  ///   unidadesConfirmadas  cuántas unidades contiene esa presentación. Es un
  ///                        DATO del producto —sirve para el costo unitario y
  ///                        para corregir la ficha por su propio flujo—, no un
  ///                        multiplicador del precio.
  ///
  /// Mezclarlos fue el error que esto corrige: un display de $5.678 terminaba
  /// valuado en $71.545 por multiplicarlo por lo que trae adentro.
  baseConfirmada         String?
  /// Por cuánto se multiplicó el precio informado. Vale 1 salvo que el archivo
  /// demuestre que cotiza por unidad suelta y el producto agrupe varias. NUNCA
  /// sale de UxBU, que es un nivel logístico del proveedor.
  multiplicadorConfirmado Int?
  /// Cuántas unidades trae el envase. Es un DATO de la presentación: no
  /// multiplica el precio y NO reescribe ProductoBase.factor_pack, que se
  /// corrige por su propio flujo.
  cantidadPresentacion   Int?
  /// El rango con el que se evaluó esta fila, copiado de la cabecera. Cambiar el
  /// rango después no puede reescribir con qué criterio se decidió.
  aumentoEsperadoMinPct  Decimal? @db.Decimal(6, 3)
  aumentoEsperadoMaxPct  Decimal? @db.Decimal(6, 3)
  /// ── LA PERSONA ACEPTÓ UN COSTO FUERA DEL RANGO ────────────────────────
  ///
  /// Un hecho distinto de `confirmadoEn`, y por eso una columna aparte.
  /// `confirmadoEn` dice que alguien contestó CÓMO leer el precio;
  /// `fueraDeRangoAceptadaEn` dice que además le avisaron que ese costo NO cae
  /// en el rango del proveedor y siguió igual.
  ///
  /// Sin esta distinción no se podía separar "lo eligió sabiendo" de "apretó un
  /// botón que decía solo $11.083,72": la pantalla vieja ofrecía la lectura
  /// absurda con un toque y sin el porcentaje, y así fue como la importación #5
  /// terminó con productos listos a +1.008 % sobre un rango de 2 a 15.
  fueraDeRangoAceptadaEn           DateTime?
  fueraDeRangoAceptadaPorUsuarioId Int?
  /// Columnas de diseños anteriores, sin uso y sin datos. Se eliminan en una
  /// migración de limpieza, cuando ninguna versión en ejecución las lea.
  unidadesConfirmadas    Int?
  factorConfirmado       Int?
  confirmadoPorUsuarioId Int?
  confirmadoEn           DateTime?
  /// ── VINCULACIÓN MANUAL (Etapa 6A) ─────────────────────────────────────
  ///
  /// Quién resolvió a mano una fila que no macheaba, cuándo y de dónde salió la
  /// decisión. Vive acá y no en AuditoriaBitacora porque el interceptor no
  /// audita ProductoCodigoProveedor: sin estos campos, crear un vínculo desde
  /// esta pantalla no dejaría rastro de quién lo hizo.
  vinculadoPorUsuarioId Int?
  vinculadoEn           DateTime?
  /// SUGERENCIA_CODIGO_BARRAS | BUSQUEDA_MANUAL
  origenVinculo         String?

  /// Se llenan en la etapa de aplicación. Acá nacen en false/null.
  aplicada      Boolean  @default(false)
  costoAplicado Decimal? @db.Decimal(12, 2)

  /// ── HISTORIAL DE LA APLICACIÓN ────────────────────────────────────────
  ///
  /// Vive en la fila y NO en AuditoriaBitacora a propósito. La bitácora
  /// registra que un producto cambió de costo, pero no por qué una fila
  /// NO se aplicó, y ese motivo es la mitad de la información que necesita
  /// quien revisa una corrida. Además el interceptor puede estar apagado.
  aplicadaEn           DateTime?
  aplicadaPorUsuarioId Int?
  /// APLICADA | OMITIDA. Texto y no enum: los motivos de omisión los aporta
  /// la configuración de cada proveedor y no queremos una migración por cada uno.
  resultadoAplicacion  String?
  motivoAplicacion     String?
  /// Costo que tenía el producto JUSTO ANTES de escribir. Puede diferir de
  /// `costoAnterior`, que es el que había al conciliar; la diferencia entre
  /// los dos es lo que delata que alguien movió el costo en el medio.
  costoPrevioAplicacion Decimal? @db.Decimal(12, 2)
  ventaAnterior         Decimal? @db.Decimal(12, 2)
  ventaNueva            Decimal? @db.Decimal(12, 2)

  /// ── LA REVERSIÓN ──────────────────────────────────────────────────────
  ///
  /// NULO SIGNIFICA QUE NUNCA SE REVIRTIÓ. No hay un booleano al lado: la
  /// fecha ya lo dice, y dos hechos para lo mismo se contradicen el día que
  /// uno se escribe y el otro no.
  ///
  /// El historial de arriba NO se borra al revertir: costo previo, costo
  /// aplicado, venta anterior, venta escrita y fecha quedan como estaban.
  /// Son la prueba de qué se escribió, y borrarlos dejaría una reversión sin
  /// nada que explicar. La fila sí vuelve a contar como no aplicada.
  revertidaEn           DateTime?
  revertidaPorUsuarioId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importacion  ImportacionListaProveedor @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  productoBase ProductoBase?             @relation(fields: [productoBaseId], references: [id], onDelete: SetNull)

  /// Una fila física del Excel no puede entrar dos veces en la misma importación.
  /// `name` es el alias de Prisma Client; `map` es el nombre FÍSICO en la base.
  /// Son dos cosas distintas y solo la segunda renombra el índice: sin `map`,
  /// Prisma crea `ImportacionListaFila_importacionId_hojaNombre_filaExcel_key`
  /// mientras producción tiene `fila_unica_por_importacion`, que puso el SQL
  /// crudo de su migración. Se agrega `map` para que una base nueva use el mismo
  /// nombre físico y las dos instalaciones sean comparables.
  @@unique([importacionId, hojaNombre, filaExcel], name: "fila_unica_por_importacion", map: "fila_unica_por_importacion")
  @@index([importacionId, estado])
  @@index([importacionId, codigoNormalizado])
  @@index([productoBaseId])
  @@index([importacionId, filaExcel])
  /// Existe en producción desde `20260808120000_resultado_interpretacion_fila`,
  /// creado por SQL crudo y nunca declarado acá.
  @@index([importacionId, resultadoInterpretacion])
}

// ===========================================================================
// RECEPCIÓN POR COMPROBANTE
// ===========================================================================
//
// Leer la factura del proveedor, conciliarla contra el pedido y mostrarla.
// La aritmética de impuestos vive en lib/compras-proveedor/comprobante/, con su
// candado sobre dos facturas reales; acá está solo lo que se guarda.
//
// El precedente estructural es ImportacionListaProveedor: archivo con hash,
// parser versionado, filas con estado y motivo. Lo que aquel NO tiene y este sí
// es la CANTIDAD — una lista informa precios, una factura informa precio Y
// cantidad, y por eso no se pudo reusar su modelo.

enum EstadoComprobante {
  /// Subido, todavía SIN LEER. Es el estado con el que nace un comprobante: la
  /// identidad —tipo, punto de venta, número, fecha— todavía no se conoce,
  /// porque sale de leer el papel y eso ocurre después.
  PENDIENTE_LECTURA
  /// Se leyó, pero la aritmética NO cerró dentro del centavo. Desde acá no se
  /// propone nada. Es distinto de DIFIERE: allá el PAPEL no cierra y se muestra
  /// igual con la diferencia a la vista; acá lo que no cierra es la LECTURA, y
  /// un número que puede estar inventado no puede proponer un costo.
  MAL_LEIDO
  /// EL PAPEL NO TRAE TOTAL, así que no hay contra qué verificar la suma. Es lo
  /// normal en un remito o en una planilla de pedido, que Emanuel recibe además
  /// de facturas: este caso es frecuente y no una excepción.
  ///
  /// No es MAL_LEIDO: allá el modelo se equivocó, acá la lectura puede haber
  /// sido perfecta y lo que falta es el pie. Decir "no se pudo leer bien" sobre
  /// una lectura correcta es afirmar algo falso, y es la misma clase de mentira
  /// que ya separaba MAL_LEIDO de DIFIERE.
  ///
  /// No propone costos igual: sin la ecuación cerrada, un número puede estar
  /// inventado y nadie lo sabría.
  SIN_TOTAL
  /// Subido y leído, todavía sin conciliar contra el pedido.
  CARGADO
  /// La suma de sus líneas da el total del papel dentro de la tolerancia.
  CIERRA
  /// No cierra. Se muestra igual, con la diferencia a la vista.
  DIFIERE
  /// No vino como los de este proveedor: la receta no lo explica. NUNCA
  /// reescribe la receta — el mismo proveedor puede mandar uno sin impuestos.
  FUERA_DE_RECETA
  /// Anulado a mano. Libera el número para volver a subirlo.
  ANULADO
}

enum FacturaPor {
  UNIDAD
  BULTO
}

/// La receta de un proveedor: cómo viene armada su factura.
///
/// Se aprende una vez y se edita a mano. Los defaults de cada campo son los
/// mismos de RECETA_POR_DEFECTO en lib/compras-proveedor/comprobante/impuestos.js.
/// Si divergen, gana el código: ahí están los candados.
model RecetaProveedor {
  id          Int @id @default(autoincrement())
  grupoId     Int
  proveedorId Int

  /// true = cada línea trae su IVA. false = el IVA viene solo al pie.
  ivaPorLinea    Boolean @default(false)
  alicuotaIvaPct Decimal @default(21) @db.Decimal(5, 2)

  tieneImpuestoInterno Boolean @default(false)

  /// MEDIDO sobre la factura de DYSSA: el IVA se calcula sobre el neto SOLO.
  ivaIncluyeInternoEnLaBase Boolean @default(false)

  /// [{ nombre, pct }] sobre el neto. Json y no una tabla porque son dos o tres
  /// por proveedor, se editan juntas y nunca se consultan solas.
  percepciones Json @default("[]")

  /// Las percepciones van ADENTRO del costo. Decisión de negocio del
  /// 2026-08-11, con lo que gana y lo que resigna escrito en impuestos.js.
  percepcionesEnCosto Boolean @default(true)

  /// CUÁNTO SE LE MUEVE EL PRECIO A ESTE PROVEEDOR SIN QUE SEA RARO, EN %.
  ///
  /// Un 9 % de diferencia entre el papel y tu costo es normal en un proveedor
  /// que actualiza todos los meses, y es una señal de que algo se leyó mal en
  /// uno que no movió un precio en medio año. El mismo número no significa lo
  /// mismo en los dos, así que lo decide cada proveedor.
  ///
  /// Decide qué viene marcado en la hoja de Corregir y frena el cierre cuando
  /// el costo cae afuera sin que nadie lo haya elegido en esa recepción.
  variacionNormalPct Decimal @default(10) @db.Decimal(5, 2)

  facturaPor FacturaPor @default(UNIDAD)

  /// ── LA RECETA, EXPLICADA EN PALABRAS ──────────────────────────────────
  ///
  /// Hay unos treinta proveedores y cada papel es distinto. Los campos de
  /// arriba cubren impuestos y nada más, y lo que cambia de papel a papel es
  /// CÓMO SE LEE: qué columna es la cantidad, si hay descuento, si el precio es
  /// por kilo. Acá va eso, dicho como se lo explicarías a una persona.
  ///
  /// MEDIDO antes de construirlo, con el papel real de Paty (la sonda
  /// `sonda-explicacion-papel.mjs`, cd05b779): con una explicación de cuatro
  /// frases, 11 de 11 renglones quedaron bien interpretados y las tres corridas
  /// dieron los mismos números. Sin ella ese papel salía MAL_LEIDO.
  ///
  /// NO reemplaza a los campos de arriba: el IVA y las percepciones siguen
  /// armando su parte del pedido al modelo y toda la verificación.
  explicacion               String?
  explicacionActualizadaEn  DateTime?
  /// Quién la escribió. Sin autor, dentro de seis meses nadie sabe a quién
  /// preguntarle por qué el papel se lee así.
  explicacionActualizadaPor Int?

  /// Sube cada vez que alguien la edita. Se copia en el comprobante para poder
  /// explicar un resultado viejo, igual que parserVersion en las listas.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  /// Una receta por proveedor y grupo: es lo que hace que "la receta del
  /// proveedor" sea una cosa y no un historial.
  @@unique([grupoId, proveedorId])
  @@index([proveedorId])
}

/// LA RECETA QUE ARMÓ EL SISTEMA, ESPERANDO QUE ALGUIEN LA CONFIRME.
///
/// Cuando la lectura de todos los días no alcanza, el modelo grande interpreta
/// la boleta y propone cómo viene armada. Si con esa propuesta la cuenta del
/// papel CIERRA —la hace el código, no el modelo—, queda acá hasta que una
/// persona dice "está bien" en Recetas de facturas, y recién ahí pasa a
/// `RecetaProveedor` con su versión.
///
/// ── POR QUÉ NO ES UNA FILA DE RecetaProveedor ──────────────────────────
///
/// Porque la existencia de esa fila ES el hecho "el proveedor tiene receta
/// confirmada": `recetaDelProveedor` la lee así y deja de usar la genérica.
/// Escribir ahí lo que nadie confirmó convertiría una propuesta en una receta
/// sin que nadie lo decidiera. Un hecho, una tabla.
///
/// Una por proveedor y grupo: la última propuesta que cerró reemplaza a la
/// anterior, y confirmar la borra.
model RecetaPropuestaProveedor {
  id          Int @id @default(autoincrement())
  grupoId     Int
  proveedorId Int

  /// Las respuestas, con la forma de `aPreguntas`/`aReceta` de
  /// `recetaEnCriollo.js`: la misma que guarda la pantalla de recetas.
  respuestas Json
  /// La lectura con la que cerró, para que la pantalla muestre "Así lo
  /// entendió" sin volver a gastar una consulta.
  lectura    Json

  /// De qué comprobante salió y qué modelo la armó.
  comprobanteId Int?
  modelo        String

  creadaEn DateTime @default(now())

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([grupoId, proveedorId])
  @@index([proveedorId])
}

/// CÓMO SE LEE UN FORMATO DE DOCUMENTO DE ESTE PROVEEDOR.
///
/// Es la receta ESTRUCTURAL —qué columna es cuál, cómo se sabe si un renglón fue
/// enviado, qué significa la cantidad—, y es otra cosa que `RecetaProveedor`,
/// que contesta por los impuestos. Se separaron porque un proveedor tiene VARIOS
/// formatos y un solo esquema impositivo: meterlas juntas habría obligado a
/// romper la unicidad de aquélla, que es lo que hace que "la receta del
/// proveedor" sea una cosa y no un historial.
///
/// NO guarda identidad de productos. Códigos, alias, descripciones y
/// presentaciones siguen en ProductoCodigoProveedor, que es lo que hace que
/// Listas de precios y Facturas compartan lo que aprenden.
model RecetaLecturaProveedor {
  id          Int @id @default(autoincrement())
  grupoId     Int
  proveedorId Int

  /// El nombre de la variante, y su discriminador: "Consumidor Final",
  /// "Responsable Inscripto", "Remito".
  nombre String

  /// La receta validada, ya pasada por `recetaValida`. Json y no una columna por
  /// campo porque el vocabulario va a crecer, se edita entera y nunca se
  /// consulta un campo suelto. Lo que NO puede contener son valores de una
  /// factura: cantidades, importes y porcentajes se leen de cada archivo.
  receta Json

  /// El texto que escribió la persona, tal como lo escribió. Es DOCUMENTACIÓN:
  /// sirve para poder mostrar qué se quiso decir cuando esta receta se creó, y
  /// no se vuelve a interpretar solo. Lo que se aplica es siempre `receta`.
  explicacion String?

  /// Sube cada vez que alguien la edita, igual que en RecetaProveedor.
  version Int @default(1)

  /// Quién la confirmó. Una receta que nadie confirmó no debería existir: la de
  /// "usar solo esta vez" no se guarda.
  confirmadaPorUsuarioId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  /// Varias por proveedor, una por nombre de variante.
  @@unique([grupoId, proveedorId, nombre])
  @@index([proveedorId])
}

/// CÓMO SE LEE EL PRECIO DE UN PRODUCTO EN LAS LISTAS DE UN PROVEEDOR.
///
/// ── QUÉ RESUELVE ───────────────────────────────────────────────────────────
///
/// La regla de Emanuel: lo que él contesta una vez, el sistema lo recuerda. Si
/// dijo que el precio que M Y F publica para el producto 4478 es el de la CAJA
/// DE 12, la lista del mes que viene no se lo vuelve a preguntar.
///
/// ── POR QUÉ NO ES UNA COLUMNA EN ProductoCodigoProveedor ───────────────────
///
/// Porque son dos hechos distintos y se aprenden en momentos distintos. Aquella
/// tabla contesta QUIÉN ES el producto —qué código del proveedor le corresponde—
/// y se llena también desde Facturas. Ésta contesta CÓMO SE LEE SU PRECIO, que
/// es una decisión de esta pantalla y que puede cambiar sin que cambie el
/// vínculo: el proveedor puede empezar a publicar por unidad el mismo producto.
/// Mezcladas, revincular un código borraría la lectura, y corregir la lectura
/// tocaría una fila que Facturas también escribe.
///
/// ── LO QUE ESTA TABLA NO DECIDE ────────────────────────────────────────────
///
/// No habilita nada por sí sola. La lectura guardada se usa únicamente si el
/// costo que produce cae en el rango del proveedor; si queda afuera, la fila
/// vuelve a la cola y se pregunta de nuevo. Guardar una respuesta no es guardar
/// un permiso.
/// LOS PRODUCTOS QUE NO SE TOCAN CON LAS LISTAS DE ESTE PROVEEDOR.
///
/// ── POR QUÉ NO ES UNA COLUMNA DE `LecturaProductoProveedor` ────────────────
///
/// Porque son dos hechos distintos con dos vidas distintas. "Cómo se lee el
/// precio" y "no le escribas el costo" se deciden por separado, se corrigen por
/// separado, y uno puede existir sin el otro: un producto puede estar marcado
/// para no cambiar sin que nadie haya elegido nunca cómo leer su precio. Meter
/// el segundo en la tabla del primero obligaría a inventarle una `clave` de
/// lectura a algo que no tiene lectura.
///
/// ── POR QUÉ EXISTE ────────────────────────────────────────────────────────
///
/// "No lo cambio" valía para UNA lista —vive en `ImportacionListaFila.
/// excluidaManual`, que es de esa importación— así que la lista siguiente del
/// mismo proveedor volvía a preguntar por el mismo producto. Es la regla de
/// Emanuel: si ya lo explicó una vez, las cien listas que vengan son iguales.
///
/// Se puede deshacer desde "No cambian": borrar la fila es volver a incluir el
/// producto en las listas que vengan.
model ProductoQueNoSeCambia {
  id             Int @id @default(autoincrement())
  grupoId        Int
  proveedorId    Int
  productoBaseId Int

  decididoPorUsuarioId Int?
  decididoEn           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grupo        Grupo        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)

  /// UNA decisión por producto y proveedor. No se acumula: o está marcado o no.
  @@unique([grupoId, proveedorId, productoBaseId], name: "no_se_cambia_unico_por_producto_y_proveedor", map: "no_se_cambia_unico_por_producto_y_proveedor")
  @@index([grupoId, proveedorId])
  @@index([productoBaseId])
}

model LecturaProductoProveedor {
  id             Int @id @default(autoincrement())
  grupoId        Int
  proveedorId    Int
  productoBaseId Int

  /// La lectura elegida, con el vocabulario del motor: `MISMA_PRESENTACION`,
  /// `PACK_12`, `UNIDAD_SUELTA`… Se guarda la clave y NO solo el multiplicador
  /// porque la clave dice de dónde salió la cantidad, y eso es lo que permite
  /// explicarle después a una persona por qué se leyó así.
  clave String

  /// Por cuánto se multiplica el precio de la lista. 1 es "tal cual".
  multiplicador Int

  /// Cuántas unidades tiene la presentación que se eligió, cuando se sabe. Es un
  /// dato de la decisión, no del producto: NUNCA se escribe en
  /// `ProductoBase.factor_pack`.
  cantidad Int?

  confirmadaPorUsuarioId Int?
  confirmadaEn           DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  grupo        Grupo        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)

  /// UNA lectura vigente por producto y proveedor. Corregirla es reemplazarla,
  /// no acumular: lo que vale es la última respuesta.
  @@unique([grupoId, proveedorId, productoBaseId], name: "lectura_unica_por_producto_y_proveedor", map: "lectura_unica_por_producto_y_proveedor")
  @@index([grupoId, proveedorId])
  @@index([productoBaseId])
}

model ComprobanteProveedor {
  id          Int @id @default(autoincrement())
  grupoId     Int
  proveedorId Int

  /// El pedido contra el que se concilia. NULLABLE a propósito: se puede subir
  /// un comprobante sin pedido, eligiendo el proveedor primero.
  pedidoId Int?

  localOperativoId Int
  usuarioId        Int?

  /// ── IDENTIDAD: proveedor + punto de venta + número ───────────────────
  ///
  /// NULLABLES hasta que se lea el papel. Un comprobante nace de una SUBIDA, y
  /// en ese momento lo único que se tiene es el archivo. Poner "" o "SIN
  /// NUMERO" mientras tanto sería inventar un dato y, peor, haría chocar entre
  /// sí a dos comprobantes sin leer en el índice único de identidad. En
  /// PostgreSQL los NULL son distintos entre sí, así que muchos pendientes
  /// conviven sin problema y el único empieza a regir en cuanto hay número.
  tipo       String?
  puntoVenta String?
  numero     String?
  fecha      DateTime?

  /// CUIT leído del papel. SOLO se compara contra Proveedor.cuit y se avisa si
  /// difiere: NUNCA lo completa solo. Un CUIT mal leído que se autocompletara
  /// dejaría al proveedor con un dato falso que nadie volvería a mirar.
  cuitLeido String?

  /// ── TOTALES LEÍDOS DEL PAPEL ─────────────────────────────────────────
  /// Son lo que dice el comprobante, no lo que calculamos. La comparación entre
  /// unos y otros es lo que decide si cierra.
  netoLeido         Decimal? @db.Decimal(12, 2)
  ivaLeido          Decimal? @db.Decimal(12, 2)
  internoLeido      Decimal? @db.Decimal(12, 2)
  percepcionesLeido Decimal? @db.Decimal(12, 2)

  /// TODOS LOS CONCEPTOS IMPRESOS ENTRE EL SUBTOTAL Y EL TOTAL.
  ///
  /// `[{ nombre, importe, resta }]`, con el nombre TAL CUAL lo imprime el papel.
  /// Los cuatro campos de arriba son los que siempre están; esto es el resto:
  /// percepción de IVA, percepción de IIBB, retenciones, descuentos generales.
  ///
  /// El control del total usa ESTO cuando viene, y las alícuotas de la receta
  /// solo como respaldo. Un papel sin el pie desglosado queda en NULL y sigue
  /// verificándose como antes.
  conceptosDelPieLeidos Json?
  /// CÓMO LEYÓ EL MODELO ESTE PAPEL, en criollo: qué columna es qué, si el
  /// precio trae IVA, cómo repartió el pie. Es la receta que se propone cuando
  /// la lectura cierra. Null en las lecturas anteriores a la interpretada.
  explicacionLeida String?
  totalLeido        Decimal? @db.Decimal(12, 2)

  /// Diferencia en CENTAVOS ENTEROS entre lo calculado y lo leído. Enteros
  /// porque la tolerancia es de un centavo y la coma flotante no decide eso.
  diferenciaCentavos Int?

  estado EstadoComprobante @default(CARGADO)

  /// Copia de la receta con la que se leyó, para poder explicar un resultado
  /// viejo aunque la receta haya cambiado después.
  recetaVersion Int?
  recetaUsada   Json?

  /// ── QUIÉN LEYÓ, Y CUÁNTO COSTÓ ───────────────────────────────────────
  ///
  /// El modelo se guarda por el mismo motivo que la receta copiada: dentro de
  /// seis meses, mirando un comprobante viejo mal leído, la pregunta va a ser
  /// "¿con qué se leyó esto?", y la respuesta no puede ser "con el que
  /// estuviera configurado entonces".
  /// Cuántos renglones CON CANTIDAD dice VER el lector en el papel, aparte de
  /// los que transcribió. Si se saltea una línea entera, la aritmética de esa
  /// línea nunca se evalúa y las dos ecuaciones pueden cerrar igual: este es el
  /// tercer control, y el único que no sale de los mismos datos.
  ///
  /// "CON CANTIDAD" es la parte que costó: al principio contaba TODAS las filas
  /// de la grilla, y en la primera planilla real —31 filas, 10 de ellas
  /// ofrecidas sin pedir, con cantidad vacía e importe cero— avisó en rojo que
  /// faltaban 10 renglones sobre una transcripción completa y correcta. Un aviso
  /// que se equivoca la primera vez que alguien lo usa deja de mirarse.
  lineasEnElPapel Int?

  /// Cuántas transcribió EN ESA LECTURA. No se deduce contando las filas de
  /// ComprobanteLinea: esas cambian después —vincular, excluir, corregir a
  /// mano—, así que contarlas dentro de seis meses dice cuántas quedaron, no
  /// cuántas leyó el modelo.
  ///
  /// Existe sobre todo para poder auditar el control de arriba. `lineasEnElPapel`
  /// es obligatorio en el esquema de salida y DERIVABLE de la cantidad de líneas,
  /// que es la forma exacta del agujero que apagó la verificación del total; lo
  /// único que lo defiende es el prompt. Con los dos números guardados aparte,
  /// dentro de veinte facturas se ve si alguna vez difirieron. Si nunca
  /// difieren, el prompt no está funcionando y el control es decorativo.
  lineasTranscriptas Int?
  modeloLectura   String?
  leidoEn         DateTime?
  /// Cuántos intentos de lectura lleva. Un reintento no borra el anterior:
  /// suma, para que se vea que hubo que insistir.
  intentosLectura Int       @default(0)

  /// ── LA LECTURA EN CURSO, EN LA BASE Y NO EN LA MEMORIA DEL PROCESO ────
  ///
  /// Desde cuándo se está leyendo este papel. Null = no se está leyendo. Es lo
  /// que deja una sola lectura por comprobante a la vez —tomarla es un UPDATE
  /// que solo pasa si está en null— y lo que deja ver "leyendo" al volver a la
  /// pantalla. Un proceso que se reinicia con una en curso la marca cortada al
  /// arrancar; una que quedó vieja sin terminar se da por cortada al mirarla.
  /// Ver `lib/compras-proveedor/comprobante/lecturaEnSegundoPlano.js`.
  lecturaEnCursoDesde DateTime?
  /// Lo que contestó la última lectura terminada —`{ status, cuerpo }`, la
  /// misma respuesta que daba la ruta—, para que la pantalla la reciba aunque
  /// haya preguntado desde otro pedido, otro proceso o después de un reinicio.
  ultimaLectura Json?

  /// ── PARA QUE EL NÚMERO DE ACIERTO SALGA SOLO ─────────────────────────
  ///
  /// La medición del acierto se hace con las facturas REALES que entren por la
  /// pantalla, no con una prueba armada. Para que después de veinte facturas el
  /// número esté sin que nadie prepare nada, hace falta guardar esto ahora.
  ///
  /// En qué intento cerró por primera vez. 1 = cerró a la primera. Null = nunca
  /// cerró. Se guarda el NÚMERO y no un booleano porque "cerró" y "cerró a la
  /// primera" son preguntas distintas, y `intentosLectura` no alcanza: releer un
  /// comprobante que ya había cerrado lo sube igual.
  cerroEnIntento Int?
  /// Si la lectura la hizo el respaldo. `modeloLectura` ya dice cuál fue, pero
  /// contar cuántas veces el titular se quedó sin cuota no tiene que depender de
  /// deducirlo del nombre del modelo.
  usoRespaldo       Boolean @default(false)
  /// Por qué se pasó al respaldo: sin cuota y servicio caído se arreglan
  /// distinto.
  motivoPaseRespaldo String?

  /// El consumo, para que el costo sea un dato y no una sorpresa a fin de mes.
  /// En micro-dólares ENTEROS —millonésimas— y no en Decimal de centavos: una
  /// lectura sale fracciones de centavo, y redondear a centavos daría cero en
  /// cada fila y una suma mensual que no coincidiría con la factura del
  /// servicio.
  tokensEntrada Int?
  tokensSalida  Int?
  costoMicroUsd Int?


  /// ── LA IMAGEN VIVE SIETE DÍAS ────────────────────────────────────────
  ///
  /// Vive en un VOLUMEN del VPS, no en el disco del contenedor: ahí se perdería
  /// al recrearlo, que es el motivo por el que el campo equivalente de
  /// ImportacionListaProveedor quedó en null todo este tiempo.
  ///
  /// CADA FOTO VENCE A LOS SIETE DÍAS DE SUBIDA, por su cuenta. Un proceso
  /// diario borra las vencidas. NO hay borrado mensual en bloque: una foto de
  /// ayer no se va junto con una de la semana pasada.
  ///
  /// Confirmar la recepción NO adelanta el borrado. La segunda revisión del
  /// dueño ocurre después de que el personal recibe, así que borrar al
  /// confirmar le sacaría el papel justo antes de que lo mire.
  /// ── UN COMPROBANTE, VARIAS IMÁGENES ──────────────────────────────────
  ///
  /// Los datos del archivo viven en `ComprobanteArchivo`, uno por foto, porque
  /// UNA FACTURA LARGA VIENE EN VARIAS FOTOS. La de DAS son dos: el encabezado
  /// con las líneas y el pie con los totales. Con un archivo por comprobante,
  /// el total a verificar quedaba en una imagen y las líneas que tiene que
  /// sumar en la otra, así que leyendo una sola NUNCA iba a cerrar — y la
  /// puerta la habría marcado como mal leída para siempre, sin que el problema
  /// estuviera en la lectura.
  ///
  /// Las fotos se leen JUNTAS, en un solo pedido, como el papel que son.
  /// Cuándo se recibió con el okey del personal. Queda como dato, no dispara
  /// el borrado.
  confirmadoEn DateTime?
  /// createdAt + 7 días. Se guarda en vez de calcularse para que el barrido
  /// diario pueda pedirlas por índice en lugar de recorrer la tabla entera.
  venceEn         DateTime?
  imagenBorradaEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proveedor Proveedor            @relation(fields: [proveedorId], references: [id])
  lineas    ComprobanteLinea[]
  archivos  ComprobanteArchivo[]

  /// El índice único de identidad es PARCIAL y vive en la migración —excluye
  /// los ANULADO, para que un número anulado se pueda volver a subir—, así que
  /// acá queda solo el de búsqueda. Prisma no sabe expresar un WHERE en
  /// @@unique; es la misma técnica que el índice de archivo de las listas.
  @@index([grupoId, proveedorId, puntoVenta, numero])
  @@index([grupoId, pedidoId])
  @@index([grupoId, estado])
  /// Existe en producción desde `20260811200000_comprobante_subida_antes_de_leer`,
  /// creado por SQL crudo y nunca declarado acá.
  @@index([grupoId, estado, createdAt])
  /// Para el barrido diario: las que vencieron y todavía tienen imagen.
  @@index([venceEn, imagenBorradaEn])
}

/// UNA FOTO DE UN COMPROBANTE. Varias por comprobante, en orden.
///
/// Existe porque una factura larga viene en varias fotos: la de DAS son dos,
/// el encabezado con las líneas y el pie con los totales. Leyendo una sola,
/// el total a verificar está en una imagen y las líneas que tiene que sumar en
/// la otra, así que NUNCA cerraría — y la puerta la marcaría como mal leída
/// para siempre, con la lectura perfecta.
model ComprobanteArchivo {
  id            Int @id @default(autoincrement())
  comprobanteId Int

  /// En qué orden se mandan al lector. Importa: el modelo lee las imágenes
  /// como páginas de un mismo papel, y el pie después del encabezado se
  /// entiende distinto que al revés.
  orden Int

  nombre String
  tamano Int
  mime   String?
  /// SHA-256 del contenido. Es la red contra subir dos veces la misma foto:
  /// la identidad de negocio atrapa la misma factura recargada, el hash atrapa
  /// el mismo ARCHIVO — y con varias fotos por comprobante, el hash tiene que
  /// vivir por foto o dos páginas distintas se leerían como duplicado.
  hash      String
  ubicacion String?

  createdAt DateTime @default(now())

  /// ── CÓMO HAY QUE GIRAR ESTA FOTO PARA VERLA DERECHA ───────────────────────
  ///
  /// Los grados que ELIGIÓ una persona tocando «Girar» en el visor, sobre lo que
  /// ya se ve. Se suma al giro que dice el EXIF del archivo, que se lee al vuelo
  /// y no se guarda: ése es un dato del archivo y no cambia nunca.
  ///
  /// NULL significa "nadie la giró todavía", que no es lo mismo que cero —cero
  /// es "la miré y está bien así"—. La diferencia no la usa nada hoy y por eso
  /// la columna es nullable en vez de tener default: el día que haga falta saber
  /// si alguien ya la revisó, el dato está.
  ///
  /// La foto ORIGINAL no se toca: es el documento contra el que se controla un
  /// número, y volver a comprimirla para dejarla derecha le bajaría calidad
  /// justo en los dígitos chicos.
  giroGrados Int?

  comprobante ComprobanteProveedor @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@unique([comprobanteId, orden])
  @@index([comprobanteId])
  @@index([hash])
}

/// UNA CORRECCIÓN A MANO DE LO QUE DICE EL PAPEL EN UN RENGLÓN.
///
/// Un comprobante que no cierra se puede arreglar poniendo a mano lo que se lee
/// en la foto —cantidad, precio, importe—. Queda registrado quién, cuándo, qué
/// había leído el lector y qué se puso, para la segunda revisión: lo que la
/// persona escribió reemplaza a lo leído, y eso se tiene que poder ver.
///
/// Sin relación de Prisma con el renglón a propósito: el id de un renglón muere
/// cuando el papel se vuelve a leer, y la corrección no se puede ir con él. Por
/// eso guarda también el orden y el texto impreso.
model CorreccionManualRenglon {
  id                 Int      @id @default(autoincrement())
  grupoId            Int
  comprobanteId      Int
  comprobanteLineaId Int?
  orden              Int
  textoCrudo         String?
  /// `{ cantidad, netoUnitario, subtotal }` tal como estaban antes de corregir.
  leido              Json
  /// Lo mismo, con lo que la persona puso.
  puesto             Json
  /// Si con esta corrección el papel cerró.
  cerroDespues       Boolean  @default(false)
  usuarioId          Int?
  creadaEn           DateTime @default(now())

  @@index([comprobanteId])
}

model ComprobanteLinea {
  id            Int @id @default(autoincrement())
  comprobanteId Int
  orden         Int

  /// El texto TAL CUAL lo trajo la factura, sin normalizar. Es lo que se
  /// muestra debajo del nombre del producto y lo que alimenta el alias.
  textoCrudo String

  /// EL CÓDIGO DE ARTÍCULO DEL PROVEEDOR, tal como viene impreso.
  ///
  /// La factura de DYSSA trae "Cód Art" —010027, 010193…— y es el ÚNICO dato de
  /// vínculo que no interpreta nada: el proveedor y nosotros estamos hablando
  /// del mismo número. Es el primer escalón de la cascada de
  /// `lib/compras-proveedor/comprobante/vinculo.js` y machea directo contra
  /// `ProductoCodigoProveedor.codigoInterno`.
  ///
  /// Faltaba. El lector lo leía —está en el contrato desde el principio— y la
  /// ruta lo tiraba al guardar, así que el escalón más fuerte de la cascada no
  /// podía funcionar NUNCA: toda línea caía a sugerencia por texto. Se descubrió
  /// al armar la captura, buscando un caso que vinculara solo y no encontrando
  /// ninguno posible.
  codigoProveedor String?

  cantidad     Decimal @db.Decimal(12, 3)
  /// Unitario NETO, sin impuestos. Alta precisión como el resto de los
  /// unitarios del proyecto (PedidoProveedorDetalle.precioCosto es 18,6).
  netoUnitario Decimal @db.Decimal(18, 6)
  /// El subtotal COMO VIENE IMPRESO. No se recalcula desde cantidad × unitario:
  /// medido en la factura de DAS, dos de tres líneas difieren un centavo y
  /// recalcular desvía el comprobante tres centavos, fuera de la tolerancia.
  subtotalImpreso Decimal  @db.Decimal(12, 2)
  /// ── LOS KILOS DEL PAPEL ───────────────────────────────────────────────
  ///
  /// Cuando el renglón trae peso, el precio es POR KILO y la cantidad son
  /// piezas: el costo real sale de dividir el subtotal por los kilos, no por
  /// las piezas. Hasta ahora esos kilos no se leían, y por eso el fiambre
  /// quedaba afuera de la cuenta de la ganancia con el motivo escrito en
  /// `gananciaDelDeposito`: "los kilos no están en el papel". Ahora sí están,
  /// cuando el papel los trae.
  pesoKg          Decimal? @db.Decimal(12, 3)
  /// El descuento del renglón, en porcentaje y como viene impreso. NO se aplica
  /// a nada: el subtotal impreso ya lo tiene adentro. Sirve para el control por
  /// renglón —(kilos o cantidad) × precio × (1 − bonif) contra el subtotal— que
  /// es lo que señala un número mal leído.
  bonificacionPct Decimal? @db.Decimal(5, 2)
  descuento       Decimal? @db.Decimal(12, 2)
  internoUnitario Decimal? @db.Decimal(18, 6)
  ivaPct          Decimal? @db.Decimal(5, 2)

  /// El producto al que se vinculó, y contra qué línea del pedido.
  productoLocalId Int?
  pedidoDetalleId Int?

  /// El costo FINAL unitario que resultó: neto + interno + IVA + la parte de
  /// percepciones que le tocó. Es lo que se compara contra el catálogo.
  costoFinalUnitario Decimal? @db.Decimal(18, 6)

  /// ── PARA PODER DESHACER ──────────────────────────────────────────────
  /// El costo que el producto TENÍA justo antes de que esta línea lo pisara.
  /// Sin esto no hay reversión posible. Es el mismo patrón que
  /// ImportacionListaFila.costoPrevioAplicacion, que existe por lo mismo.
  costoPrevioAplicacion Decimal? @db.Decimal(12, 2)
  costoEscrito          Boolean  @default(false)

  /// El precio que la LÍNEA DEL PEDIDO tenía antes de que aceptar lo pisara.
  ///
  /// Es un hecho DISTINTO de `costoPrevioAplicacion`, el de arriba, y por eso
  /// va en su propia columna: aquel guarda el costo del PRODUCTO y existe para
  /// poder revertir; este guarda el precio del PEDIDO y existe para poder ver a
  /// qué se pidió y a qué terminó facturando, que es una pregunta comercial.
  /// Compartiendo columna, revertir un costo pisaría el registro de lo pedido.
  precioPedidoPrevio Decimal? @db.Decimal(18, 6)

  /// Cómo quedó al comparar contra el catálogo. Los valores son los de
  /// CLASE_DIFERENCIA en lib/compras-proveedor/fronteraCosto.js.
  claseDiferencia String?
  diferenciaPct   Decimal? @db.Decimal(6, 3)

  /// ── QUIÉN DIO POR CONTROLADO ESTE RENGLÓN DEL PAPEL ────────────────────
  ///
  /// No se deduce de que la cantidad coincida: eso es lo que el sistema
  /// calcula, y darlo por controlado es poner el tilde verde sobre un renglón
  /// que nadie miró. Lo marca la persona, tocando "✓ Coincide" o guardando la
  /// hoja de corregir.
  ///
  /// Y NO PUEDE SER ESTADO DE REACT, que es como estaba: un refresco devolvía
  /// la pantalla a 0 de 15 revisadas mientras las cantidades y las decisiones
  /// de precio sí sobrevivían, así que quedaba en un estado que nadie dejó. Con
  /// 197 líneas eso es media hora de trabajo tirada.
  ///
  /// LA MARCA ES DEL RENGLÓN DE LA FACTURA Y NO DE LA LÍNEA DEL PEDIDO, y esa
  /// es la diferencia que la arregla de verdad: el estado de React se indexaba
  /// por `pedidoDetalleId`, y DOS renglones del papel pueden apuntar a la misma
  /// línea del pedido —medido: las líneas 120 y 121 del comprobante 5 van las
  /// dos al detalle 2565—. Marcando una se marcaba la otra, y el contador de
  /// arriba contaba dos. Lo que se controla es el renglón del papel.
  ///
  /// Los MISMOS nombres que `TransferenciaDetalle`, que guarda este mismo hecho
  /// del otro lado del depósito: dos vocabularios para "lo revisó una persona"
  /// hacen que un reporte tenga que conocer los dos.
  ///
  /// `revisadoEnRecepcionPorId` va como escalar y sin relación, igual que
  /// `DecisionDePrecioProveedor.decididaPorUsuarioId`: hoy no se muestra el
  /// nombre en ninguna pantalla. El día que se muestre se agrega la relación,
  /// que es otra migración y otra decisión.
  /// POR UNIDAD O POR BULTO, CUANDO EL PAPEL NO LO DEJA DEDUCIR Y ALGUIEN ELIGE.
  ///
  /// Vivía solo en la memoria del navegador: refrescar la pantalla borraba la
  /// elección y el renglón volvía a preguntar lo mismo. Es una decisión de una
  /// persona sobre ESTE renglón, así que vive en el renglón.
  ///
  /// Texto y no enum: los valores son los de `UNIDAD` en `precioDeLinea.js`, y
  /// el contrato lo define ese módulo.
  /// EL SUBTOTAL QUE ALGUIEN —O LA CUENTA— DIJO QUE DICE EL PAPEL.
  ///
  /// `subtotalImpreso` es lo que el lector CREYÓ leer y no se toca: son dos
  /// hechos distintos y pisar uno con el otro pierde la explicación —"leyó
  /// $46.896,56, corregido a $46.886,55"— y hace que una relectura borre la
  /// corrección sin dejar rastro.
  ///
  /// Se hereda a la lectura siguiente igual que el vínculo y la marca de
  /// revisado: es una decisión sobre el renglón, no un número del papel.
  subtotalCorregido Decimal? @db.Decimal(12, 2)

  /// LO QUE INTERPRETÓ EL MODELO (2026-10-10, "seguimos de parche en parche").
  ///
  /// El costo del renglón ENTERO con todo adentro según ese papel —IVA,
  /// percepciones, internos, bonificaciones y descuentos que le correspondan—.
  /// De acá sale el costo del producto; la suma de todos contra el total
  /// impreso es el control. Null en las lecturas anteriores a la interpretada,
  /// que se siguen costeando como se costeaban.
  costoFinalRenglon Decimal? @db.Decimal(14, 2)
  /// En qué viene la cantidad, como lo dice el papel: "unidad", "pack de 6", "kg".
  enQueViene        String?
  /// MERCADERIA o ENVASE (`TIPO_RENGLON` en `lector/lecturaInterpretada.js`).
  tipoRenglon       String?

  unidadElegida String?

  revisadoEnRecepcion      Boolean   @default(false)
  revisadoEnRecepcionPorId Int?
  revisadoEnRecepcionAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comprobante ComprobanteProveedor @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)

  @@index([comprobanteId, orden])
  @@index([productoLocalId])
  @@index([pedidoDetalleId])
  /// Existe en producción desde `20260811230000_comprobante_linea_codigo_proveedor`,
  /// creado por SQL crudo y nunca declarado acá. Se declara ahora para que el
  /// schema describa la estructura REAL: sin esto, una base construida desde el
  /// schema sale sin el índice y `migrate diff` propone borrarlo de producción.
  @@index([codigoProveedor])
}

/// Una fila por LLAMADA al modelo de lectura, haya salido bien o mal.
///
/// Existe para poder decir cuántas lecturas quedan en el día sin llamar a nadie.
/// No se puede deducir de `ComprobanteProveedor`: una lectura que falló gasta
/// cuota igual —el 429 se cuenta contra el tope— y un comprobante releído gastó
/// dos llamadas y tiene una sola fila. Contar comprobantes mostraría más
/// disponibles de las que hay, que es justo el número que no se puede equivocar.
///
/// Y sirve para una segunda cosa: la hora exacta a la que el proveedor repone la
/// cuota no se puede averiguar desde acá sin esperar a que ocurra. Con esta
/// tabla sale sola — la primera llamada que sale bien después de una racha de
/// CUOTA_AGOTADA marca el momento.
model LlamadaLector {
  id     Int     @id @default(autoincrement())
  /// El nombre del modelo, tal como se guarda en `modeloLectura`. La cuota es
  /// POR MODELO, así que sin esto no se puede contar.
  modelo String
  ok     Boolean
  /// El código de MOTIVO_LECTURA cuando falló. Texto y no enum: los motivos los
  /// define el contrato del lector y no queremos una migración por cada uno.
  motivo String?
  /// LO QUE CONTESTÓ EL SERVICIO, TAL CUAL Y RECORTADO.
  ///
  /// El 2026-09-21 el lector no leyó en todo el día y esta tabla decía
  /// SERVICIO_CAIDO diecinueve veces, sin poder contestar por qué. Hubo que
  /// volver a llamar a la API a mano para descubrir que abajo había DOS causas
  /// distintas —un 503 de demanda y un 429 de cuota diaria agotada, límite 20—
  /// y que el cuerpo del error se estaba tirando.
  ///
  /// Guarda el estado y el mensaje del proveedor. Nunca la clave: lo que se
  /// escribe sale del cuerpo de la respuesta, que no la contiene.
  detalle String?
  /// Contra qué comprobante fue, cuando lo hubo. Nullable porque la cuota es del
  /// proyecto entero y una llamada vale igual sin comprobante detrás.
  comprobanteId Int?

  /// QUÉ DISPARÓ ESTA LLAMADA.
  ///
  /// El 2026-09-22 hubo que contestar por qué el comprobante 13 tenía diez
  /// lecturas y la tabla no podía: decía cuándo y con qué modelo, no quién la
  /// pidió. Se dedujo cruzando `intentosLectura` —que estaba en cuatro— contra
  /// las diez filas, y así se supo que seis eran pruebas de la receta y no
  /// habían reescrito ningún renglón. Con esta columna se lee en vez de
  /// deducirse.
  ///
  /// Los valores están en `ORIGEN_DE_LECTURA`, en
  /// `lib/compras-proveedor/comprobante/origenDeLectura.js`. Texto y no enum
  /// por el mismo motivo que `motivo`: los define la pantalla.
  origen String?

  /// POR QUÉ SE LLAMÓ AL MODELO GRANDE, cuando esta llamada es una escalada.
  ///
  /// Null en las lecturas de todos los días. En las del modelo grande dice cuál
  /// de los tres casos la disparó —FALTAN_RENGLONES, NO_CIERRA o SIN_RECETA,
  /// en `ESCALADA` de `lector/escalada.js`—, para poder contar cuántas hubo de
  /// cada una sin deducirlo. Texto y no enum por lo mismo que `motivo`.
  escalada String?

  /// CUÁNTO TARDÓ, en milisegundos, desde que se mandó el pedido hasta que
  /// contestó —o hasta que se cortó—. Es lo que va a decir con datos de
  /// producción qué espera hace falta para cada modelo, en vez de suponerla.
  duracionMs Int?

  /// LOS TOKENS QUE INFORMA GOOGLE en `usageMetadata`: cuánto escribió
  /// (`candidatesTokenCount`), cuánto razonó (`thoughtsTokenCount`) y el total.
  /// Para ver en producción cuánto razona cada modelo y si el techo de Flash
  /// alcanza. Vacíos cuando la llamada se cortó sin respuesta: no hay nada que
  /// contar, y un cero diría que contestó sin escribir.
  tokensSalida       Int?
  tokensRazonamiento Int?
  tokensTotal        Int?

  /// LO QUE CONTESTÓ EL MODELO, TAL CUAL: el texto del JSON que devolvió, antes
  /// de normalizarlo. Sin esto Secco #256 quedó sin diagnóstico: el modelo
  /// grande no cerró y no había forma de ver qué había puesto en cada campo sin
  /// gastar otra lectura. Vacío cuando no hubo respuesta que guardar.
  respuestaCruda String?

  creadoEn DateTime @default(now())

  /// Se consulta siempre igual: las de las últimas horas, por modelo.
  @@index([creadoEn, modelo])
}

// ═══════════════════════════════════════════════════════════════════════════
// OFERTAS COMERCIALES
// ═══════════════════════════════════════════════════════════════════════════
//
// Una oferta es una EXCEPCIÓN TEMPORAL de precio sobre productos concretos de
// un local. No toca `ProductoLocal.precio_venta` ni `ProductoBase.precio_venta`
// jamás: el precio normal sigue siendo el precio normal, y cuando la oferta
// termina no hay nada que restaurar. Esa es toda la razón por la que esto es
// una tabla aparte y no un par de columnas en el producto.
//
// NO HAY COLUMNA `estado`, y es a propósito. El estado funcional que ve la
// gente —BORRADOR, PROGRAMADA, ACTIVA, REVISAR, VENCIDA, FINALIZADA— se DERIVA
// en `lib/ofertas/estados.js` a partir de `publicadaEn`, `finalizadaEn`, la
// ventana y las líneas marcadas. Es el mismo criterio que hace que `Venta` no
// tenga un booleano `anulada` al lado de `anuladaEn`: dos fuentes de verdad que
// dicen lo mismo se contradicen el día que una se actualiza sola, y ahí no hay
// forma de saber cuál manda. Además, derivado no necesita un proceso que
// despierte a medianoche a mover ofertas de PROGRAMADA a ACTIVA.

enum CondicionPagoOferta {
  /// Exige que el ÚNICO medio de la venta sea efectivo. Un pago mixto no la
  /// cumple, aunque el efectivo cubra casi todo.
  SOLO_EFECTIVO
  CUALQUIER_MEDIO
}

model Oferta {
  id      Int    @id @default(autoincrement())
  grupoId Int
  /// La oferta es de UN local. Un producto vale distinto en cada ubicación, así
  /// que una oferta "del grupo" no tendría un precio que aplicar.
  localId Int
  nombre  String

  condicionPago CondicionPagoOferta @default(CUALQUIER_MEDIO)

  /// Ventana SEMIABIERTA [inicioEn, finEn): en el instante `finEn` la oferta ya
  /// no rige. Con el extremo cerrado, dos ofertas consecutivas que se tocan
  /// estarían las dos vigentes durante ese instante.
  inicioEn DateTime
  finEn    DateTime

  observaciones String?

  /// Momento en que dejó de ser borrador y salió a la calle. null = BORRADOR.
  /// Un borrador no rige aunque sus fechas ya estén corriendo.
  publicadaEn   DateTime?
  publicadaPorId Int?

  /// Decisión humana de darla por terminada. Gana sobre cualquier fecha.
  /// Los tres van juntos, como la anulación de venta: una finalización sin
  /// autor es indistinguible de un error de datos dentro de un mes.
  finalizadaEn   DateTime?
  finalizadaPorId Int?
  motivoFinalizacion String?

  /// De qué oferta se duplicó, cuando se renovó creando una nueva. Int suelto y
  /// no relación: es trazabilidad, y una FK obligaría a decidir qué pasa al
  /// borrar la original.
  renovadaDesdeId Int?

  creadoPorId Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  grupo   Grupo  @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  local   Local  @relation(fields: [localId], references: [id])
  lineas  OfertaLinea[]
  eventos OfertaEvento[]
  /// Líneas de venta que la aplicaron. La relación existe para poder contestar
  /// "¿esta oferta se usó alguna vez?" sin adivinar, que es lo que decide si se
  /// puede borrar. Del lado de VentaDetalle es SetNull: borrar una oferta nunca
  /// borra historial de ventas.
  ventaDetalles VentaDetalle[]

  @@index([grupoId])
  @@index([localId])
  /// La consulta caliente del POS es "ofertas de este local vigentes ahora".
  @@index([localId, inicioEn, finEn])
  @@index([finEn])
}

model OfertaLinea {
  id       Int @id @default(autoincrement())
  ofertaId Int
  /// El producto EN ESE LOCAL. Es la fila que tiene el precio y el costo, así
  /// que es la única identidad con la que un precio de oferta significa algo.
  productoLocalId Int
  /// Identidad comercial/histórica, congelada. Int suelto: sirve para reportes
  /// que cruzan locales y no justifica tocar ProductoBase con un campo inverso.
  productoBaseId  Int

  /// FUENTE CANÓNICA del precio promocional. El descuento en % NO se guarda: se
  /// deriva contra `precioNormalReferencia` en `lib/ofertas/precio.js`. Guardar
  /// los dos sería tener dos números que dicen lo mismo y se pueden contradecir.
  precioOferta Decimal @db.Decimal(12, 2)

  /// POR QUÉ ESE PRECIO TERMINÓ SIENDO ÉSE.
  ///
  /// `precioOferta` es lo que se cobra; estos dos dicen cómo se llegó. No se
  /// deducen de él: un $3.400 redondo no prueba que hubo redondeo —se puede
  /// tipear— y un precio con decimales tampoco prueba que no lo hubo.
  ///
  /// `null` significa "se cargó antes de que esto se registrara", que es
  /// distinto de "no se redondeó". Por eso NO llevan default: un `false` diría
  /// de las líneas viejas algo que nadie sabe.
  redondeoAplicado   Boolean?
  /// El precio exacto ANTES de subir al siguiente 100.
  precioSinRedondear Decimal? @db.Decimal(12, 2)

  /// Fotos del momento en que se cargó o se revisó la línea. No se actualizan
  /// solas: si el producto cambia de precio o de costo, estas NO se mueven — de
  /// esa diferencia sale justamente el aviso de revisar.
  precioNormalReferencia Decimal @db.Decimal(12, 2)
  costoReferencia        Decimal @db.Decimal(12, 2)

  /// Momento en que se detectó que el costo cambió respecto de `costoReferencia`.
  /// null = nada que mirar. De acá sale el estado REVISAR de toda la oferta.
  /// La oferta marcada SIGUE APLICÁNDOSE: el aviso no cambia el precio.
  revisionPendienteDesde DateTime?
  /// Costo que se leyó al marcar. Se guarda para poder mostrar el "de → a" aunque
  /// el costo vuelva a moverse antes de que alguien mire el aviso.
  costoAlDetectar        Decimal? @db.Decimal(12, 2)

  /// Última vez que una persona miró esta línea y dijo "está bien así".
  revisadaEn   DateTime?
  revisadaPorId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oferta        Oferta        @relation(fields: [ofertaId], references: [id], onDelete: Cascade)
  productoLocal ProductoLocal @relation(fields: [productoLocalId], references: [id], onDelete: Cascade)

  /// Un producto no puede estar dos veces en la misma oferta: sería dos precios
  /// para lo mismo dentro de una sola fila de configuración.
  @@unique([ofertaId, productoLocalId])
  @@index([ofertaId])
  @@index([productoLocalId])
  @@index([revisionPendienteDesde])
}

/// LIBRO DE CAMBIOS DE UNA OFERTA — inmutable, sin FK a Usuario (mismo patrón
/// que AuditoriaBitacora y VentaCorreccion).
///
/// Contesta las preguntas que se pidieron: cuándo se creó, cuándo cambió, quién
/// lo cambió, qué valor tenía y cuál quedó, y cuándo se finalizó. No se muestra
/// en la pantalla principal: se consulta cuando alguien pregunta por qué.
model OfertaEvento {
  id       Int @id @default(autoincrement())
  ofertaId Int
  /// Línea afectada, cuando el evento es de una línea y no de la oferta entera.
  ofertaLineaId Int?

  /// "CREADA" | "PUBLICADA" | "PRECIO_CAMBIADO" | "LINEA_AGREGADA" |
  /// "LINEA_QUITADA" | "VENTANA_CAMBIADA" | "CONDICION_CAMBIADA" |
  /// "REVISION_MARCADA" | "REVISION_CONFIRMADA" | "FINALIZADA" | "RENOVADA"
  /// Es String y no enum a propósito: agregar un motivo de auditoría no debería
  /// costar una migración. Este comentario es lo único que enumera los valores.
  tipo String

  usuarioId Int?
  /// Qué había antes y qué quedó. JSON legible, no columnas por cada campo: los
  /// eventos no son todos del mismo tipo y media tabla quedaría en null.
  valorAnterior Json?
  valorNuevo    Json?
  nota          String?

  createdAt DateTime @default(now())

  oferta Oferta @relation(fields: [ofertaId], references: [id], onDelete: Cascade)

  @@index([ofertaId])
  @@index([createdAt])
  @@index([tipo])
}

// ═══════════════════════════════════════════════════════════════════════════
// RECARGO COMERCIAL POR MEDIO DE PAGO
// ═══════════════════════════════════════════════════════════════════════════
//
// ESTO NO ES `ConfiguracionGrupo.comisionDebito` NI SUS HERMANAS, y no se puede
// derivar de ellas. Son dos hechos distintos que se parecen porque los dos son
// un porcentaje sobre el mismo medio de pago:
//
//   RecargoPagoLocal (esto)      lo cobra el comercio AL CLIENTE. SUBE el total
//                                de la venta. Es POR LOCAL, porque es una
//                                decisión comercial de cada boca.
//   ConfiguracionGrupo.comision* se la cobra el procesador AL COMERCIO. NO toca
//                                el total: baja el neto. Es POR GRUPO, porque
//                                el contrato con el banco es uno solo.
//
// Se crearon columnas nuevas en vez de reusar las de comisión justamente para
// que nadie pueda confundirlas después: los nombres dicen "recargo", viven en
// otra tabla, se configuran en otra pantalla y se congelan en otras columnas de
// Venta.
model RecargoPagoLocal {
  id      Int       @id @default(autoincrement())
  localId Int
  /// Solo EFECTIVO, DEBITO, CREDITO y MERCADOPAGO admiten recargo. FIADO no:
  /// no es una forma de cobrar sino una promesa de pago, y el recargo se define
  /// cuando se cobra de verdad. La ruta rechaza cualquier otro valor.
  medio   MedioPago
  /// Porcentaje que se le suma al cliente. 0 = no se le cobra nada de más.
  /// La AUSENCIA de fila significa exactamente lo mismo que 0: nunca se inventa
  /// un porcentaje "razonable" por defecto.
  porcentaje Decimal @default(0) @db.Decimal(5, 2)

  actualizadoPorId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([localId, medio])
  @@index([localId])
}

// ═══════════════════════════════════════════════════════════════════════════
// MEDIOS DE COBRO CONFIGURABLES DEL POS
// ═══════════════════════════════════════════════════════════════════════════
//
// Hasta acá el POS mostraba cuatro botones fijos escritos en `FormaPago.jsx`.
// Esto los hace configurables POR LOCAL: qué se ve, cómo se llama, en qué orden,
// y con qué condición comercial.
//
// ── TIPO CONTABLE Y PROCESADOR SON DOS COSAS DISTINTAS ─────────────────────
//
// Y esa separación es todo el punto del modelo. El TIPO CONTABLE es qué es el
// movimiento para la contabilidad —`MedioPago`, el mismo enum de siempre—. El
// PROCESADOR es por dónde pasa la plata.
//
//   "MP Débito"  → tipoContable DEBITO      · procesador MERCADOPAGO
//   "MP Crédito" → tipoContable CREDITO     · procesador MERCADOPAGO
//   "MP QR"      → tipoContable MERCADOPAGO · procesador MERCADOPAGO
//
// Los tres son botones distintos en la pantalla y tres cosas distintas en el
// libro, pero los tres se concilian contra Mercado Pago. Con un solo campo eso
// no se puede decir: o se pierde la conciliación o se pierde la contabilidad.
//
// ── EL NOMBRE VISIBLE NO ES LA IDENTIDAD ───────────────────────────────────
//
// `nombre` es lo que lee el cajero y puede cambiar mañana. Lo que se congela en
// la venta es `VentaPago.medio`, que es el tipo contable. Una venta de 2026 que
// dice DEBITO va a seguir diciendo DEBITO aunque el botón pase a llamarse otra
// cosa: la configuración no reescribe historia.
//
// ── UN SOLO MEDIO ACTIVO POR TIPO CONTABLE, Y POR QUÉ ──────────────────────
//
// `VentaPago` tiene `@@unique([ventaId, medio])`: como máximo un tender por medio
// canónico por venta. Si un local tuviera "Débito Banco" y "MP Débito" los dos
// activos —los dos con tipoContable DEBITO— y un cajero partiera el pago entre
// los dos, el segundo tender violaría esa restricción y la venta se caería EN LA
// CAJA, con gente esperando.
//
// La alternativa era cambiar la clave de `VentaPago`, que es la verdad de 14.226
// ventas. No se toca. Se prohíbe la combinación que la rompería, con un índice
// PARCIAL —solo entre los activos, porque los inactivos pueden convivir sin
// riesgo— que vive en el SQL de la migración: Prisma no sabe expresar un WHERE
// en un índice único, igual que los otros ocho parciales del esquema.
//
// La validación además se hace ANTES, en la capa de dominio, con un mensaje que
// se entiende. Esperar al error de Postgres para explicárselo a alguien es
// hacerle leer un mensaje escrito para otra persona.
//
// ── FIADO NO ESTÁ ACÁ, A PROPÓSITO ─────────────────────────────────────────
//
// No es una forma de cobrar sino una promesa de pago: no entra plata, es tender
// único por regla del sistema, no admite recargo ni comisión de procesador, y el
// POS ya lo dibuja aparte con sus propias condiciones —fuera de las ventas con
// servicios y exigiendo cliente—. Meterlo acá para que "todos los medios sean
// iguales" sería uniformidad de formulario a cambio de romper reglas reales.
//
// ── LA COMISIÓN ES NULLABLE, Y EL NULL SIGNIFICA ALGO ──────────────────────
//
// `null` = hereda la del grupo (`ConfiguracionGrupo.comision*`). Un número =
// override explícito de este local. Son dos estados distintos y por eso no se
// backfillea: poner el valor del grupo en cada local convertiría "hereda" en
// "alguien lo decidió así", y el día que cambie la comisión del grupo los locales
// no la seguirían sin que nadie sepa por qué.
//
// El RECARGO no está acá: sigue viviendo en `RecargoPagoLocal`, que ya existe,
// está probado y tiene su propia unicidad. Dos columnas para el mismo recargo
// serían dos fuentes que se contradicen el día que una se actualiza sola. La
// capa de dominio las compone y la pantalla edita una sola cosa.

/// Por dónde pasa la plata. NO es el tipo contable: ver el comentario de arriba.
enum ProcesadorCobro {
  MERCADOPAGO
  /// Débito o crédito por posnet bancario.
  BANCO
  /// Cualquier otro, para no tener que migrar el enum por cada caso nuevo.
  OTRO
}

model MedioCobroLocal {
  id      Int @id @default(autoincrement())
  localId Int

  /// Lo que lee el cajero en el botón. Cambiarlo NO cambia nada contable.
  nombre String
  /// Oculto en el POS sin perder su configuración ni su historial.
  activo Boolean @default(true)
  /// Orden de los botones. No es único: dos medios pueden empatar y se desempata
  /// por nombre, que es preferible a rechazar una edición por un número repetido.
  orden  Int     @default(0)

  /// QUÉ ES el movimiento. El mismo enum que congela `VentaPago.medio`.
  tipoContable MedioPago
  /// POR DÓNDE pasa. Nullable: el efectivo no tiene procesador.
  procesador   ProcesadorCobro?

  /// NULL = hereda `ConfiguracionGrupo`. Un número = override de este local.
  comisionPct Decimal? @db.Decimal(5, 2)

  /// Preparado para la integración futura (conciliación, credenciales por
  /// referencia, estado). Hoy nadie lo escribe: existe para no tener que migrar
  /// la tabla el día que se conecte un procesador de verdad.
  integracionJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  modalidades MedioCobroModalidadLocal[]

  /// Los tenders que se cobraron con ESTE medio. Nombrada porque `Venta` también
  /// apunta acá por otro motivo —quién impuso el recargo— y sin nombre Prisma no
  /// puede distinguir las dos relaciones.
  pagos               VentaPago[] @relation("PagoConMedioCobro")
  /// Las ventas donde ESTE medio impuso la condición comercial. En un pago mixto
  /// el que impone no es "el medio de la venta": son cosas distintas y por eso
  /// son dos relaciones y no una.
  ventasCuyoRecargoImpuso Venta[]  @relation("RecargoImpuestoPorMedio")

  @@index([localId])
  @@index([localId, activo, orden])
}

/// MODALIDADES DE UN MEDIO: UN SOLO BOTÓN, VARIAS CONDICIONES.
///
/// ── LOS TRES NIVELES, QUE NO SE VUELVEN A MEZCLAR ──────────────────────────
///
/// Mercado Pago se cobra de tres formas distintas y cada una tiene su condición
/// comercial. Antes eso obligaba a tres botones en el POS. Ahora:
///
///     MEDIO VISIBLE   Mercado Pago      ← un `MedioCobroLocal`
///     MODALIDAD       Crédito           ← una fila de esta tabla
///     TIPO CONTABLE   CREDITO           ← el enum, que clasifica el movimiento
///
/// Los tres son cosas distintas. Que la modalidad tenga `tipoContable` NO
/// recrea la arquitectura vieja: aquella tenía TRES `MedioCobroLocal` visibles
/// —MP Débito, MP Crédito, MP QR— y eso sigue prohibido. Acá hay UNO visible con
/// N modalidades adentro, y el `tipoContable` de la modalidad es únicamente su
/// clasificación contable, no su identidad de botón.
///
/// ── EL RECARGO VIVE ACÁ, Y ES LA FUENTE ────────────────────────────────────
///
/// `recargoPct` es autoritativo para esta modalidad. NO se consulta
/// `RecargoPagoLocal` cuando hay una modalidad elegida: esa tabla está indexada
/// por `(localId, MedioPago)` y colapsaría Débito y Crédito del mismo padre en
/// una sola fila. Medido: el segundo insert lo rechaza la base.
///
/// `0` significa "sin recargo", igual que la ausencia de fila en la tabla vieja.
/// Nunca se inventa un porcentaje por defecto.
///
/// ── LA COMISIÓN ES NULLABLE, Y ESO SIGNIFICA "SEGUIR RESOLVIENDO" ──────────
///
/// `null` NO es `0`. El sistema ya distingue "comisión configurada en cero" de
/// "comisión sin configurar", y de esa diferencia depende `comisionPendiente`,
/// que marca las ventas cuyos importes de neto y ganancia tienen un cero
/// estructural que no es una medición. Convertir el `null` en `0` acá apagaría
/// esa marca en silencio. Mismo criterio que `MedioCobroLocal.comisionPct`.
///
/// LA CADENA DE RESOLUCIÓN, CERRADA Y EN ESTE ORDEN:
///
///   1. `MedioCobroModalidadLocal.comisionPct`  ← override de la modalidad
///   2. `MedioCobroLocal.comisionPct`           ← override del medio padre
///   3. `ConfiguracionGrupo`, por el `tipoContable` DE LA MODALIDAD
///   4. sin configurar → `comisionPendiente`
///
/// **UN `0` EXPLÍCITO GANA Y CORTA LA CADENA.** Significa "este medio no cobra
/// comisión", que es una decisión, no una ausencia. Por eso la resolución NO
/// puede escribirse con `||` ni con `a ?? b` sobre un valor ya convertido a
/// número: `0 || x` devuelve `x` y transformaría una decisión en herencia.
/// Solo se baja al escalón siguiente cuando el valor es `null`.
///
/// `null` significa "heredá, seguí resolviendo", y solo termina en "sin
/// configurar" cuando la cadena se agota entera.
///
/// ── AISLAMIENTO ────────────────────────────────────────────────────────────
///
/// Una modalidad pertenece a UN medio, y el medio a UN local: el aislamiento por
/// local se hereda por la relación y no se duplica como columna. El servidor
/// igual valida la cadena completa —modalidad → medio → local de la venta— antes
/// de aceptar una selección.
model MedioCobroModalidadLocal {
  id                Int @id @default(autoincrement())
  medioCobroLocalId Int

  /// Lo que lee el cajero adentro del selector. Cambiarlo no cambia nada
  /// contable ni reescribe ninguna venta: las ventas congelan su propio texto.
  nombre String
  /// Oculta en el POS sin perder su configuración ni su historial. Una modalidad
  /// inactiva no puede usarse para crear una venta nueva, aunque el cliente
  /// mande su id.
  activo Boolean @default(true)
  /// Orden dentro del selector. No es único: se desempata por nombre, igual que
  /// en el medio padre.
  orden  Int     @default(0)

  /// QUÉ ES el movimiento de ESTA modalidad. Es lo que termina en `VentaPago.medio`.
  tipoContable MedioPago

  /// Porcentaje que se le suma al cliente. Fuente autoritativa de la modalidad.
  recargoPct Decimal @default(0) @db.Decimal(5, 2)
  /// NULL = sin configurar, y NO es lo mismo que 0. Ver arriba.
  comisionPct Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medio MedioCobroLocal @relation(fields: [medioCobroLocalId], references: [id], onDelete: Cascade)

  /// Los tenders cobrados con ESTA modalidad.
  pagos VentaPago[] @relation("PagoConModalidad")
  /// Las ventas donde ESTA modalidad impuso la condición comercial.
  ventasCuyoRecargoImpuso Venta[] @relation("RecargoImpuestoPorModalidad")

  @@index([medioCobroLocalId])
  @@index([medioCobroLocalId, activo, orden])
}
