// AUDITORIA DE STOCK
// ---------------------------------------------------------------------------

model AuditoriaStock {
  id               Int      @id @default(autoincrement())
  grupoId          Int
  localId          Int
  productoLocalId  Int
  userId           Int
  accion           String
  // Son snapshots DIRECTOS de StockLocal.cantidad (ajustar/route.js), así que
  // siguen su ESCALA: con 2 decimales la auditoría registraría 8.08 mientras el
  // stock vale 8.075. Los umbrales de abajo copian stockMin/stockMax, que siguen
  // en 2 decimales: cada columna de auditoría mantiene la escala de su origen.
  //
  // Pero la PRECISIÓN es mayor a propósito: 14 dígitos, no 12. La auditoría es
  // historia y no se reescribe. Producción tiene una fila real de 9.999.999.999
  // (un AJUSTE_SUMAR erróneo de 2026-06-16) que no entra en numeric(12,3) —máximo
  // 999.999.999,999— y haría fallar el ALTER. Con (14,3) el registro histórico se
  // conserva intacto y los ajustes nuevos igual guardan sus tres decimales.
  //
  // StockLocal NO acompaña esta ampliación: ahí (12,3) es el rango operativo
  // correcto, y el valor absurdo se corrige por el flujo normal de ajuste.
  cantidadAnterior Decimal? @db.Decimal(14, 3)
  cantidadNueva    Decimal? @db.Decimal(14, 3)
  stockMinAnterior Decimal? @db.Decimal(12, 2)
  stockMinNuevo    Decimal? @db.Decimal(12, 2)
  stockMaxAnterior Decimal? @db.Decimal(12, 2)
  stockMaxNuevo    Decimal? @db.Decimal(12, 2)
  motivo           String?
  createdAt        DateTime @default(now())

  local   Local   @relation(fields: [localId], references: [id])
  usuario Usuario @relation(fields: [userId], references: [id])

  @@index([grupoId, localId])
  @@index([productoLocalId])
  @@index([createdAt])
}

// BITÁCORA DE AUDITORÍA CENTRAL
// ---------------------------------------------------------------------------
// Log central de escrituras sensibles, poblado por el interceptor de Prisma
// (lib/auditoria/interceptor.js) con el contexto del request propagado vía
// AsyncLocalStorage (lib/auditoria/contexto.js). Corre EN PARALELO a las islas
// existentes (AuditoriaStock, PrecioUpdate) — no las reemplaza.
// Sin FK duras (Int? standalone, patrón de PrecioUpdate.usuarioId): el log es
// inmutable y desacoplado, no bloquea el borrado de usuarios/locales/operadores.
model AuditoriaBitacora {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  usuarioId     Int? // autor (acceso). null = contexto no sembrado (script/fail-open)
  operadorId    Int? // identidad operativa. null a propósito (dueño exento / acción admin)
  localId       Int?
  grupoId       Int?
  accion        String // p.ej. "producto.editar", "pedido.anular"
  entidad       String // dominio en criollo, p.ej. "Producto", "Usuario", "Pedido"
  entidadId     String? // id primario afectado
  entidadNombre String? // nombre humano de la entidad, p.ej. "Coca Cola 500ml"
  // Cambios ya legibles. Una fila por acción de negocio (agrupada por request):
  // [{ entidad, nombre, campos: [{ campo, label, antes, despues }] }]
  cambios       Json?

  @@index([createdAt])
  @@index([localId])
  @@index([usuarioId])
  @@index([operadorId])
  @@index([entidad])
  @@index([accion])
}

