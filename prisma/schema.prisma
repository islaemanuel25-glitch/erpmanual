model OperadorLocal {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  pinHash   String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locales OperadorEnLocal[]
