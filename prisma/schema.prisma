generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  permisos  Json      @default("[]")
  // Roles de sistema (Admin, CAJERO, ENCARGADO, DUEÑO_LOCAL): no se eliminan ni
  // renombran. Admin conserva ["*"]; los demás tienen permisos ajustables por Admin.
  esSistema Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  usuarios  Usuario[]
}

model Grupo {
  id              Int                @id @default(autoincrement())
  nombre          String             @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  locales         GrupoDeposito[]
  localesGrupo    GrupoLocal[]
  productos       ProductoBase[]
  clientes        Cliente[]
  movimientosCC   MovimientoCuenta[]
  contadoresVenta PosVentaCounter[]
  configuracion   ConfiguracionGrupo?
  listasPrecio    ListaPrecio[]
  codigosProveedor ProductoCodigoProveedor[]
}

model GrupoDeposito {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  /// Lista comercial default de ESTE depósito en ESTE grupo (opcional).
  /// Solo se aplica en el POS del depósito cuando la venta NO tiene lista de cliente.
  /// Nunca se aplica en los locales.
  listaPrecioDefaultId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)
  listaPrecioDefault ListaPrecio? @relation(fields: [listaPrecioDefaultId], references: [id], onDelete: SetNull)

  @@unique([grupoId, localId], name: "grupodeposito_unique")
  @@index([listaPrecioDefaultId])
}

model GrupoLocal {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  local     Local    @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@unique([grupoId, localId], name: "grupolocal_unique")
}

model Local {
  id                    Int      @id @default(autoincrement())
  nombre                String
  tipo                  String   @default("local")
  direccion             String?
  telefono              String?
  email                 String?
  cuil                  String?
  ciudad                String?
  provincia             String?
  codigoPostal          String?
  activo                Boolean  @default(true)
  es_deposito           Boolean  @default(false)
  politicaLimiteCredito String   @default("ADVERTIR")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  grupoDepositos        GrupoDeposito[]
  grupoLocales          GrupoLocal?
  listasPrecio          ListaPrecio[]
  productosCreados      ProductoBase[]  @relation("ProductoBaseCreador")
  proveedoresCreados    Proveedor[]     @relation("ProveedorCreador")
  productos             ProductoLocal[]
  stock                 StockLocal[]
  transferenciasDestino Transferencia[] @relation("destino")
  transferenciasOrigen  Transferencia[] @relation("origen")
  usuarios              Usuario[]

  posTransferenciasOrigen  PosTransferencia[] @relation("pos_origen")
  posTransferenciasDestino PosTransferencia[] @relation("pos_destino")

  ventas            Venta[]
  turnos            Turno[]
  clientes          Cliente[]
  /// Cliente que representa a ESTE local en la agenda comercial (inversa de
  /// Cliente.localVinculadoId). El campo es @unique, así que hay a lo sumo uno.
  clienteVinculado  Cliente?                 @relation("ClienteLocalVinculado")
  tagsCliente       TagCliente[]
  movimientosCC     MovimientoCuenta[]
  puntosConfig      PuntosConfigLocal?
  movimientosPuntos ClientePuntoMovimiento[]
  contadorVenta      PosVentaCounter?
  pedidosProveedor   PedidoProveedor[]
  auditoriaStock     AuditoriaStock[]
  ticketConfig       TicketConfig?
  configuracionLocal ConfiguracionLocal?
  operadorAsignaciones OperadorEnLocal[]
  arqueos              ArqueoCaja[]
  arqueoPostergaciones ArqueoPostergacion[]
}

// Configuración de comportamiento POR LOCAL. Reemplaza (con herencia) a los
// campos group-scoped de ConfiguracionGrupo para "vender sin stock" y "cliente
// obligatorio". Un campo null = heredar el valor efectivo del grupo (transición
// en dos fases: los campos de ConfiguracionGrupo se conservan en fase 1).
model ConfiguracionLocal {
  id                 Int      @id @default(autoincrement())
  localId            Int      @unique
  allowNegativeStock Boolean? // vender sin stock (config_local.stock)
  exigirClienteVenta Boolean? // cliente obligatorio en POS (config_local.pos)
  // Operario obligatorio para operar el POS de ESTE local (config_local.pos).
  // null = true (obligatorio) = comportamiento histórico; false = el local NO
  // exige operario (CAJERO/ENCARGADO operan sin PIN). Admin y DUEÑO_LOCAL siguen
  // exentos por rol en cualquier caso. Aislado por local (no afecta a otros).
  exigirOperador     Boolean?
  // Apariencia INSTITUCIONAL del local (config_local.apariencia): tema + opciones
  // de visualización de negocio que aplican a TODOS los dispositivos del local.
  // Distinta de la preferencia personal por navegador (localStorage).
  aparienciaJson     Json?

  // Arqueos parciales de caja (config_local.alertas). Todo nullable: un local
  // sin fila conserva el comportamiento histórico (sin alertas), y por eso el
  // default efectivo de `arqueoCajaActivo` es false — activar esto en producción
  // tiene que ser una decisión explícita por local, nunca un efecto de la
  // migración.
  arqueoCajaActivo                 Boolean?
  /// Minutos entre arqueos. Se cuenta desde el último arqueo del turno, o desde
  /// la apertura si todavía no hubo ninguno.
  intervaloArqueoMinutos           Int?
  /// Demora tolerada antes de exigir autorización para postergar.
  toleranciaPostergacionMinutos    Int?
  /// Cuánto corre una postergación pedida por el cajero.
  postergacionCajeroMinutos        Int?
  requiereAutorizacionPostergacion Boolean?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id], onDelete: Cascade)

  @@index([localId])
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  email        String   @unique
  passwordHash String
  rolId        Int
  localId      Int?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  local Local? @relation(fields: [localId], references: [id])
  rol   Rol    @relation(fields: [rolId], references: [id])

  confirmaciones TransferenciaDetalle[]

  posTransferencias            PosTransferencia[] @relation("pos_usuario")
  posTransferenciasSolicitadas PosTransferencia[] @relation("pos_solicitado_por")

  ventas            Venta[]
  turnos            Turno[]
  turnosCerrados    Turno[]            @relation("turnoCerradoPor")
  cajaMovimientos   CajaMovimiento[]
  arqueosComoCajero      ArqueoCaja[]         @relation("arqueoCajero")
  arqueosRealizados      ArqueoCaja[]         @relation("arqueoRealizadoPor")
  arqueosPostergados     ArqueoCaja[]         @relation("arqueoPostergadoPor")
  postergacionesArqueo   ArqueoPostergacion[] @relation("postergacionPor")
  postergacionesAutorizadas ArqueoPostergacion[] @relation("postergacionAutorizadaPor")
  movimientosPuntos ClientePuntoMovimiento[]
  movimientosCC     MovimientoCuenta[]
  auditoriaStock    AuditoriaStock[]

  @@map("Usuario")
}

model Categoria {
  id        Int            @id @default(autoincrement())
  nombre    String
  activo    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  productos ProductoBase[]
}

model Proveedor {
  id        Int     @id @default(autoincrement())
  nombre    String
  cuit      String? @unique
  telefono  String?
  email     String?
  direccion String?

  // Local donde se dio de alta el proveedor. Se usa solo como fallback de
  // visibilidad cuando el proveedor todavía no tiene productos (Regla B): lo ve
  // quien lo creó. Con productos, la visibilidad se deriva de ellos.
  creadoEnLocalId Int?

  dias_pedido DiaPedido[] @default([])

  activo    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  creadoEnLocal     Local?            @relation("ProveedorCreador", fields: [creadoEnLocalId], references: [id])
  productos         ProductoBase[]    @relation("productoProveedor1")
  productos2        ProductoBase[]    @relation("productoProveedor2")
  productos3        ProductoBase[]    @relation("productoProveedor3")
  pedidosProveedor  PedidoProveedor[]
  codigosProveedor  ProductoCodigoProveedor[]

  @@index([creadoEnLocalId])
}

model AreaFisica {
  id          Int            @id @default(autoincrement())
  nombre      String
  descripcion String?
  tipo        String?
  activo      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  productos   ProductoBase[]
}

model ProductoBase {
  id                Int          @id @default(autoincrement())
  grupoId           Int
  creadoEnLocalId   Int?
  nombre            String
  descripcion       String?
  sku               String?
  codigo_barra      String?
  codigo_barra_secundario String?
  categoria_id      Int?
  proveedor_id      Int?
  proveedor2_id     Int?
  proveedor3_id     Int?
  area_fisica_id    Int?
  unidad_medida     UnidadMedida
  factor_pack       Int?
  modo_pedido       ModoPedido   @default(BULTO)
  modo_envio        ModoEnvio?
  modo_stock        ModoStock    @default(BULTO)
  peso_kg           Decimal?     @db.Decimal(10, 3)
  volumen_ml        Decimal?     @db.Decimal(10, 2)

  // Compras a proveedor — modo fiambre
  modoCompraProveedor             ModoPedido @default(BULTO)
  pesoReferenciaKg                Decimal?   @db.Decimal(10, 3)
  pesoEsFijo                      Boolean    @default(false)
  modoVentaDeposito               ModoVentaDeposito @default(PESO)
  pesoPromedioKg                  Decimal?   @db.Decimal(10, 3)
  actualizaPromedioPorRecepcion   Boolean    @default(true)
  precio_costo      Decimal      @db.Decimal(12, 2)
  precio_venta      Decimal      @db.Decimal(12, 2)
  margen            Decimal?     @db.Decimal(6, 2)
  precio_sugerido   Decimal?     @db.Decimal(12, 2)
  iva_porcentaje    Decimal?     @db.Decimal(5, 2)
  fecha_vencimiento DateTime?
  redondeo_100      Boolean      @default(true)
  activo            Boolean      @default(true)
  imagen_url        String?
  es_combo          Boolean      @default(false)

  // Servicios de importe variable (cargas de colectivo / cargas virtuales).
  // modalidad = dimensión propia del producto (no simulada con otros flags).
  // recargoServicioDefaultPct = % de recargo general del servicio (0..100), que
  // ProductoLocal puede sobrescribir por local. Solo aplica si modalidad = IMPORTE_VARIABLE.
  modalidad                 ModalidadProducto @default(NORMAL)
  recargoServicioDefaultPct Decimal?          @db.Decimal(5, 2)

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  area_fisica   AreaFisica? @relation(fields: [area_fisica_id], references: [id])
  categoria     Categoria?  @relation(fields: [categoria_id], references: [id])
  creadoEnLocal Local?      @relation("ProductoBaseCreador", fields: [creadoEnLocalId], references: [id])
  grupo         Grupo       @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  proveedor     Proveedor?  @relation("productoProveedor1", fields: [proveedor_id], references: [id])
  proveedor2    Proveedor?  @relation("productoProveedor2", fields: [proveedor2_id], references: [id])
  proveedor3    Proveedor?  @relation("productoProveedor3", fields: [proveedor3_id], references: [id])

  preciosPorLista ProductoListaPrecio[]
  locales         ProductoLocal[]
  ventaDetalles   VentaDetalle[]
  codigosProveedor ProductoCodigoProveedor[]
  componenteEnVentas VentaDetalleComponente[]

  @@unique([grupoId, codigo_barra])
  @@index([grupoId])
  @@index([grupoId, codigo_barra_secundario])
  @@index([creadoEnLocalId])
  @@index([categoria_id])
  @@index([proveedor_id])
  @@index([proveedor2_id])
  @@index([proveedor3_id])
  @@index([area_fisica_id])
}

model ProductoCodigoProveedor {
  id                   Int      @id @default(autoincrement())
  grupoId              Int
  productoBaseId       Int
  proveedorId          Int
  codigoInterno        String
  descripcionProveedor String?
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  grupo        Grupo        @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id], onDelete: Cascade)
  proveedor    Proveedor    @relation(fields: [proveedorId], references: [id])

  @@unique([grupoId, proveedorId, codigoInterno], name: "codigo_interno_unico_por_proveedor")
  @@index([grupoId, proveedorId, codigoInterno])
  @@index([productoBaseId])
  @@index([proveedorId])
}

model ProductoLocal {
  id           Int      @id @default(autoincrement())
  localId      Int
  baseId       Int
  nombre       String?
  descripcion  String?
  precio_costo Decimal? @db.Decimal(12, 2)
  precio_venta Decimal? @db.Decimal(12, 2)
  margen       Decimal? @db.Decimal(6, 2)
  // Override por local del recargo del servicio de importe variable (0..100).
  // null → hereda ProductoBase.recargoServicioDefaultPct (y este, si null, → 0).
  recargoServicioPct Decimal? @db.Decimal(5, 2)
  // Código de barras PROPIO de esta ubicación (opcional). NO reemplaza los dos
  // códigos globales de ProductoBase: es un tercer código que solo funciona en este
  // local. null = sin código propio (default para productos existentes, sin backfill).
  codigo_barra_propio String?
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  base  ProductoBase @relation(fields: [baseId], references: [id])
  local Local        @relation(fields: [localId], references: [id])

  stock    StockLocal[]
  detalles TransferenciaDetalle[]

  posDetalles             PosTransferenciaDetalle[]
  pedidoProveedorDetalles PedidoProveedorDetalle[]

  // Combos exclusivos por local (E1). Las FK son COMPUESTAS a (id, localId).
  combosComoCombo         ComboComponente[]        @relation("ComboComponente_comboPL")
  combosComoComponente    ComboComponente[]        @relation("ComboComponente_componentePL")
  ventaDetalleComponentes VentaDetalleComponente[]

  @@unique([localId, baseId])
  @@unique([id, localId]) // destino de las FK compuestas de ComboComponente
  // Unicidad del código propio POR LOCAL: dos productos del mismo local no pueden
  // compartir codigo_barra_propio. En Postgres los NULL son distintos entre sí, así
  // que múltiples productos SIN código propio conviven sin chocar. El mismo código
  // propio SÍ puede repetirse en locales distintos (localId difiere).
  @@unique([localId, codigo_barra_propio])
  @@index([localId])
  @@index([baseId])
}

model StockLocal {
  id         Int      @id @default(autoincrement())
  localId    Int
  productoId Int
  // Escala FÍSICA: 3 decimales, la misma que VentaDetalle.cantidadStock y que
  // piezasToKg(). Con 2 decimales una venta de 1.925 kg descontaba 1.92 pero
  // acreditaba 1.93 a enTransito, y vender+corregir dejaba 10.00 → 10.01.
  cantidad   Decimal  @db.Decimal(12, 3)
  enTransito Decimal  @default(0) @db.Decimal(12, 3)
  // stockMin/stockMax NO son cantidades movidas sino umbrales de alerta: quedan
  // en 2 decimales, alineados con AuditoriaStock.stockMin*/stockMax*.
  stockMin   Decimal? @db.Decimal(12, 2)
  stockMax   Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  local    Local         @relation(fields: [localId], references: [id])
  producto ProductoLocal @relation(fields: [productoId], references: [id])

  @@unique([localId, productoId])
  @@index([localId])
  @@index([productoId])
}

// ---------------------------------------------------------------------------
// COMBOS EXCLUSIVOS POR LOCAL (E1)
// ---------------------------------------------------------------------------
// Composición de un combo (ProductoBase.es_combo = true) atada a UNA ubicación.
// El combo y cada componente son ProductoLocal del MISMO local: se garantiza
// con dos FK COMPUESTAS a ProductoLocal(id, localId) + un CHECK de igualdad
// (comboLocalId = componenteLocalId) que se agrega en la migración.
// El combo NO tiene StockLocal propio; su disponibilidad se calcula (etapas
// posteriores) a partir del stock de sus componentes en ese local.
model ComboComponente {
  id                        Int      @id @default(autoincrement())
  comboProductoLocalId      Int
  comboLocalId              Int
  componenteProductoLocalId Int
  componenteLocalId         Int
  cantidad                  Decimal  @db.Decimal(12, 3)
  createdAt                 DateTime @default(now())

  // Borrar el ProductoLocal del combo elimina su composición (Cascade).
  comboPL      ProductoLocal @relation("ComboComponente_comboPL", fields: [comboProductoLocalId, comboLocalId], references: [id, localId], onDelete: Cascade, map: "ComboComponente_comboPL_fkey")
  // No se puede borrar un ProductoLocal que es componente de un combo (Restrict).
  componentePL ProductoLocal @relation("ComboComponente_componentePL", fields: [componenteProductoLocalId, componenteLocalId], references: [id, localId], onDelete: Restrict, map: "ComboComponente_componentePL_fkey")

  // Nombres explícitos (map): algunos superan los 63 chars y Prisma los truncaría.
  @@unique([comboProductoLocalId, componenteProductoLocalId], map: "ComboComponente_combo_componente_key") // sin componentes duplicados
  @@index([componenteProductoLocalId, componenteLocalId], map: "ComboComponente_componentePL_idx")
  @@index([comboLocalId])
}

model ListaPrecio {
  id               Int                 @id @default(autoincrement())
  localId          Int?
  grupoId          Int
  nombre           String
  tipoBase         ListaPrecioTipoBase @default(PRECIO_VENTA)
  margenPorcentaje Decimal?            @db.Decimal(6, 2)
  esDefault        Boolean             @default(false)
  /// Legacy (pre–listas comerciales por grupo): preferir `margenPorcentaje` + `tipoBase`.
  margen_default   Decimal?            @db.Decimal(6, 2)
  redondeo_100     Boolean             @default(false)
  activo           Boolean             @default(true)
  notas            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  local         Local?                @relation(fields: [localId], references: [id], onDelete: Cascade)
  grupo         Grupo                 @relation(fields: [grupoId], references: [id])
  productos     ProductoListaPrecio[]
  clientes      Cliente[]
  ventas        Venta[]
  ventaDetalles VentaDetalle[]
  depositosDefault GrupoDeposito[]

  @@unique([localId, nombre], name: "lista_unica_por_local")
  @@unique([grupoId, nombre], name: "lista_unica_por_grupo")
  @@index([localId])
  @@index([grupoId])
}

model ProductoListaPrecio {
  id              Int      @id @default(autoincrement())
  listaPrecioId   Int
  baseId          Int
  precio_final    Decimal? @db.Decimal(12, 2)
  margen_especial Decimal? @db.Decimal(6, 2)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  base  ProductoBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  lista ListaPrecio  @relation(fields: [listaPrecioId], references: [id], onDelete: Cascade)

  @@unique([listaPrecioId, baseId], name: "precio_por_lista_y_producto")
  @@index([listaPrecioId])
  @@index([baseId])
}

model Transferencia {
  id                 Int       @id @default(autoincrement())
  origenId           Int
  destinoId          Int
  estado             String    @default("Pendiente")
  fechaEnvio         DateTime?
  fechaRecepcion     DateTime?
  creadaPor          Int?
  posTransferenciaId Int?
  /// Venta que originó este envío. NULL = transferencia manual (todas las de hoy,
  /// originadas en PosTransferencia). Uno a uno: una venta no puede generar dos
  /// remitos, así que aporta idempotencia estructural. El @unique ya crea el
  /// índice, no hace falta un @@index aparte. Convive con posTransferenciaId;
  /// todavía sin constraint de exclusión entre ambos.
  ventaId            Int?      @unique

  tieneDiferencias Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  destino          Local                  @relation("destino", fields: [destinoId], references: [id])
  origen           Local                  @relation("origen", fields: [origenId], references: [id])
  posTransferencia PosTransferencia?      @relation(fields: [posTransferenciaId], references: [id], onDelete: SetNull)
  venta            Venta?                 @relation("VentaTransferencia", fields: [ventaId], references: [id], onDelete: SetNull)
  detalle          TransferenciaDetalle[]

  @@index([origenId])
  @@index([destinoId])
  @@index([estado])
  @@index([createdAt])
  @@index([posTransferenciaId])
}

model TransferenciaDetalle {
  id              Int         @id @default(autoincrement())
  transferenciaId Int
  productoId      Int
  // Escala FÍSICA: 3 decimales, igual que StockLocal.cantidad. Enviar y recibir
  // tienen que poder expresar exactamente lo que el inventario movió.
  cantidad        Decimal     @db.Decimal(12, 3)
  recibido        Decimal?    @db.Decimal(12, 3)
  precioCosto     Decimal?    @db.Decimal(12, 2)
  unidadEnviada   ModoPedido? // BULTO o UNIDAD según cómo se envió

  motivoDiferencia String?
  motivoPrincipal  String? // ← AGREGADO
  motivoDetalle    String? // ← AGREGADO

  confirmadoPorId Int?
  fechaRecepcion  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  producto      ProductoLocal @relation(fields: [productoId], references: [id])
  transferencia Transferencia @relation(fields: [transferenciaId], references: [id], onDelete: Cascade)
  confirmadoPor Usuario?      @relation(fields: [confirmadoPorId], references: [id])

  @@index([transferenciaId])
  @@index([productoId])
}

enum DiaPedido {
  Lunes
  Martes
  Miercoles
  Jueves
  Viernes
  Sabado
  Domingo
}

enum UnidadMedida {
  unidad
  pack
  cajon
  kg
}

enum ModoPedido {
  BULTO
  UNIDAD
}

enum ModoEnvio {
  SOLO_BULTO
  MIXTO
  SOLO_UNIDAD
}

enum ModoStock {
  BULTO
  UNIDAD
}

enum ModoVentaDeposito {
  PIEZA
  PESO
}

// Modalidad del producto. NORMAL = producto de precio/stock habitual.
// IMPORTE_VARIABLE = servicio cuyo importe lo ingresa el cajero en el POS
// (cargas de colectivo / cargas virtuales). No es un flag simulado (combo/peso/
// no-stock/lista): es una dimensión propia y explícita del producto.
enum ModalidadProducto {
  NORMAL
  IMPORTE_VARIABLE
}

enum EstadoPedidoProveedor {
  BORRADOR
  CONFIRMADO
  ENVIADO
  RECIBIDO
  ANULADO
}

model PosTransferencia {
  id        Int @id @default(autoincrement())
  origenId  Int
  destinoId Int
  usuarioId Int

  estado              String    @default("Borrador")
  origenManual        Boolean   @default(false)
  solicitadoAt        DateTime?
  solicitadoPorUserId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  origen        Local    @relation("pos_origen", fields: [origenId], references: [id])
  destino       Local    @relation("pos_destino", fields: [destinoId], references: [id])
  usuario       Usuario  @relation("pos_usuario", fields: [usuarioId], references: [id])
  solicitadoPor Usuario? @relation("pos_solicitado_por", fields: [solicitadoPorUserId], references: [id])

  detalles       PosTransferenciaDetalle[]
  transferencias Transferencia[]

  @@index([origenId])
  @@index([destinoId])
  @@index([usuarioId])
  @@index([estado])
}

model PosTransferenciaDetalle {
  id                 Int @id @default(autoincrement())
  posTransferenciaId Int
  productoId         Int

  sugerido        Decimal?    @db.Decimal(12, 2)
  preparado       Decimal?    @db.Decimal(12, 2)
  tipo            String      @default("sugerido")
  unidadSugerida  ModoPedido  @default(BULTO)
  unidadPreparada ModoPedido? // BULTO o UNIDAD según cómo se preparó

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pos      PosTransferencia @relation(fields: [posTransferenciaId], references: [id], onDelete: Cascade)
  producto ProductoLocal    @relation(fields: [productoId], references: [id])

  @@index([posTransferenciaId])
  @@index([productoId])
  @@index([tipo])
}

enum PrecioUpdateMetodo {
  MANUAL
  AUMENTO
  REGLAS
  PEGADO
  XLSX
  SCAN
  MARGEN_MASIVO
}

enum PrecioUpdatePricingMode {
  KEEP_VENTA
  RECALC_BY_MARGIN
  SET_VENTA
}

model PrecioUpdate {
  id          Int                     @id @default(autoincrement())
  grupoId     Int
  proveedorId Int?
  usuarioId   Int?
  metodo      PrecioUpdateMetodo
  pricingMode PrecioUpdatePricingMode
  createdAt   DateTime                @default(now())

  items PrecioUpdateItem[]

  @@index([grupoId])
  @@index([proveedorId])
}

model PrecioUpdateItem {
  id             Int @id @default(autoincrement())
  precioUpdateId Int
  productoBaseId Int

  costoAnterior Decimal @db.Decimal(12, 2)
  costoNuevo    Decimal @db.Decimal(12, 2)
  ventaAnterior Decimal @db.Decimal(12, 2)
  ventaNueva    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  update PrecioUpdate @relation(fields: [precioUpdateId], references: [id], onDelete: Cascade)

  @@index([productoBaseId])
}

// ---------------------------------------------------------------------------
// CLIENTES
// ---------------------------------------------------------------------------

model Cliente {
  id                  Int      @id @default(autoincrement())
  grupoId             Int
  /// Local PROPIETARIO de la ficha (ámbito de la agenda de clientes). NO indica
  /// que el cliente "sea" ese local: para eso está localVinculadoId.
  localId             Int?
  /// Local INTERNO del grupo que este cliente representa. NULL = cliente externo
  /// (el caso normal; en Postgres los NULL son distintos entre sí, así que todos
  /// los externos conviven bajo el @unique). Uno a uno: un local no puede estar
  /// representado por dos clientes. El @unique ya crea el índice, no hace falta
  /// un @@index aparte. Vínculo EXPLÍCITO: el local nunca se infiere por el nombre.
  localVinculadoId    Int?     @unique
  listaPrecioId       Int?
  nombre              String
  documento           String?
  telefono            String?
  email               String?
  direccion           String?
  observaciones       String?
  limiteCredito       Decimal? @db.Decimal(12, 2)
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  grupo             Grupo                    @relation(fields: [grupoId], references: [id])
  local             Local?                   @relation(fields: [localId], references: [id])
  localVinculado    Local?                   @relation("ClienteLocalVinculado", fields: [localVinculadoId], references: [id], onDelete: SetNull)
  listaPrecio       ListaPrecio?             @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  ventas            Venta[]
  tags              ClienteTag[]
  movimientosCC     MovimientoCuenta[]
  movimientosPuntos ClientePuntoMovimiento[]

  @@index([grupoId])
  @@index([localId])
  @@index([grupoId, localId])
  @@index([nombre])
  @@index([listaPrecioId])
}

model TagCliente {
  id                  Int      @id @default(autoincrement())
  localId             Int
  nombre              String
  descuentoPorcentaje Decimal? @db.Decimal(5, 2)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  local    Local        @relation(fields: [localId], references: [id], onDelete: Cascade)
  clientes ClienteTag[]

  @@unique([localId, nombre])
  @@index([localId])
}

model ClienteTag {
  clienteId Int
  tagId     Int

  cliente Cliente    @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tag     TagCliente @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clienteId, tagId])
  @@index([clienteId])
  @@index([tagId])
}

model MovimientoCuenta {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  clienteId Int
  tipo      String // "VENTA" | "PAGO" | "AJUSTE"
  direccion String // "DEBITO" | "CREDITO"
  monto     Decimal  @db.Decimal(12, 2)
  ventaId   Int?
  // Corrección de ventas (Fase B): discrimina los movimientos compensatorios de
  // una corrección. 0 = movimiento original (venta/pago/ajuste normal). >0 = id
  // de VentaCorreccion que lo generó. Permite reversas + nuevos débitos sin borrar
  // historial, preservando la idempotencia del alta (VENTA con correccionId=0).
  correccionId Int   @default(0)
  userId    Int?
  nota      String?
  createdAt DateTime @default(now())

  grupo   Grupo    @relation(fields: [grupoId], references: [id])
  local   Local    @relation(fields: [localId], references: [id])
  cliente Cliente  @relation(fields: [clienteId], references: [id])
  venta   Venta?   @relation(fields: [ventaId], references: [id])
  user    Usuario? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([ventaId, tipo, correccionId])
  @@index([grupoId, localId, clienteId])
  @@index([clienteId])
  @@index([localId])
  @@index([createdAt])
  @@index([userId])
}

// POS VENTAS
// ---------------------------------------------------------------------------

model Venta {
  id               Int      @id @default(autoincrement())
  localId          Int
  vendedorId       Int
  operadorId       Int?
  clienteId        Int?
  listaPrecioId    Int?
  turnoId          Int?
  numero           Int
  clientTxnId      String?  @unique
  fecha            DateTime @default(now())
  subtotal         Decimal  @db.Decimal(12, 2)
  descuento        Decimal  @default(0) @db.Decimal(12, 2)
  descuentoAutomatico  Decimal? @db.Decimal(12, 2)
  descuentoManual      Decimal? @db.Decimal(12, 2)
  descuentoPorPuntos   Decimal? @db.Decimal(12, 2)
  total            Decimal  @db.Decimal(12, 2)
  comisionBancaria Decimal  @default(0) @db.Decimal(12, 2)
  comisionPct      Decimal? @db.Decimal(5, 2)
  netoRecibido     Decimal  @default(0) @db.Decimal(12, 2)
  costoTotal       Decimal  @default(0) @db.Decimal(12, 2)
  gananciaBruta    Decimal  @default(0) @db.Decimal(12, 2)
  gananciaNeta     Decimal  @default(0) @db.Decimal(12, 2)
  formaPago        String
  esFiado          Boolean  @default(false)

  // Corrección de ventas (in-place versionada; ver model VentaCorreccion).
  // version = token de bloqueo optimista (se incrementa en cada corrección).
  version            Int      @default(0)
  corregida          Boolean  @default(false)
  ultimaCorreccionId Int?
  // Campos descriptivos editables por corrección SIMPLE (sin stock ni dinero).
  observaciones      String?
  referenciaInterna  String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  local             Local                    @relation(fields: [localId], references: [id])
  vendedor          Usuario                  @relation(fields: [vendedorId], references: [id])
  operador          OperadorLocal?           @relation(fields: [operadorId], references: [id])
  cliente           Cliente?                 @relation(fields: [clienteId], references: [id])
  listaPrecio       ListaPrecio?             @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  turno             Turno?                   @relation(fields: [turnoId], references: [id])
  detalles          VentaDetalle[]
  pagos             VentaPago[]
  movimientoCC      MovimientoCuenta[]
  movimientosPuntos ClientePuntoMovimiento[]
  /// Remito generado por esta venta (inversa de Transferencia.ventaId). Uno a uno:
  /// el campo del otro lado es @unique, así que hay a lo sumo un remito por venta.
  /// Si algún día se admite despacho parcial, se retira ese @unique, se agrega un
  /// número de remito y este campo pasa a lista.
  transferencia     Transferencia?           @relation("VentaTransferencia")

  @@unique([localId, numero])
  @@index([localId])
  @@index([fecha])
  @@index([clienteId])
  @@index([turnoId])
  @@index([clientTxnId])
  @@index([operadorId])
  @@index([listaPrecioId])
}

// LIBRO DE CORRECCIONES DE VENTA (antes/después) — inmutable, sin FKs duras
// (mismo patrón que AuditoriaBitacora). Una fila por corrección aplicada.
// Soporta desde el inicio la corrección de turno cerrado (movimientos
// compensatorios en el turno actual), aunque su UI se habilite en otra etapa.
model VentaCorreccion {
  id                Int      @id @default(autoincrement())
  ventaId           Int
  tipo              String // "SIMPLE" | "COMPLETA"
  motivo            String
  // Idempotencia de la corrección COMPLETA: dos POST con la misma clave no la
  // aplican dos veces (se devuelve la corrección ya registrada).
  idempotencyKey    String?
  usuarioId         Int? // autor de la corrección
  operadorId        Int?
  localId           Int?
  grupoId           Int?
  turnoIdOriginal   Int? // turno de la venta al momento de corregir
  turnoIdCorreccion Int? // turno actual abierto donde impacta la diferencia (si hay)
  turnoCerrado      Boolean  @default(false)
  versionAntes      Int
  versionDespues    Int
  totalAnterior     Decimal  @db.Decimal(12, 2)
  totalNuevo        Decimal  @db.Decimal(12, 2)
  diferencia        Decimal  @db.Decimal(12, 2) // totalNuevo - totalAnterior
  // Snapshots completos (venta + detalles + componentes + pagos + CC) para
  // reconstruir el estado original y el resultante. JSON legible.
  snapshotAntes     Json
  snapshotDespues   Json
  diffProductos     Json? // [{productoBaseId, nombre, cantidadAntes, cantidadDespues, estado}]
  diffPagos         Json? // [{medio, montoAntes, montoDespues}]
  impactoStock      Json? // [{productoLocalId, nombre, delta, resultante}]
  impactoCaja       Json? // {signo, monto, medios, movimientoIds, cajaMovimientoIds}
  createdAt         DateTime @default(now())

  @@unique([ventaId, idempotencyKey])
  @@index([ventaId])
  @@index([usuarioId])
  @@index([createdAt])
  @@index([tipo])
}

model VentaDetalle {
  id                 Int                @id @default(autoincrement())
  ventaId            Int
  productoBaseId     Int
  listaPrecioId      Int?
  nombre             String
  /// Precio unitario final de línea (no duplicar con precioUnitario).
  precio             Decimal            @db.Decimal(12, 2)
  /// Costo unitario (no duplicar con costoUnitario).
  precioCosto        Decimal            @default(0) @db.Decimal(12, 2)
  cantidad           Decimal            @db.Decimal(12, 3)
  subtotal           Decimal            @db.Decimal(12, 2)
  ganancia           Decimal            @default(0) @db.Decimal(12, 2)
  comisionLinea      Decimal?           @db.Decimal(12, 2)
  tipoPrecioAplicado TipoPrecioAplicado @default(PRECIO_VENTA)
  margenAplicado     Decimal?           @db.Decimal(6, 2)

  // Snapshot histórico de SERVICIO de importe variable (nullable en líneas normales).
  // esServicio permite reconstruir la modalidad de la línea aunque el producto cambie.
  // El % y el importe del recargo quedan CONGELADOS al vender (no leer el producto actual).
  esServicio             Boolean  @default(false)
  importeBaseServicio    Decimal? @db.Decimal(12, 2)
  recargoServicioPct     Decimal? @db.Decimal(5, 2)
  recargoServicioImporte Decimal? @db.Decimal(12, 2)

  // Consumo físico CONGELADO de la línea (para reversión exacta al corregir).
  // productoLocalId = fila ProductoLocal descontada de StockLocal (junto a venta.localId).
  // cantidadStock = cantidad exacta descontada, en escala de StockLocal.
  // NULL en combos (su consumo vive en VentaDetalleComponente) y en servicios (sin stock).
  productoLocalId    Int?
  cantidadStock      Decimal? @db.Decimal(12, 3)

  createdAt          DateTime           @default(now())

  venta        Venta        @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id])
  listaPrecio  ListaPrecio? @relation(fields: [listaPrecioId], references: [id], onDelete: SetNull)
  componentes  VentaDetalleComponente[]

  @@index([ventaId])
  @@index([productoBaseId])
  @@index([listaPrecioId])
}

// COMPONENTES CONSUMIDOS POR UNA LÍNEA DE VENTA DE COMBO (E1)
// ---------------------------------------------------------------------------
// Congela QUÉ stock se descontó al vender un combo, para poder (a futuro)
// anular reponiendo cada componente y para trazabilidad/ticket. Una fila por
// componente consumido. Se puebla recién en la etapa del POS; la tabla nace en E1.
model VentaDetalleComponente {
  id              Int      @id @default(autoincrement())
  ventaDetalleId  Int
  productoBaseId  Int // identidad comercial/histórica del componente
  productoLocalId Int? // fila exacta de stock descontada
  cantidad        Decimal  @db.Decimal(12, 3) // ya multiplicada por la cantidad de combos vendidos
  precioCosto     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  // Cascade: borrar la línea de venta borra sus componentes congelados.
  ventaDetalle VentaDetalle @relation(fields: [ventaDetalleId], references: [id], onDelete: Cascade)
  // Restrict (intencional): si un ProductoBase participó como componente vendido,
  // NO puede eliminarse físicamente mientras exista este historial —preserva
  // identidad y trazabilidad—. El producto igual puede DESACTIVARSE (activo=false).
  productoBase ProductoBase @relation(fields: [productoBaseId], references: [id])
  // SetNull: la fila de stock exacta se conserva mientras exista; si algún día se
  // borra el ProductoLocal, la referencia queda null sin bloquear ni borrar el
  // historial (fallback: resolver por Venta.localId + productoBaseId).
  productoLocal ProductoLocal? @relation(fields: [productoLocalId], references: [id], onDelete: SetNull)

  @@index([ventaDetalleId])
  @@index([productoBaseId])
  @@index([productoLocalId])
}

// PAGOS DE LA VENTA (pago dividido / múltiples medios)
// ---------------------------------------------------------------------------
// Fuente de verdad de la DISTRIBUCIÓN del cobro de una venta. Una venta tiene 1+
// tenders cuya suma de `monto` == Venta.total (validado en el backend con Decimal).
// Los campos de pago en Venta (formaPago/comisionBancaria/comisionPct/netoRecibido/
// esFiado) se conservan como DERIVADOS/legacy. Cada tender congela su comisión.
// `monto` del tender efectivo = importe APLICADO a la venta (no el "paga con"/vuelto).
enum MedioPago {
  EFECTIVO
  MERCADOPAGO
  DEBITO
  CREDITO
  FIADO
}

model VentaPago {
  id          Int       @id @default(autoincrement())
  ventaId     Int
  medio       MedioPago
  monto       Decimal   @db.Decimal(12, 2) // aplicado a la venta (> 0)
  comisionPct Decimal?  @db.Decimal(5, 2) // % congelado (null si el medio no tiene comisión)
  comision    Decimal   @default(0) @db.Decimal(12, 2) // importe de comisión de ESTE tender
  neto        Decimal   @default(0) @db.Decimal(12, 2) // monto - comision
  createdAt   DateTime  @default(now())

  // Cascade: la eliminación física de una venta arrastra sus pagos (hoy las ventas
  // no se anulan/eliminan; queda coherente para el futuro y para recuperación).
  venta Venta @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  // Un tender por medio como máximo (el backend consolida medios repetidos).
  @@unique([ventaId, medio])
  @@index([ventaId])
  @@index([medio])
}

// TURNOS DE CAJA
// ---------------------------------------------------------------------------

model Turno {
  id           Int       @id @default(autoincrement())
  localId      Int
  vendedorId   Int
  operadorId   Int?
  cerradoPorId Int?
  apertura     DateTime  @default(now())
  cierre       DateTime?
  montoInicial Decimal   @db.Decimal(12, 2)

  montoEsperadoEfectivo Decimal? @db.Decimal(12, 2)
  montoRealEfectivo     Decimal? @db.Decimal(12, 2)
  diferenciaEfectivo    Decimal? @db.Decimal(12, 2)

  totalVentasEfectivo Decimal? @db.Decimal(12, 2)
  totalVentasDigital  Decimal? @db.Decimal(12, 2)
  cantidadVentas      Int?

  // ── CIRCUITO DEL DINERO FÍSICO ─────────────────────────────────────────────
  //
  // Antes el cierre guardaba cuánto se contó, pero no qué pasaba después con esa
  // plata. Como no había forma de registrar el retiro, el efectivo se quedaba en
  // el cajón: el turno siguiente declaraba un fondo de $10.000 mientras el cajón
  // tenía cientos de miles, y ese arrastre tapaba los faltantes reales.
  //
  // Ahora el cierre reparte el efectivo contado, sin resto:
  //     efectivoRetiradoCierre + fondoDejadoCierre = montoRealEfectivo
  //
  // Todo NULLABLE: los turnos cerrados antes de esto no se tocan y siguen
  // leyéndose igual (ver el test "turno histórico con campos NULL").
  efectivoRetiradoCierre   Decimal? @db.Decimal(12, 2)
  fondoDejadoCierre        Decimal? @db.Decimal(12, 2)
  /// CajaMovimiento RETIRO creado por el cierre. Se crea DESPUÉS del arqueo FINAL
  /// para que no altere el esperado de su propio cierre.
  retiroCierreMovimientoId Int?
  destinoRetiroCierre      String?
  /// Quién recibió la plata retirada. Texto libre a propósito: muchas veces es
  /// alguien que no tiene usuario en el sistema (el dueño, un familiar).
  recibidoPorCierre        String?

  // ── RECEPCIÓN DEL FONDO AL ABRIR ───────────────────────────────────────────
  //
  // El fondo sugerido es lo que dejó el cierre anterior; el recibido es lo que el
  // cajero contó de verdad. `montoInicial` SIEMPRE toma el recibido: si el sistema
  // impusiera el sugerido, una diferencia de recepción quedaría escondida y
  // reaparecería como faltante al cerrar, culpando al cajero equivocado.
  fondoSugeridoApertura    Decimal? @db.Decimal(12, 2)
  fondoRecibidoApertura    Decimal? @db.Decimal(12, 2)
  diferenciaFondoApertura  Decimal? @db.Decimal(12, 2)
  observacionFondoApertura String?
  /// Turno cuyo cierre dejó este fondo. @unique = el fondo de un cierre lo puede
  /// tomar UN solo turno: la base lo garantiza, no la aplicación.
  fondoOrigenTurnoId       Int?     @unique
  /// Inverso denormalizado: qué turno se llevó el fondo que dejó ESTE cierre.
  fondoConsumidoEnTurnoId  Int?

  observaciones String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  local       Local          @relation(fields: [localId], references: [id])
  vendedor    Usuario        @relation(fields: [vendedorId], references: [id])
  operador    OperadorLocal? @relation(fields: [operadorId], references: [id])
  cerradoPor  Usuario?       @relation("turnoCerradoPor", fields: [cerradoPorId], references: [id])
  ventas      Venta[]
  cajaMovimientos CajaMovimiento[]
  arqueos         ArqueoCaja[]
  postergaciones  ArqueoPostergacion[]

  @@index([localId])
  @@index([vendedorId])
  @@index([apertura])
  @@index([operadorId])
}

/// Arqueo de caja: foto contable de un conteo físico en un momento del turno.
///
/// Un turno puede tener CERO, uno o muchos arqueos PARCIALES y como mucho un
/// FINAL. El parcial NO cierra la caja ni corrige nada: solo deja registrado
/// qué esperaba el sistema y qué había realmente en el cajón.
///
/// Las diferencias de arqueos anteriores NO son movimientos de dinero y no
/// entran en el esperado del siguiente: un faltante detectado a las 10:00 sigue
/// faltando a las 12:00, pero es el MISMO faltante, no dos.
model ArqueoCaja {
  id      Int @id @default(autoincrement())
  turnoId Int
  localId Int

  /// Cajero responsable del turno (Turno.vendedorId, copiado al momento del arqueo).
  usuarioId Int
  /// Operario que estaba operando el POS, si el local los exige.
  operadorId Int?
  /// Quién ejecutó materialmente el conteo (puede no ser el responsable del turno).
  realizadoPorId Int

  fechaHora    DateTime @default(now())
  /// Ventana controlada por este corte: desde la apertura o el arqueo anterior,
  /// hasta el instante de confirmación calculado por el BACKEND.
  periodoDesde DateTime
  periodoHasta DateTime

  /// Misma precisión monetaria que Turno. Nunca float.
  efectivoEsperado Decimal @db.Decimal(12, 2)
  efectivoContado  Decimal @db.Decimal(12, 2)
  /// contado − esperado. Positiva = sobrante, negativa = faltante.
  diferencia       Decimal @db.Decimal(12, 2)

  observacion String?
  /// PARCIAL | FINAL
  tipo        String  @default("PARCIAL")

  // ── Alerta y auditoría de cumplimiento ──────────────────────────────────
  alertaProgramadaPara  DateTime?
  minutosDemora         Int?
  fuePostergado         Boolean   @default(false)
  postergadoPorId       Int?
  motivoPostergacion    String?
  cantidadPostergaciones Int      @default(0)

  /// Clave de idempotencia del cliente: dos envíos del mismo conteo (doble clic,
  /// dos pestañas) colapsan en una sola fila en vez de duplicar el arqueo.
  idempotencyKey String?

  creadoEn     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  turno        Turno          @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local        Local          @relation(fields: [localId], references: [id])
  usuario      Usuario        @relation("arqueoCajero", fields: [usuarioId], references: [id])
  operador     OperadorLocal? @relation(fields: [operadorId], references: [id])
  realizadoPor Usuario        @relation("arqueoRealizadoPor", fields: [realizadoPorId], references: [id])
  postergadoPor Usuario?      @relation("arqueoPostergadoPor", fields: [postergadoPorId], references: [id])

  @@unique([turnoId, idempotencyKey])
  @@index([turnoId])
  @@index([localId])
  @@index([fechaHora])
  @@index([tipo])
}

/// Postergación de una alerta de arqueo vencida.
///
/// Vive aparte de ArqueoCaja porque ocurre ANTES de que el arqueo exista: es el
/// acto de posponer el conteo, no el conteo. Al registrarse finalmente el
/// arqueo, sus contadores se copian a la fila de ArqueoCaja como resumen.
model ArqueoPostergacion {
  id      Int @id @default(autoincrement())
  turnoId Int
  localId Int

  /// Vencimiento que se estaba postergando.
  alertaProgramadaPara DateTime
  /// Hasta cuándo corre esta postergación.
  venceEn              DateTime
  minutosDemora        Int      @default(0)

  postergadoPorId Int
  motivo          String?
  /// Presente solo cuando la demora superó la tolerancia y el local exige
  /// autorización: deja registrado QUIÉN habilitó seguir sin contar.
  autorizadoPorId Int?

  creadoEn DateTime @default(now())

  turno         Turno    @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  local         Local    @relation(fields: [localId], references: [id])
  postergadoPor Usuario  @relation("postergacionPor", fields: [postergadoPorId], references: [id])
  autorizadoPor Usuario? @relation("postergacionAutorizadaPor", fields: [autorizadoPorId], references: [id])

  @@index([turnoId])
  @@index([localId])
  @@index([venceEn])
}

model CajaMovimiento {
  id        Int      @id @default(autoincrement())
  turnoId   Int
  usuarioId Int
  tipo      String   // INGRESO | RETIRO
  monto     Decimal  @db.Decimal(10, 2)
  motivo    String?
  createdAt DateTime @default(now())

  turno   Turno   @relation(fields: [turnoId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([turnoId])
}

// PUNTOS DE FIDELIDAD
// ---------------------------------------------------------------------------

model PuntosConfigLocal {
  id              Int      @id @default(autoincrement())
  grupoId         Int
  localId         Int      @unique
  activo          Boolean  @default(false)
  reglasJson      Json? // { "puntosPorPeso": 0.01 }
  redencionJson   Json? // { "pesoPorPunto": 10 }
  exclusionesJson Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id])

  @@index([grupoId])
  @@index([localId])
}

model ClientePuntoMovimiento {
  id        Int      @id @default(autoincrement())
  grupoId   Int
  localId   Int
  clienteId Int
  direccion String // "CREDITO" | "DEBITO"
  tipo      String // "ACREDITACION" | "CANJE" | "AJUSTE" | "EXPIRACION"
  puntos    Int
  ventaId   Int?
  // Corrección de ventas (Fase B): 0 = movimiento original; >0 = id de
  // VentaCorreccion. Habilita ajustes de puntos por corrección (delta / traslado
  // por cambio de cliente) sin romper la idempotencia del alta (correccionId=0).
  correccionId Int   @default(0)
  userId    Int?
  nota      String?
  createdAt DateTime @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  venta   Venta?   @relation(fields: [ventaId], references: [id])
  usuario Usuario? @relation(fields: [userId], references: [id])
  local   Local    @relation(fields: [localId], references: [id])

  @@unique([ventaId, tipo, correccionId])
  @@index([grupoId, localId, clienteId])
  @@index([localId])
  @@index([createdAt])
}

// CONTADOR DE VENTAS POR LOCAL (thread-safe)
// ---------------------------------------------------------------------------

model PosVentaCounter {
  id           Int      @id @default(autoincrement())
  grupoId      Int
  localId      Int      @unique
  ultimoNumero Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  local Local @relation(fields: [localId], references: [id])
  grupo Grupo @relation(fields: [grupoId], references: [id])

  @@index([localId])
  @@index([grupoId])
}

// ---------------------------------------------------------------------------
// COMPRAS / PEDIDOS A PROVEEDOR
// ---------------------------------------------------------------------------

model PedidoProveedor {
  id              Int                    @id @default(autoincrement())
  grupoId         Int
  depositoId      Int
  // Ubicación que CREÓ el pedido (aislamiento por ubicación). Se llena con el
  // localId del contexto al crear; puede ser un local o el depósito. `depositoId`
  // sigue siendo "dónde entra el stock". Backfill: creadoEnLocalId ← depositoId.
  creadoEnLocalId Int?
  proveedorId     Int
  estado          EstadoPedidoProveedor  @default(BORRADOR)
  notas           String?
  fechaConfirmado DateTime?
  fechaEnviado    DateTime?
  fechaRecibido   DateTime?
  fechaAnulado    DateTime?
  totalFactura    Decimal?               @db.Decimal(12, 2)
  totalReal       Decimal?               @db.Decimal(12, 2)
  nroFactura      String?
  fechaFactura    DateTime?
  creadoPorId     Int?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  deposito   Local     @relation(fields: [depositoId], references: [id])
  proveedor  Proveedor @relation(fields: [proveedorId], references: [id])
  detalles   PedidoProveedorDetalle[]

  @@index([grupoId])
  @@index([depositoId])
  @@index([creadoEnLocalId])
  @@index([proveedorId])
  @@index([estado])
  @@index([createdAt])
}

model PedidoProveedorDetalle {
  id               Int        @id @default(autoincrement())
  pedidoId         Int
  productoLocalId  Int
  cantidad         Decimal    @db.Decimal(12, 2)
  unidad           ModoPedido @default(BULTO)
  cantidadRecibida Decimal?   @db.Decimal(12, 2)
  kgRecibidos      Decimal?   @db.Decimal(12, 3)
  // Costo por unidad de pedido (BULTO/UNIDAD). Alta precisión (6 decimales) para
  // no perder el costo unitario derivado de packs con factor no divisor
  // (ej. 1480/18 = 82,222222). Los TOTALES/montos siguen en 2 decimales; la
  // conversión a centavos ocurre solo al mostrar o al persistir montos finales.
  precioCosto      Decimal?   @db.Decimal(18, 6)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  pedido   PedidoProveedor @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  producto ProductoLocal   @relation(fields: [productoLocalId], references: [id])

  @@index([pedidoId])
  @@index([productoLocalId])
}

// CONFIGURACION POR GRUPO
// ---------------------------------------------------------------------------

model ConfiguracionGrupo {
  id                            Int      @id @default(autoincrement())
  grupoId                       Int      @unique
  allowNegativeStock            Boolean  @default(false)
  requireMotivoAjusteStock      Boolean  @default(false)
  requireMotivoLimitesStock     Boolean  @default(false)
  exigirClienteVentasDeposito   Boolean  @default(false)
  exigirClienteVentasLocal      Boolean  @default(false)
  comisionDebito                Decimal  @default(7) @db.Decimal(5, 2)
  comisionCredito               Decimal  @default(7) @db.Decimal(5, 2)
  comisionMercadopago           Decimal  @default(7) @db.Decimal(5, 2)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  grupo Grupo @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([grupoId])
}

// CONFIGURACION DE TICKET POR LOCAL
// ---------------------------------------------------------------------------

model TicketConfig {
